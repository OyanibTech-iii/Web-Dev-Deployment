# In all environments, the following files are loaded if they exist,
# the latter taking precedence over the former:
#
#  * .env                contains default values for the environment variables needed by the app
#  * .env.local          uncommitted file with local overrides
#  * .env.$APP_ENV       committed environment-specific defaults
#  * .env.$APP_ENV.local uncommitted environment-specific overrides
#
# Real environment variables win over .env files.
#
# DO NOT DEFINE PRODUCTION SECRETS IN THIS FILE NOR IN ANY OTHER COMMITTED FILES.
# https://symfony.com/doc/current/configuration/secrets.html
#
# Run "composer dump-env prod" to compile .env files for production use (requires symfony/flex >=1.2).
# https://symfony.com/doc/current/best_practices.html#use-environment-variables-for-infrastructure-configuration

###> docker-compose ###
MYSQL_ROOT_PASSWORD=root_password
MYSQL_DATABASE=root_db
MYSQL_USER=user
MYSQL_PASSWORD=user_password
PMA_HOST=mysql
PMA_USER=user
PMA_PASSWORD=user_password
###< docker-compose ###

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=your_app_secret_here
###< symfony/framework-bundle ###

###> predis/predis ###
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_RATE_LIMITER_URL=redis://127.0.0.1:6379/1
REDIS_CACHE_URL=redis://127.0.0.1:6379/2
REDIS_SESSION_URL=redis://127.0.0.1:6379/2
###< predis/predis ###

###> doctrine/doctrine-bundle ###
# Format described at https://www.doctrine-project.org/projects/doctrine-dbal/en/latest/reference/configuration.html#connecting-using-a-url
# IMPORTANT: You MUST configure your server version, either here or in config/packages/doctrine.yaml
#
# DATABASE_URL="sqlite:///%kernel.project_dir%/var/data_%kernel.environment%.db"
DATABASE_URL="mysql://user:user_password@127.0.0.1:3307/root_db?serverVersion=8.0&charset=utf8mb4"
# DATABASE_URL="postgresql://app:!ChangeMe!@127.0.0.1:5432/app?serverVersion=16&charset=utf8"
###< doctrine/doctrine-bundle ###

###> symfony/messenger ###
# Choose one of the transports below
# MESSENGER_TRANSPORT_DSN=amqp://guest:guest@localhost:5672/%2f/messages
# MESSENGER_TRANSPORT_DSN=redis://localhost:6379/messages
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
###< symfony/messenger ###

###> symfony/mailer ###
MAILER_DSN=smtp://user:pass@localhost:1025
# MAILER_DSN=smtp://BREVO_USER:BREVO_SMTP_KEY@smtp-relay.brevo.com:587
###< symfony/mailer ###

###> symfony/sendgrid-mailer ###
# MAILER_DSN=sendgrid://KEY@default
###< symfony/sendgrid-mailer ###

###> nelmio/cors-bundle ###
CORS_ALLOW_ORIGIN='^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$'
###< nelmio/cors-bundle ###

###> google-oauth2 ###
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
###< google-oauth2 ###

###> lexik/jwt-authentication-bundle ###
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
JWT_PASSPHRASE=your_jwt_passphrase
###< lexik/jwt-authentication-bundle ###

###> emailjs/browser-sdk ###
EMAILJS_PUBLIC_KEY=your_emailjs_public_key
EMAILJS_SERVICE_ID=your_emailjs_service_id
EMAILJS_TEMPLATE_ID=your_emailjs_template_id
ACTIVATION_PUBLIC_KEY=your_activation_public_key
ACTIVATION_SERVICE_ID=your_activation_service_id
ACTIVATION_TEMPLATE_ID=your_activation_template_id
###< emailjs/browser-sdk ###

###> symfony/ux-leaflet-map ###
# Options available at https://github.com/symfony/ux/blob/2.x/src/Map/src/Bridge/Leaflet/README.md
UX_MAP_DSN=leaflet://default
###< symfony/ux-leaflet-map ###

###> google gemini (ficoBot) ###
GEMINI_MODEL=gemini-1.5-flash
GEMINI_API_KEY=your_gemini_api_key
###< google gemini (ficoBot) ###

###> stripe/stripe-php ###
STRIPE_PUBLIC_KEY=pk_test_your_key
STRIPE_SECRET_KEY=sk_test_your_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
# Used in some services as an alias for STRIPE_SECRET_KEY or for other integrations
PRIVATE_KEY=your_private_key_here
TEST_TOKEN=tok_visa
TEST_CARD=your_test_card_number
###< stripe/stripe-php ###
