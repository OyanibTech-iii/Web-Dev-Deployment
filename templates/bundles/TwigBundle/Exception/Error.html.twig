{% extends 'base.html.twig' %}

{% block title %}Page Not Found - Growfico{% endblock %}

{% block body %}
<div class="min-h-screen flex items-center justify-center bg-white dark:bg-gray-900 text-gray-900 dark:text-gray-200 px-4 sm:px-6 lg:px-8 py-8 sm:py-12 lg:py-16">
    <div class="text-center w-full max-w-2xl">
        <div class="mb-6 sm:mb-8 lg:mb-10 flex justify-center items-center">
            <img src="{{ asset('error/' ~ status_code ~ '.png') }}" alt="{{ status_code }} Error"
                class="w-48 sm:w-56 md:w-64 lg:w-96 drop-shadow-md">
        </div>

        <h1 class="text-xl sm:text-3xl md:text-4xl lg:text-5xl font-bold text-dark-forest-green dark:!text-gray-100 mb-3 sm:mb-4 lg:mb-5">
            Oops! <span class="text-bright-green">Page Not Found</span>
        </h1>
        
        <p class="text-sm sm:text-base md:text-lg lg:text-xl text-gray-700 dark:text-gray-300 mb-6 sm:mb-8 lg:mb-10 leading-relaxed">
            The link you followed may be broken, or the page <br class="hidden sm:block"> 
            may have been removed.
        </p>

        <div class="flex flex-col sm:flex-row gap-3 sm:gap-4 justify-center items-center w-full">
            <button onclick="window.history.back()"
                class="group relative inline-flex items-center justify-center px-6 sm:px-8 py-2.5 sm:py-3 text-sm sm:text-base font-semibold text-white transition-all duration-300 bg-bright-green hover:bg-bright-green/90 rounded-full hover:shadow-xl hover:-translate-y-1 active:scale-95 focus:outline-none focus:ring-4 focus:ring-bright-green/30 w-full sm:w-auto">
                <span>Go Back</span>
            </button>
            
            {% if exception is defined and app.debug %}
            <button id="debug-toggle" onclick="toggleDebugInfo()"
                class="group relative inline-flex items-center justify-center px-6 sm:px-8 py-2.5 sm:py-3 text-sm sm:text-base font-semibold text-white transition-all duration-300 bg-red-600 dark:bg-red-700 rounded-full hover:bg-red-700 dark:hover:bg-red-600 hover:shadow-xl hover:-translate-y-1 active:scale-95 border-0 outline-none w-full sm:w-auto">
                <span>Debug Info</span>
            </button>
            {% endif %}
        </div>

        {% if exception is defined and app.debug %}
        <div id="debug-panel" class="hidden mt-8 sm:mt-10 lg:mt-12 text-left bg-gray-50 dark:bg-gray-900 text-gray-900 dark:text-gray-100 p-4 sm:p-6 lg:p-8 rounded-lg w-full border-2 border-red-500">
            <h2 class="text-xl sm:text-2xl lg:text-xl font-bold text-red-600 dark:text-red-400 mb-4 sm:mb-6">Debug Information</h2>
            
            <div class="space-y-4 sm:space-y-6">
                <div>
                    <h3 class="text-xs sm:text-sm font-bold text-gray-600 dark:text-gray-300 uppercase tracking-wider mb-2">Error Code</h3>
                    <p class="text-xs sm:text-sm font-mono text-gray-900 dark:text-white bg-gray-200 dark:bg-gray-800 p-2 sm:p-3 rounded border border-gray-300 dark:border-gray-700 break-all">
                        {{ status_code }}
                    </p>
                </div>

                <div>
                    <h3 class="text-xs sm:text-sm font-bold text-gray-600 dark:text-gray-300 uppercase tracking-wider mb-2">Error Message</h3>
                    <p class="text-xs sm:text-sm font-mono text-gray-900 dark:text-white bg-gray-200 dark:bg-gray-800 p-2 sm:p-3 rounded border border-gray-300 dark:border-gray-700 break-words overflow-hidden">
                        {{ status_text }}
                    </p>
                </div>

                {% if exception.message is defined and exception.message %}
                <div>
                    <h3 class="text-xs sm:text-sm font-bold text-gray-600 dark:text-gray-300 uppercase tracking-wider mb-2">Exception Message</h3>
                    <p class="text-xs sm:text-sm font-mono text-gray-900 dark:text-white bg-gray-200 dark:bg-gray-800 p-2 sm:p-3 rounded border border-gray-300 dark:border-gray-700 break-words overflow-hidden">
                        {{ exception.message }}
                    </p>
                </div>
                {% endif %}

                {% if exception.file is defined and exception.file %}
                <div>
                    <h3 class="text-xs sm:text-sm font-bold text-gray-600 dark:text-gray-300 uppercase tracking-wider mb-2">File</h3>
                    <p class="text-xs font-mono text-gray-800 dark:text-gray-300 bg-gray-200 dark:bg-gray-800 p-2 sm:p-3 rounded border border-gray-300 dark:border-gray-700 break-all overflow-hidden">
                        {{ exception.file }}:{{ exception.line }}
                    </p>
                </div>
                {% endif %}

                {% if exception.trace is defined and exception.trace %}
                <div>
                    <h3 class="text-xs sm:text-sm font-bold text-gray-600 dark:text-gray-300 uppercase tracking-wider mb-2">Stack Trace</h3>
                    <div class="bg-gray-200 dark:bg-gray-800 p-2 sm:p-3 rounded border border-gray-300 dark:border-gray-700 text-xs text-gray-800 dark:text-gray-300 font-mono">
                        <ol class="space-y-2">
                        {% for traceItem in exception.trace %}
                            <li class="pb-2 border-b border-gray-300 dark:border-gray-700 last:border-b-0 break-words">
                                <strong class="text-yellow-600 dark:text-yellow-400">#{{ loop.index0 }}</strong>
                                {% if traceItem.class is defined %}<span class="text-blue-600 dark:text-blue-400 break-all">{{ traceItem.class }}</span>{% endif %}{% if traceItem.function is defined %}<strong>::{{ traceItem.function }}</strong>{% endif %}
                                {% if traceItem.file is defined %}<br><span class="text-gray-600 dark:text-gray-400 text-xs break-all">at {{ traceItem.file }}:{{ traceItem.line }}</span>{% endif %}
                            </li>
                        {% endfor %}
                        </ol>
                    </div>
                </div>
                {% endif %}
            </div>

            <button onclick="toggleDebugInfo()" class="mt-4 sm:mt-6 px-4 py-2 sm:py-2.5 text-sm sm:text-base bg-gray-300 dark:bg-gray-700 hover:bg-gray-400 dark:hover:bg-gray-600 text-gray-900 dark:text-white rounded font-semibold transition-colors w-full sm:w-auto">
                Close Debug Info
            </button>
        </div>
        {% endif %}
    </div>
</div>

<script>
    function toggleDebugInfo() {
        const debugPanel = document.getElementById('debug-panel');
        if (debugPanel) {
            debugPanel.classList.toggle('hidden');
        }
    }
</script>
{% endblock %}