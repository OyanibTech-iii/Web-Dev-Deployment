{% extends 'admin/base_admin.html.twig' %}

{% block title %}Answer Choices | Growfico{% endblock %}

{% block header_title %}
<h2 class="text-xl font-semibold text-dark-forest-green">Answer Choices</h2>
<p class="text-xs text-light-gray">Manage choices for quiz questions</p>
{% endblock %}

{% block stylesheets %}
{{ parent() }}
<link rel="stylesheet" href="https://cdn.datatables.net/1.13.7/css/jquery.dataTables.min.css">
<link rel="stylesheet" href="{{ asset('styles/datatable.css') }}">
{% endblock %}

{% block admin_content %}
<div class="max-w-7xl mx-auto">
    <div class="bg-white rounded-2xl border border-gray-200 shadow-sm p-6">
        <div class="flex flex-col sm:flex-row sm:justify-between sm:items-center gap-4 mb-6">
            <h2 class="text-xl font-semibold text-dark-forest-green">Manage Answer Choices</h2>
            <div class="flex flex-col sm:flex-row gap-4 sm:items-center">
                <div class="relative">
                    <span class="absolute inset-y-0 left-0 pl-3 flex items-center text-gray-400 pointer-events-none">
                        <ion-icon name="search-outline"></ion-icon>
                    </span>
                    <input type="text"
                           id="answer-choices-search-input"
                           class="block w-full sm:w-64 pl-10 pr-3 py-2 border border-gray-300 rounded-lg leading-5 bg-white placeholder-gray-500 focus:outline-none focus:ring-1 focus:ring-bright-green sm:text-sm"
                           placeholder="Search answer choices..."
                           autocomplete="off"
                           aria-label="Search answer choices">
                </div>
                <a href="{{ path('app_answer_choice_new') }}"
                   class="inline-flex items-center justify-center px-4 py-2 bg-bright-green text-white text-sm font-medium rounded-lg hover:bg-green-600 transition-colors duration-200">
                    <ion-icon name="add-outline" class="w-4 h-4 mr-2"></ion-icon>
                    Add Answer Choice
                </a>
            </div>
        </div>

        <div class="overflow-x-auto">
            <table id="answerChoicesTable" class="w-full">
                <thead class="bg-gray-50">
                <tr>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Choice</th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Question</th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Quiz</th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Correct</th>
                    <th class="px-6 py-3 text-center text-xs font-medium text-gray-500 uppercase tracking-wider no-sort"
                        style="text-align: center !important;">
                        Actions
                    </th>
                </tr>
                </thead>
                <tbody class="bg-white divide-y divide-gray-200 dark:divide-gray-500">
                {% for answer_choice in answer_choices %}
                    <tr class="hover:bg-gray-50 transition-colors duration-200">
                        <td class="px-6 py-4 whitespace-nowrap">
                            <div class="text-sm font-medium text-dark-forest-green">
                                {{ answer_choice.choiceText|slice(0, 80) }}{% if answer_choice.choiceText|length > 80 %}...{% endif %}
                            </div>
                        </td>
                        <td class="px-6 py-4 whitespace-nowrap">
                            <div class="text-sm text-dark-forest-green">
                                {{ answer_choice.question ? answer_choice.question.questionText|slice(0, 60) : 'N/A' }}
                            </div>
                        </td>
                        <td class="px-6 py-4 whitespace-nowrap">
                            <div class="text-sm text-dark-forest-green">
                                {{ answer_choice.question and answer_choice.question.quiz ? answer_choice.question.quiz.title : 'N/A' }}
                            </div>
                        </td>
                        <td class="px-6 py-4 whitespace-nowrap">
                            {% if answer_choice.isCorrect %}
                                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800 dark:bg-gray-800 dark:text-bright-green">
                                    <ion-icon name="checkmark-circle" class="w-3 h-3 mr-1"></ion-icon>
                                    Correct
                                </span>
                            {% else %}
                                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-700 dark:bg-gray-800 dark:text-gray-300">
                                    <ion-icon name="close-circle" class="w-3 h-3 mr-1"></ion-icon>
                                    Incorrect
                                </span>
                            {% endif %}
                        </td>
                        <td class="px-6 py-4 whitespace-nowrap text-sm font-medium">
                            <div class="flex items-center justify-center gap-2">
                                <a href="{{ path('app_answer_choice_show', {'id': answer_choice.id}) }}"
                                   class="text-bright-green hover:text-green-600 transition-colors duration-200"
                                   title="View Answer Choice">
                                    <ion-icon name="eye-outline" class="w-4 h-4"></ion-icon>
                                </a>
                                <a href="{{ path('app_answer_choice_edit', {'id': answer_choice.id}) }}"
                                   class="text-blue-600 hover:text-blue-800 transition-colors duration-200"
                                   title="Edit Answer Choice">
                                    <ion-icon name="create-outline" class="w-4 h-4"></ion-icon>
                                </a>
                                <form method="post"
                                      action="{{ path('app_answer_choice_delete', {'id': answer_choice.id}) }}"
                                      onsubmit="return confirm('Are you sure you want to delete this answer choice?');"
                                      class="inline">
                                    <input type="hidden" name="_token"
                                           value="{{ csrf_token('delete' ~ answer_choice.id) }}">
                                    <button type="submit"
                                            class="text-red-600 hover:text-red-800 transition-colors duration-200"
                                            title="Delete Answer Choice">
                                        <ion-icon name="trash-outline" class="w-4 h-4"></ion-icon>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>

        {% if answer_choices is empty %}
            <div class="text-center py-8 border-t border-gray-100 mt-4">
                <div class="w-16 h-16 bg-gray-100 rounded-full flex items-center justify-center mb-4 mx-auto">
                    <ion-icon name="options-outline" class="w-8 h-8 text-light-gray"></ion-icon>
                </div>
                <h4 class="text-sm font-semibold text-dark-forest-green mb-2">No answer choices found</h4>
                <p class="text-xs text-light-gray mb-4 max-w-sm mx-auto">
                    Add answer choices to your questions so learners can respond.
                </p>
                <a href="{{ path('app_answer_choice_new') }}"
                   class="inline-flex items-center px-4 py-2 bg-bright-green text-white text-sm font-medium rounded-lg hover:bg-green-600 transition-colors duration-200">
                    <ion-icon name="add-outline" class="w-4 h-4 mr-2"></ion-icon>
                    Add your first answer choice
                </a>
            </div>
        {% endif %}
    </div>
</div>
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script src="https://cdn.datatables.net/1.13.7/js/jquery.dataTables.min.js"></script>
<script src="{{ asset('js/admin-search.js') }}"></script>
<script>
    (function () {
        'use strict';
        const TABLE_SELECTOR = '#answerChoicesTable';
        const SEARCH_INPUT_ID = 'answer-choices-search-input';

        function initAnswerChoicesDataTable() {
            if (typeof jQuery === 'undefined' || !jQuery.fn.DataTable) {
                return;
            }
            const $table = jQuery(TABLE_SELECTOR);
            if (!$table.length || jQuery.fn.DataTable.isDataTable(TABLE_SELECTOR)) {
                return;
            }
            const table = $table.DataTable({
                dom: 'lrtip',
                pageLength: 10,
                order: [[0, 'asc']],
                columnDefs: [
                    { orderable: false, targets: 4 },
                    { className: 'align-middle', targets: '_all' }
                ],
                autoWidth: false,
                language: {
                    emptyTable: 'No answer choices found.',
                    zeroRecords: 'No matching answer choices found.',
                    paginate: {
                        previous: '<ion-icon name="chevron-back-outline" class="align-middle"></ion-icon>',
                        next: '<ion-icon name="chevron-forward-outline" class="align-middle"></ion-icon>'
                    }
                }
            });

            const searchInput = document.getElementById(SEARCH_INPUT_ID);
            if (searchInput) {
                searchInput.addEventListener('keyup', function () {
                    table.search(this.value).draw();
                });
            }

            if (typeof AdminSearch !== 'undefined') {
                new AdminSearch({
                    searchInputId: SEARCH_INPUT_ID,
                    tableSelector: TABLE_SELECTOR
                });
            }
        }

        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', initAnswerChoicesDataTable);
        } else {
            initAnswerChoicesDataTable();
        }
    })();
</script>
{% endblock %}

{% extends 'base.html.twig' %}

{% block title %}AnswerChoice index{% endblock %}

{% block body %}
    <h1>AnswerChoice index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>ChoiceText</th>
                <th>IsCorrect</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for answer_choice in answer_choices %}
            <tr>
                <td>{{ answer_choice.id }}</td>
                <td>{{ answer_choice.choiceText }}</td>
                <td>{{ answer_choice.isCorrect ? 'Yes' : 'No' }}</td>
                <td>
                    <a href="{{ path('app_answer_choice_show', {'id': answer_choice.id}) }}">show</a>
                    <a href="{{ path('app_answer_choice_edit', {'id': answer_choice.id}) }}">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="4">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_answer_choice_new') }}">Create new</a>
{% endblock %}
