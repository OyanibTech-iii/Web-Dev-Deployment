    {{ include('answer_choice/_form.html.twig', {'button_label': 'Update'}) }}

    <a href="{{ path('app_answer_choice_index') }}">back to list</a>

    {{ include('answer_choice/_delete_form.html.twig') }}
{% endblock %}
