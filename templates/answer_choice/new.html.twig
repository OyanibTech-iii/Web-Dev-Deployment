{% extends 'admin/base_admin.html.twig' %}

{% block title %}New Answer Choice | Growfico{% endblock %}

{% block header_title %}
<h2 class="text-lg font-semibold text-dark-forest-green">Add Answer Choice</h2>
<p class="text-xs text-light-gray">Create a new answer choice for a question</p>
{% endblock %}

{% block admin_content %}
<div class="max-w-3xl mx-auto">
    <div class="bg-white rounded-2xl border border-gray-200 shadow-sm">
        <div class="p-6">
            {{ include('answer_choice/_form.html.twig', { form: form }) }}
        </div>
    </div>
</div>
{% endblock %}

{% extends 'base.html.twig' %}

{% block title %}New AnswerChoice{% endblock %}

{% block body %}
    <h1>Create new AnswerChoice</h1>

    {{ include('answer_choice/_form.html.twig') }}

    <a href="{{ path('app_answer_choice_index') }}">back to list</a>
{% endblock %}
