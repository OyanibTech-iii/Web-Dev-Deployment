{% extends 'admin/base_admin.html.twig' %}

{% block title %}Quiz Details | Growfico{% endblock %}

{% block header_title %}
<h2 class="text-xl font-semibold text-dark-forest-green">Quiz Details</h2>
<p class="text-xs text-light-gray">View quiz configuration</p>
{% endblock %}

{% block admin_content %}
<div class="max-w-3xl mx-auto">
    <div class="bg-white rounded-2xl border border-gray-200 shadow-sm p-6 space-y-6">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div>
                <p class="text-xs text-light-gray">Title</p>
                <p class="text-sm font-medium text-dark-forest-green">
                    {{ quiz.title }}
                </p>
            </div>
            <div>
                <p class="text-xs text-light-gray">Course</p>
                <p class="text-sm font-medium text-dark-forest-green">
                    {{ quiz.course ? quiz.course.courseName : 'N/A' }}
                </p>
            </div>
            <div>
                <p class="text-xs text-light-gray">Passing Score</p>
                <p class="text-sm font-medium text-dark-forest-green">
                    {{ quiz.passingScore }}%
                </p>
            </div>
        </div>

        <div class="flex flex-col sm:flex-row gap-3 justify-end pt-4 border-t border-gray-100">
            <a href="{{ path('app_quiz_index') }}"
               class="inline-flex items-center justify-center px-5 py-2.5 bg-gray-100 text-dark-forest-green text-sm font-medium rounded-lg hover:bg-gray-200 transition-colors duration-200">
                <ion-icon name="arrow-back-outline" class="w-4 h-4 mr-2"></ion-icon>
                Back to list
            </a>
            <a href="{{ path('app_quiz_edit', {'id': quiz.id}) }}"
               class="inline-flex items-center justify-center px-5 py-2.5 bg-bright-green text-white text-sm font-medium rounded-lg hover:bg-green-600 transition-colors duration-200">
                <ion-icon name="create-outline" class="w-4 h-4 mr-2"></ion-icon>
                Edit
            </a>
            <form method="post"
                  action="{{ path('app_quiz_delete', {'id': quiz.id}) }}"
                  onsubmit="return confirm('Are you sure you want to delete this quiz?');">
                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ quiz.id) }}">
                <button class="inline-flex items-center justify-center px-5 py-2.5 bg-red-600 text-white text-sm font-medium rounded-lg hover:bg-red-700 transition-colors duration-200">
                    <ion-icon name="trash-outline" class="w-4 h-4 mr-2"></ion-icon>
                    Delete
                </button>
            </form>
        </div>
    </div>
</div>
{% endblock %}

{% extends 'base.html.twig' %}

{% block title %}Quiz{% endblock %}

{% block body %}
    <h1>Quiz</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ quiz.id }}</td>
            </tr>
            <tr>
                <th>Title</th>
                <td>{{ quiz.title }}</td>
            </tr>
            <tr>
                <th>PassingScore</th>
                <td>{{ quiz.passingScore }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_quiz_index') }}">back to list</a>

    <a href="{{ path('app_quiz_edit', {'id': quiz.id}) }}">edit</a>

    {{ include('quiz/_delete_form.html.twig') }}
{% endblock %}
