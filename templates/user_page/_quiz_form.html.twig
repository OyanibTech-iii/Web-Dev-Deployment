{% if quiz.questions|length > 0 %}
<form id="quizForm" class="p-6 space-y-8">
    {% set questionIndex = 0 %}
    {% for question in quiz.questions %}
        {% set questionIndex = questionIndex + 1 %}
        <div class="pb-6 border-b border-gray-200 last:border-0 last:pb-0">
            <div class="flex items-start gap-3 mb-4">
                <span
                    class="inline-flex items-center justify-center w-6 h-6 rounded-full bg-bright-green text-white text-xs font-semibold flex-shrink-0">
                    {{ questionIndex }}
                </span>
                <h4 class="text-base font-semibold text-dark-forest-green pt-0.5">{{ question.questionText }}</h4>
            </div>

            <div class="ml-9 space-y-3">
                {% for choice in question.answerChoices %}
                    <label
                        class="flex items-center gap-3 p-3 rounded-lg border border-gray-200 hover:border-bright-green hover:bg-green-50 cursor-pointer transition-all dark:border-gray-600 dark:hover:border-bright-green dark:hover:bg-green-900/20">
                        <input type="radio" name="answer_{{ question.id }}" value="{{ choice.id }}"
                            class="w-4 h-4 text-bright-green border-gray-300 focus:ring-bright-green" required>
                        <span class="text-sm text-gray-700 dark:text-gray-200">{{ choice.choiceText }}</span>
                    </label>
                {% else %}
                    <p class="text-sm text-amber-600 dark:text-amber-400">No answer choices configured for this question.</p>
                {% endfor %}
            </div>
        </div>
    {% endfor %}

    <div class="mt-8 flex flex-wrap gap-3">
        <button type="submit"
            class="inline-flex text-xs items-center gap-2 px-6 py-3 rounded-lg bg-bright-green text-white font-semibold hover:bg-green-600 transition-colors">
            Submit Quiz
        </button>
        <button type="reset"
            class="inline-flex text-xs items-center gap-2 px-6 py-3 rounded-lg border border-gray-300 text-gray-700 font-semibold hover:bg-gray-50 transition-colors dark:border-gray-600 dark:text-gray-200 dark:hover:bg-gray-700">
            Reset
        </button>
    </div>
</form>
{% else %}
<div class="p-6">
    <p class="text-sm text-gray-600 dark:text-gray-300 mb-2">This quiz has no questions yet.</p>
    <p class="text-xs text-light-gray">Lets wait for administrator to load quiz content currently working on it.</p>
</div>
{% endif %}