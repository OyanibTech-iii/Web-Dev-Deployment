{% extends 'user_page/base_user.html.twig' %}

{% block title %}My Courses | Growfico{% endblock %}
{% block page_title %}My Courses{% endblock %}
{% block page_subtitle %}Your available training programs and educational content.{% endblock %}

{% block user_content %}
<div class="max-w-7xl mx-auto space-y-8">
    <div>
        <h3 class="text-base font-semibold text-dark-forest-green mb-4">Available Courses</h3>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            {% for course in courses %}
                {% set enrollment = enrollmentMap[course.id] ?? null %}
                <div class="bg-white rounded-2xl border border-gray-200 shadow-sm overflow-hidden hover:shadow-md transition-shadow duration-200 flex flex-col">
                    
                    {# --- Course Banner --- #}
                    <div class="relative h-48 w-full overflow-hidden bg-gray-50 border-b border-gray-100">
                        {% if course.thumbnail %}
                            <img src="{{ asset(course.getThumbnailPath()) }}" alt="{{ course.courseName }}" class="w-full h-full object-contain transition-transform duration-500 hover:scale-105 p-4">
                        {% else %}
                            <div class="w-full h-full flex flex-col items-center justify-center bg-gradient-to-br from-primary-50 to-primary-100 text-bright-green">
                                <ion-icon name="image-outline" class="text-4xl mb-2 opacity-50"></ion-icon>
                                <span class="text-xs font-medium opacity-50">No preview available</span>
                            </div>
                        {% endif %}
                    </div>
                    {# --- End Course Banner --- #}

                    <div class="p-6 flex-1 flex flex-col">
                        <div class="flex items-start justify-between gap-3 mb-3">
                            <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold bg-primary-50 text-bright-green dark:bg-gray-700 dark:!text-bright-green">
                                {{ course.tier }}
                            </span>
                            <span class="text-xs font-semibold text-light-gray">
                                {{ course.price }}
                            </span>
                        </div>
                        <h4 class="text-lg font-semibold text-dark-forest-green mb-2 leading-tight">{{ course.courseName }}</h4>
                        <p class="text-sm text-light-gray mb-4 line-clamp-3">{{ course.description }}</p>
                        
                        <div class="mt-auto flex flex-col gap-3">
                            {% if not enrollment and course.price is not null and (course.price + 0) <= 0 %}
                                <form method="POST" action="{{ path('app_user_course_enroll', {'courseId': course.id}) }}">
                                    <button type="submit"
                                        class="w-full inline-flex items-center justify-center gap-2 px-4 py-2 rounded-lg bg-bright-green text-white text-xs font-semibold hover:bg-green-600 transition-colors">
                                        Enroll Now
                                    </button>
                                </form>
                            {% endif %}
                            
                            <div class="flex items-center justify-between gap-2">
                                <a href="{{ path('app_user_course_show', {'id': course.id}) }}"
                                   class="inline-flex items-center gap-2 text-sm font-semibold text-bright-green hover:text-green-600 transition-colors">
                                    <ion-icon name="document-text-outline"></ion-icon>
                                    View course
                                </a>

                                {# Status Badge Inline #}
                                {% set cardStatus = courseCardStatus[course.id] ?? 'not_enrolled' %}
                                {% if cardStatus == 'completed' %}
                                    <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-[10px] font-bold bg-green-50 text-bright-green border border-green-100">
                                        <ion-icon name="checkmark-circle"></ion-icon>
                                        Completed
                                    </span>
                                {% elseif cardStatus == 'in_progress' %}
                                    <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-[10px] font-bold bg-yellow-50 text-yellow-600 border border-yellow-100">
                                        <ion-icon name="time"></ion-icon>
                                        In Progress
                                    </span>
                                {% endif %}
                            </div>
                        </div>
                    </div>
                </div>
            {% else %}
                <div class="md:col-span-2 lg:col-span-3 bg-gray-50 rounded-2xl border-2 border-dashed border-gray-200 p-10 text-center">
                    <div class="w-14 h-14 bg-gray-200 rounded-xl flex items-center justify-center mx-auto mb-4">
                        <ion-icon name="school-outline" class="text-2xl text-gray-400"></ion-icon>
                    </div>
                    <p class="text-sm font-semibold text-light-gray">No courses available yet.</p>
                </div>
            {% endfor %}
        </div>
    </div>

    {# Coming Soon Section #}
    <div>
        <h3 class="text-base font-semibold text-dark-forest-green mb-4">Coming Soon</h3>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            <div class="bg-gray-50 rounded-2xl border-2 border-dashed border-gray-200 p-8 flex flex-col items-center justify-center min-h-[200px]">
                <div class="w-14 h-14 bg-gray-200 rounded-full flex items-center justify-center mb-4 dark:bg-gray-700 dark:!text-bright-green">
                    <ion-icon name="construct-outline" class="text-2xl text-gray-400"></ion-icon>
                </div>
                <p class="text-sm font-medium text-light-gray text-center">New Course</p>
                <p class="text-xs text-gray-400 text-center mt-1">More courses coming soon</p>
            </div>
        </div>
    </div>
</div>
{% endblock %}