<div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-8">
    {# Course Progress Chart #}
    <div class="bg-white rounded-2xl border border-gray-200 p-6 shadow-sm">
        <h3 class="text-lg font-semibold text-dark-forest-green mb-4">Course Progress</h3>
        <div class="relative h-64">
            <canvas 
                data-controller="chart" 
                data-chart-type-value="doughnut"
                data-chart-data-value="{{ {
                    labels: ['Enrolled', 'Completed'],
                    datasets: [{
                        data: [stats.courseProgress.enrolled, stats.courseProgress.completed],
                        backgroundColor: ['#4ade80', '#166534'],
                        borderWidth: 0
                    }]
                }|json_encode }}"
            ></canvas>
        </div>
    </div>

    {# Quiz Performance Chart #}
    <div class="bg-white rounded-2xl border border-gray-200 p-6 shadow-sm">
        <h3 class="text-lg font-semibold text-dark-forest-green mb-4">Quiz Performance</h3>
        <div class="relative h-64">
            <canvas 
                data-controller="chart" 
                data-chart-type-value="bar"
                data-chart-data-value="{{ {
                    labels: ['Passed', 'Failed'],
                    datasets: [{
                        label: 'Attempts',
                        data: [stats.quizPerformance.passed, stats.quizPerformance.failed],
                        backgroundColor: ['#166534', '#ef4444'],
                        borderRadius: 8
                    }]
                }|json_encode }}"
                data-chart-options-value="{{ {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false }
                    },
                    scales: {
                        y: { beginAtZero: true, ticks: { stepSize: 1 } }
                    }
                }|json_encode }}"
            ></canvas>
        </div>
    </div>
</div>
