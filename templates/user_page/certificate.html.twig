{% extends 'user_page/base_user.html.twig' %}

{% block title %}E-Certificate - {{ course.courseName }} | Growfico{% endblock %}
{% block page_title %}E-Certificate{% endblock %}
{% block page_subtitle %}Your certificate of completion{% endblock %}

{% block user_content %}
<div class="max-w-7xl mx-auto">
    <div class="mb-6 flex gap-3">
        <a href="{{ path('app_user_course_show', {'id': course.id}) }}"
            class="mb-4 inline-flex items-center justify-center px-5 py-2.5 bg-gray-100 text-dark-forest-green text-sm font-medium rounded-lg hover:bg-gray-200 transition-colors duration-200 dark:bg-gray-700 dark:!text-gray-200 dark:hover:bg-gray-400">
            Back to course
        </a>
        <button onclick="window.print()"
            class="mb-4 inline-flex items-center justify-center px-5 py-2.5 bg-bright-green text-white text-sm font-medium rounded-lg hover:bg-green-600 transition-colors duration-200 dark:bg-gray-700 dark:!text-gray-200 dark:hover:bg-gray-400">
            Print Certificate
        </button>
    </div>

   <div class=" min-h-screen flex flex-col items-center pt-8 print:p-0 print:bg-white">

    <div id="certificate"
        class="relative w-[1056px] h-[816px] bg-white shadow-2xl overflow-hidden print:shadow-none print:m-0 print:border-0"
        style="-webkit-print-color-adjust: exact; print-color-adjust: exact;">

        <img src="{{ asset('logos/login-deco2.png') }}"
            class="absolute right-[-10%] top-0 w-3/4 opacity-10 rotate-12 pointer-events-none">

        <div class="absolute top-0 left-0 w-full flex">
            <div class="bg-[#074026] h-32 w-2/3 flex items-center px-12"
                style="clip-path: polygon(0 0, 100% 0, 90% 100%, 0% 100%);">
                <img src="{{ asset('logos/light.png') }}" alt="Growfico" class="h-8">

            </div>
            <div class="bg-[#48a82b] h-8 w-1/3 ml-[-5%] mt-4"></div>
        </div>

        <div class="relative z-10 pt-48 px-20">
            <p class="text-xs font-mono text-gray-500 mb-2 uppercase tracking-widest">
                {{ certificate.certificateCode }}
            </p>
            <h1 class="text-4xl font-bold text-[#074026] tracking-[0.3em] dark:!text-gray-200">CERTIFICATE</h1>
            <h2 class="text-lg font-semibold tracking-[0.5em] text-[#074026] mt-2 dark:!text-gray-200">OF COMPLETION
            </h2>

            <p class="mt-12 text-sm text-gray-600 font-medium">Proudly present to :</p>

            <div class="mt-4 border-b-2 border-[#48a82b] w-3/4">
                <span class="text-2xl font-semibold text-gray-800 italic leading-relaxed dark:text-gray-200">
                    {{ certificate.user.firstname }} {{ certificate.user.lastname }}
                </span>
            </div>

            <p class="mt-10 w-2/3 text-lg leading-relaxed text-gray-700">
                This certifies that the participant has gained knowledge and practical skills in
                <span class="font-semibold">{{ certificate.course.courseName }}</span>,
                proper plant care, and maintenance techniques based on Growfico standards.
            </p>

            <p class="mt-6 text-sm text-gray-500">
                Issued on: {{ certificate.issuedAt ? certificate.issuedAt|date('F d, Y') : 'N/A' }}
            </p>
        </div>

        <div class="absolute bottom-20 left-20 flex flex-col items-center">
            <div class="relative w-64 flex flex-col-reverse">

                <img src="{{ asset('logos/e-signature.png') }}"
                    class="absolute -top-14 left-0 w-full pointer-events-none z-50 dark:hidden">
                <img src="{{ asset('logos/e-signature-light.png') }}"
                    class="absolute -top-14 left-0 w-full pointer-events-none z-50 hidden dark:block print:hidden">

                <p class="mt-2 px-12 text-[#074026] text-sm z-10 dark:!text-gray-200">Growfico Founder</p>
                <div class="border-b-2 border-[#48a82b] w-full z-10"></div>
                <p class="px-12 text-[#074026] text-lg mt-1 z-10 dark:!text-gray-200">Pacifico Oyanib III</p>
            </div>
        </div>

        <div class="absolute bottom-0 right-0 w-64 h-64 overflow-hidden">
            <div class="absolute bottom-[-20px] right-[-20px] bg-[#48a82b] w-full h-full rotate-45"></div>
            <div class="absolute bottom-[-60px] right-[-40px] bg-[#074026] w-full h-full rotate-45 opacity-90"></div>
        </div>
    </div>
    <div class="mt-8 bg-blue-50 border border-blue-200 rounded-lg p-4">
        <p class="text-sm text-blue-900">
            <strong>Certificate Details:</strong> This certificate verifies that {{ user.firstName }} {{ user.lastName
            }} has successfully completed the {{ course.courseName }} course offered by Growfico on {{
            certificate.issuedAt|date('F d, Y') }}.
        </p>
    </div>
</div>

<style>
   @media print {
        body * {
            visibility: hidden;
        }

        #certificate,
        #certificate * {
            visibility: visible;
        }

        #certificate {
            position: absolute;
            left: 0;
            top: 0;
            margin: 0 !important;
            padding: 0 !important;
        }

        .no-print {
            display: none !important;
        }

        @page {
            size: landscape;
            margin: 0;
        }
    }
</style>
{% endblock %}