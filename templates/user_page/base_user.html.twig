{% extends 'base.html.twig' %}

{% block body %}
<div class="user-app flex min-h-screen bg-background">
	<!-- Mobile Menu Button (FAB) -->
	<button type="button"
		class="js-user-mobile-menu js-user-mobile-menu-fab lg:hidden fixed top-4 left-4 z-50 p-2 rounded-full bg-white dark:bg-gray-800 text-light-gray hover:text-dark-forest-green dark:hover:text-gray-100 transition-all duration-200">
		<ion-icon name="menu-outline" class="text-xl"></ion-icon>
	</button>

	<!-- Sidebar -->
	<aside id="sidebar"
		class="fixed lg:fixed inset-y-0 left-0 z-40 w-72 bg-white dark:bg-gray-800 border-r border-gray-200 dark:border-gray-700 flex flex-col shadow-sm transform -translate-x-full lg:translate-x-0 transition-transform duration-300 ease-in-out">
		<!-- Logo Section -->
		<div
			class="flex items-center h-20 gap-3 px-4 py-4 border-b border-gray-200 dark:border-gray-700 shadow-sm bg-white dark:bg-gray-800">
			<div class="w-10 h-10 rounded-xl overflow-hidden ">
				<img src="{{ asset('logos/Icon- Brand.png') }}" alt="Growfico"
					class="w-full h-full object-cover object-center" />
			</div>
			<div>
				<h1 class="text-lg font-semibold text-dark-forest-green dark:text-gray-100">Growfico</h1>
				<p class="text-xs text-light-gray dark:text-gray-400">
					{{ is_granted('ROLE_STAFF') ? 'Staff' : 'User' }} Dashboard
				</p>
			</div>
		</div>
		{% set links = [
		{'label': 'Dashboard', 'route': path('app_user_page'), 'icon': 'grid-outline', 'route_name': 'app_user_page'},
		{'label': 'Shop', 'route': path('app_user_home'), 'icon': 'cart-outline', 'route_name': 'app_user_home'},
		{'label': 'Community', 'route': path('app_chatroom'), 'icon': 'people-outline', 'route_name': 'app_chatroom'},
		{'label': 'Cart', 'route': path('app_user_cart'), 'icon': 'bag-outline', 'route_name': 'app_user_cart'},
		{'label': 'Products', 'route': path('app_product_index'), 'icon': 'pricetags-outline', 'route_name':
		'app_product_index', roles: ['ROLE_STAFF']},
		{'label': 'Stock', 'route': path('app_stock_index'), 'icon': 'cube-outline', 'route_name': 'app_stock_index',
		'roles': ['ROLE_STAFF']},
		{'label': 'Courses', 'route': path('app_user_courses'), 'icon': 'school-outline', 'route_name':
		'app_user_courses', 'route_prefix': 'app_user_course'},

		]%}
		{% include 'user_page/_sidebar_links.html.twig' with { links: links } %}

		<!-- Sidebar Footer -->
		<div class="px-6 py-4 border-t border-gray-100 dark:border-gray-700 text-xs text-light-gray dark:text-gray-400">
			<p>&copy; {{ "now"|date("Y") }} Growfico. All rights reserved.</p>
		</div>
	</aside>

	<!-- Mobile Overlay -->
	<div id="mobile-overlay" class="fixed inset-0 bg-black bg-opacity-50 z-30 lg:hidden hidden"></div>

	<!-- Main Content Area -->
	<div class="flex flex-col flex-1 min-w-0 lg:ml-72">
		<!-- Header -->
		<header id="main-header"
			class="sticky h-20 top-0 z-30 bg-white dark:bg-gray-800 border-b border-gray-200 dark:border-gray-700 px-4 py-4 shadow-sm">
			<div class="flex items-center justify-between w-full max-w-full">
				<div class="flex items-center gap-3">
					<button type="button"
						class="js-user-mobile-menu js-user-mobile-menu-header lg:hidden p-2 rounded-xl bg-gray-50 dark:bg-gray-700 text-light-gray hover:text-dark-forest-green dark:hover:text-gray-100 transition-all duration-200 flex items-center justify-center">
						<ion-icon name="menu-outline" class="text-2xl"></ion-icon>
					</button>

					<div class="hidden sm:block">
						<h2
							class="{% block page_title_heading_class %}text-lg font-semibold text-dark-forest-green dark:text-gray-100 leading-tight{% endblock %}">
							{% block page_title %}Dashboard{% endblock %}
						</h2>
						<p class="text-xs text-light-gray dark:text-gray-400">
							{% block page_subtitle %}Personal workspace tailored to your role.{% endblock %}
						</p>
					</div>
				</div>

				<div class="flex items-center gap-1 sm:gap-2">
					<a id="header-cart-btn" href="{{ path('app_user_cart') }}"
						class="relative w-10 h-10 flex items-center justify-center rounded-full text-gray-500 dark:text-gray-400 hover:text-gray-900 dark:hover:text-gray-100 hover:bg-gray-100 dark:hover:bg-gray-700 transition-colors duration-200 no-underline"
						title="View cart">
						<ion-icon name="cart-outline" class="text-xl"></ion-icon>

						<span id="header-cart-count"
							class="absolute -top-1 -right-1 min-w-[18px] h-[18px] px-1 bg-red-600 text-white text-[10px] font-semibold flex items-center justify-center rounded-full border-2 border-white dark:border-gray-800 hidden">
							0
						</span>
					</a>

					<button id="theme-toggle" type="button"
						class="w-10 h-10 flex items-center justify-center rounded-full text-gray-500 dark:text-gray-400 hover:text-gray-900 dark:hover:text-gray-100 hover:bg-gray-100 dark:hover:bg-gray-700 transition-colors duration-200">
						<ion-icon id="theme-icon" name="moon-outline" class="text-xl"></ion-icon>
					</button>

					<div class="relative ml-1" x-data="{ open: false }">
						<button type="button" @click="open = !open" @click.outside="open = false"
							class="group flex items-center rounded-full bg-gray-50 dark:bg-gray-700 hover:bg-gray-100 dark:hover:bg-gray-600 transition-colors duration-200 p-1">
							<div
								class="w-8 h-8 bg-gradient-to-br from-bright-green to-primary-600 text-white flex items-center justify-center rounded-full font-semibold text-sm overflow-hidden shadow-sm">
								{% if app.user.profileImage %}
								{% set baseUserProfilePath = app.user.profileImage %}
								{% if baseUserProfilePath starts with '/' %}{% set baseUserProfilePath = baseUserProfilePath[1:] %}{% endif %}
								<img src="{{ asset(baseUserProfilePath) }}" alt="Profile"
									class="w-full h-full object-cover"
									onerror="this.style.display='none';">
								{% endif %}
								<span class="{% if app.user.profileImage %}hidden{% endif %}">
									{{ app.user.firstName ? app.user.firstName|first|upper : app.user.email|first|upper }}
								</span>
							</div>
							<ion-icon name="chevron-down-outline"
								class="ml-1 text-xs text-gray-500 dark:text-gray-400 group-hover:text-gray-900 dark:group-hover:text-white transition-transform duration-200"
								:class="open ? 'rotate-180' : ''"></ion-icon>
						</button>

						<div x-show="open" x-transition
							class="absolute right-0 mt-2 w-48 bg-white dark:bg-gray-800 border border-gray-100 dark:border-gray-700 rounded-xl shadow-xl z-50 py-2"
							style="display: none;">
							<a href="{{ path('app_user_profile') }}"
								class="flex items-center gap-3 px-4 py-2 text-sm text-gray-600 dark:text-gray-300 hover:bg-gray-50 dark:hover:bg-gray-700 transition-colors">
								<ion-icon name="person-outline" class="text-lg"></ion-icon>
								My Profile
							</a>
							<a href="{{ path('app_user_profile', {edit: 'personal'}) }}"
								class="flex items-center gap-3 px-4 py-2 text-sm text-gray-600 dark:text-gray-300 hover:bg-gray-50 dark:hover:bg-gray-700 transition-colors">
								<ion-icon name="create-outline" class="text-lg"></ion-icon>
								Edit Profile
							</a>
							<hr class="my-1 border-gray-100 dark:border-gray-700">
							<button id="user-logout-btn-dropdown" @click="open = false"
								class="w-full flex items-center gap-3 px-4 py-2 text-sm text-red-600 dark:text-red-400 hover:bg-red-50 dark:hover:bg-red-950/40 transition-colors text-left">
								<ion-icon name="log-out-outline" class="text-lg"></ion-icon>
								Logout
							</button>
						</div>
					</div>
				</div>
			</div>
		</header>
		<!-- Main Content -->
		<main class="flex-1 px-4 sm:px-6 lg:px-8 py-6 overflow-y-auto text-gray-900 dark:text-gray-100">
			{% block user_content %}{% endblock %}
		</main>
	</div>
</div>

<!-- Logout Confirmation Modal -->
<div id="user-logout-modal" class="fixed inset-0 z-50 hidden backdrop-blur-md" style="display: none;">
	<div class="absolute inset-0 bg-black/40 backdrop-blur-md"></div>
	<div class="absolute inset-0 flex items-center justify-center">
		<div
			class="bg-white dark:bg-gray-800 rounded-2xl shadow-2xl p-8 max-w-md w-full mx-4 transform transition-all relative z-10 border border-gray-100 dark:border-gray-700">
			<div class="flex items-center gap-4 mb-4">
				<div class="w-12 h-12 rounded-full bg-red-100 dark:bg-red-950/50 flex items-center justify-center">
					<ion-icon name="alert-circle-outline" class="text-2xl text-red-600 dark:text-red-400"></ion-icon>
				</div>
				<div>
					<h3 class="text-lg font-semibold text-dark-forest-green dark:text-gray-100">Confirm Logout</h3>
					<p class="text-xs text-light-gray dark:text-gray-400">Are you sure you want to logout?</p>
				</div>
			</div>
			<p class="text-sm text-light-gray dark:text-gray-400 mb-6">You will be logged out of your account.</p>
			<div class="flex gap-3">
				<button id="user-logout-cancel" type="button"
					class="flex-1 px-4 py-2.5 rounded-lg bg-gray-100 dark:bg-gray-700 hover:bg-gray-200 dark:hover:bg-gray-600 text-dark-forest-green dark:text-gray-100 font-medium transition-colors duration-200">
					Cancel
				</button>
				<a id="user-logout-confirm" href="{{ path('app_logout') }}"
					class="flex-1 px-4 py-2.5 rounded-lg bg-red-600 hover:bg-red-700 text-white font-medium transition-colors duration-200 text-center no-underline flex items-center justify-center">
					Logout
				</a>
			</div>
		</div>
	</div>
</div>

<script>
	window.growficoCartSummaryUrl = "{{ path('app_user_cart_summary')|e('js') }}";
	window.growficoCartPageUrl = "{{ path('app_user_cart')|e('js') }}";
</script>
<script src="{{ asset('js/userbase.js') }}"></script>
{% block extra_scripts %}{% endblock %}
{% endblock %}