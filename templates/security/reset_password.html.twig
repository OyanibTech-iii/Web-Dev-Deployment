{% extends 'base.html.twig' %}

{% block title %}Reset Password | Growfico{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('styles/animation.css') }}">
{% endblock %}

{% block body %}
<div class="flex items-center justify-center min-h-screen overflow-x-hidden overflow-y-auto bg-cover bg-center bg-no-repeat px-4 py-6 sm:px-6 sm:py-8 dark:bg-gray-800"
    style="--bg-url: url('{{ asset('leaf/forest-bg.png') }}'); background-image: var(--bg-url);">

    <div class="bg-bg-custom flex items-center justify-center w-full max-w-4xl animate-scale-in">
        <div class="flex flex-col md:flex-row w-full bg-white rounded-2xl shadow-xl overflow-hidden dark:bg-gray-800">

            <div class="flex-1 p-6 sm:p-8 md:p-12 flex flex-col justify-center">
                <div class="max-w-lg mx-auto w-full">
                    <h2 class="text-xl font-sans font-bold text-dark-forest-green mb-2 animate-fade-in-up reveal-on-load dark:!text-gray-200">
                        Reset Password
                    </h2>

                    <p class="text-sm text-gray-600 mb-6 animate-fade-in-up reveal-on-load delay-100 dark:!text-gray-300">
                        Create a new password for your account. Use a strong password that's at least 8 characters long.
                    </p>

                    {% if app.flashes('error') %}
                        {% for message in app.flashes('error') %}
                        <div class="bg-red-100 text-red-700 px-4 py-3 rounded mb-4 animate-fade-in-up dark:bg-gray-800 dark:!text-red-700"
                            role="alert">
                            <strong class="font-bold text-sm dark:!text-red-500">Error:</strong>
                            <span class="block sm:inline text-xs dark:!text-red-400">{{ message }}</span>
                        </div>
                        {% endfor %}
                    {% endif %}

                    <form id="reset-password-form" method="post" action="{{ path('app_reset_password_request') }}" 
                        accept-charset="UTF-8" class="space-y-4 py-3" data-turbo="false" autocomplete="off"
                        x-data="passwordResetMeter()">

                        <input type="hidden" name="token" value="{{ token }}">

                        <div class="animate-fade-in-up reveal-on-load delay-200">
                            <label for="password" class="block text-gray-700 text-sm font-regular dark:!text-gray-200">
                                New Password
                            </label>
                            <div class="relative">
                                <input id="password" type="password" name="password" 
                                    minlength="8"
                                    required
                                    placeholder="••••••••"
                                    x-model="password"
                                    @input="calculateStrength()"
                                    class="w-full py-1 px-0 border-0 border-b-2 border-gray-200 focus:border-bright-green focus:outline-none transition-colors duration-200 bg-transparent pr-8 dark:border-gray-400 dark:!bg-gray-700 dark:!text-gray-200">
                                <button type="button" onclick="togglePassword('password')"
                                    class="absolute right-0 top-0 text-dark-forest-green hover:text-bright-green focus:outline-none dark:!text-gray-200">
                                    <ion-icon id="password-eye" name="eye-outline" class="text-xl"></ion-icon>
                                </button>
                            </div>
                            <p class="text-xs text-gray-500 mt-1 dark:!text-gray-400">
                                Must be at least 8 characters long
                            </p>

                            <div x-show="password.length > 0" class="mt-2 transition-opacity duration-300">
                                <div class="flex items-center justify-between mb-1">
                                    <span class="text-[10px] uppercase tracking-wider font-bold" :class="colorClass" x-text="label"></span>
                                    <span class="text-[10px] text-gray-400" x-text="strength + '%'"></span>
                                </div>
                                <div class="w-full bg-gray-200 dark:bg-gray-700 rounded-full h-1">
                                    <div class="h-1 rounded-full transition-all duration-500" 
                                         :style="`width: ${strength}%`" 
                                         :class="barClass"></div>
                                </div>
                            </div>
                        </div>

                        <div class="animate-fade-in-up reveal-on-load delay-300">
                            <label for="password_confirm" class="block text-gray-700 text-sm font-regular dark:!text-gray-200">
                                Confirm Password
                            </label>
                            <div class="relative">
                                <input id="password_confirm" type="password" name="password_confirm" 
                                    minlength="8"
                                    required
                                    placeholder="••••••••"
                                    x-model="passwordConfirm"
                                    class="w-full py-1 px-0 border-0 border-b-2 border-gray-200 focus:border-bright-green focus:outline-none transition-colors duration-200 bg-transparent pr-8 dark:border-gray-400 dark:!bg-gray-700 dark:!text-gray-200"
                                    :class="passwordConfirm && password !== passwordConfirm ? 'border-red-500' : ''">
                                <button type="button" onclick="togglePassword('password_confirm')"
                                    class="absolute right-0 top-0 text-dark-forest-green hover:text-bright-green focus:outline-none dark:!text-gray-200">
                                    <ion-icon id="password_confirm-eye" name="eye-outline" class="text-xl"></ion-icon>
                                </button>
                            </div>
                            <p x-show="passwordConfirm && password !== passwordConfirm" class="text-xs text-red-500 mt-1">
                                Passwords do not match
                            </p>
                        </div>

                        <div class="bg-blue-50 border-l-4 border-bright-green p-3 rounded animate-fade-in-up reveal-on-load delay-400 dark:bg-gray-700 dark:!border-bright-green">
                            <p class="text-xs text-gray-700 dark:!text-gray-300">
                                <strong>Password Tips:</strong>
                            </p>
                            <ul class="text-xs text-gray-600 dark:!text-gray-400 mt-1 space-y-1">
                                <li>Use a mix of uppercase and lowercase letters</li>
                                <li>Include numbers and special characters</li>
                                <li>Avoid using personal information</li>
                            </ul>
                        </div>

                        <div class="space-y-4 animate-fade-in-up reveal-on-load delay-500 pt-6">
                            <button type="submit"
                                class="w-full bg-bright-green text-white py-2 px-2 rounded-2xl font-medium text-sm hover:scale-[1.02] active:scale-[0.98] transition-all duration-200">
                                RESET PASSWORD
                            </button>
                        </div>
                    </form>

                    <p class="font-sans text-xs text-light-gray mt-6 animate-fade-in-up reveal-on-load delay-600 text-center dark:!text-gray-400">
                        <a href="{{ path('app_login') }}" class="text-bright-green hover:underline font-bold">Back to Login</a>
                    </p>
                </div>
            </div>

            <div class="flex-1 text-white p-6 sm:p-8 md:p-12 flex flex-col justify-center relative min-h-[220px] md:min-h-0
                            bg-[linear-gradient(rgba(9,64,33,0.85),rgba(9,64,33,0.85)),url('../gardens/garden3.png')]
                            border-1 border-gray-400 bg-cover bg-center md:rounded-r-2xl dark:!bg-[linear-gradient(rgba(6,44,23,0.9),rgba(6,44,23,0.9)),url('../gardens/garden3.png')]">
                <div class="flex flex-col space-y-4">
                    <h3 class="text-2xl font-bold mb-2">Strong Password</h3>
                    <p class="text-sm opacity-90">
                        A strong password is your first line of defense against unauthorized access. Choose something unique and memorable only to you.
                    </p>
                    <ul class="mt-4 space-y-2 text-xs opacity-80">
                        <li class="flex items-center space-x-2">
                            <ion-icon name="checkmark-circle" class="text-bright-green text-lg"></ion-icon>
                            <span>Minimum 8 characters</span>
                        </li>
                        <li class="flex items-center space-x-2">
                            <ion-icon name="checkmark-circle" class="text-bright-green text-lg"></ion-icon>
                            <span>Mix of characters & numbers</span>
                        </li>
                        <li class="flex items-center space-x-2">
                            <ion-icon name="checkmark-circle" class="text-bright-green text-lg"></ion-icon>
                            <span>Your accounts stay protected</span>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    function togglePassword(fieldId) {
        const passwordField = document.getElementById(fieldId);
        const eyeIcon = document.getElementById(fieldId + '-eye');
        
        if (passwordField.type === 'password') {
            passwordField.type = 'text';
            eyeIcon.setAttribute('name', 'eye-off-outline');
        } else {
            passwordField.type = 'password';
            eyeIcon.setAttribute('name', 'eye-outline');
        }
    }

    function passwordResetMeter() {
        return {
            password: '',
            passwordConfirm: '',
            strength: 0,
            label: 'Weak',
            colorClass: 'text-red-500',
            barClass: 'bg-red-500',

            calculateStrength() {
                let score = 0;
                if (this.password.length === 0) {
                    this.strength = 0;
                    return;
                }

                if (this.password.length >= 8) score += 25;
                if (this.password.length >= 12) score += 10;
                
                if (/[A-Z]/.test(this.password)) score += 20;
                if (/[0-9]/.test(this.password)) score += 20;
                if (/[^A-Za-z0-9]/.test(this.password)) score += 25;

                this.strength = Math.min(score, 100);

                if (this.strength < 40) {
                    this.label = 'Weak';
                    this.colorClass = 'text-red-500';
                    this.barClass = 'bg-red-500';
                } else if (this.strength < 70) {
                    this.label = 'Fair';
                    this.colorClass = 'text-yellow-500';
                    this.barClass = 'bg-yellow-500';
                } else if (this.strength < 90) {
                    this.label = 'Good';
                    this.colorClass = 'text-blue-500';
                    this.barClass = 'bg-blue-500';
                } else {
                    this.label = 'Strong';
                    this.colorClass = 'text-bright-green';
                    this.barClass = 'bg-bright-green';
                }
            }
        }
    }

    // Form submission validation
    const form = document.getElementById('reset-password-form');
    if (form) {
        form.addEventListener('submit', function(e) {
            const passwordInput = document.getElementById('password');
            const passwordConfirmInput = document.getElementById('password_confirm');
            
            if (passwordInput.value !== passwordConfirmInput.value) {
                e.preventDefault();
                window.showAlertModal({
                    title: 'Password Mismatch',
                    message: 'The passwords you entered do not match. Please try again.',
                    confirmClass: 'bg-red-600'
                });
                return false;
            }
        });
    }
</script>
{% endblock %}
