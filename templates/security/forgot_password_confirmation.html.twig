{% extends 'base.html.twig' %}

{% block title %}Check Your Email | Growfico{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('styles/animation.css') }}">
{% endblock %}

{% block body %}
<div class="flex items-center justify-center min-h-screen overflow-x-hidden overflow-y-auto bg-cover bg-center bg-no-repeat px-4 py-6 sm:px-6 sm:py-8 dark:bg-gray-800"
    style="--bg-url: url('{{ asset('leaf/forest-bg.png') }}'); background-image: var(--bg-url);">

    <div class="bg-bg-custom flex items-center justify-center w-full max-w-4xl animate-scale-in">
        <div class="flex flex-col md:flex-row w-full bg-white rounded-2xl shadow-xl overflow-hidden dark:bg-gray-800">

            <div class="flex-1 p-6 sm:p-8 md:p-12 flex flex-col justify-center">
                <div class="max-w-lg mx-auto w-full text-center">
                 
                    <h2 class="text-2xl font-sans font-bold text-dark-forest-green mb-2 animate-fade-in-up reveal-on-load dark:!text-gray-200">
                        Check Your Email
                    </h2>

                    <p class="text-sm text-gray-600 animate-fade-in-up reveal-on-load delay-100 dark:!text-gray-300 mb-4">
                        We've sent a password reset link to your email address.
                    </p>

                    <div class="bg-blue-50 border-l-4 border-bright-green p-4 rounded animate-fade-in-up reveal-on-load delay-200 dark:bg-gray-700 dark:!border-bright-green mb-6">
                        <p class="text-sm text-gray-700 dark:!text-gray-300">
                            <strong>Didn't receive the email?</strong>
                        </p>
                        <ul class="text-xs text-gray-600 dark:!text-gray-400 mt-2 space-y-1">
                            <li>• Check your spam or junk folder</li>
                            <li>• Make sure you entered the correct email address</li>
                            <li>• The link will expire in 1 hour</li>
                        </ul>
                    </div>

                    <p class="text-xs text-gray-500 dark:!text-gray-400 mb-6">
                        The password reset link is valid for <strong>1 hour</strong>. For security reasons, the link can only be used once.
                    </p>

                    <div class="space-y-3 animate-fade-in-up reveal-on-load delay-300">
                        <a href="{{ path('app_forgot_password') }}"
                            class="inline-block bg-bright-green text-white py-2 px-6 rounded-2xl font-medium text-sm hover:scale-[1.02] active:scale-[0.98] transition-all duration-200">
                            Send Again
                        </a>
                    </div>

                    <p class="font-sans text-xs text-light-gray mt-8 dark:!text-gray-400">
                        <a href="{{ path('app_login') }}" class="text-bright-green hover:underline font-bold">Back to Login</a>
                    </p>
                </div>
            </div>

            <div class="flex-1 text-white p-6 sm:p-8 md:p-12 md:flex md:flex-col md:justify-center relative min-h-[220px] md:min-h-0 hidden
                            bg-[linear-gradient(rgba(9,64,33,0.85),rgba(9,64,33,0.85)),url('../gardens/garden3.png')]
                            border-1 border-gray-400 bg-cover bg-center md:rounded-r-2xl dark:!bg-[linear-gradient(rgba(6,44,23,0.9),rgba(6,44,23,0.9)),url('../gardens/garden3.png')]">
                <div class="flex flex-col space-y-4">
                    <h3 class="text-2xl font-bold mb-2">Security First</h3>
                    <p class="text-sm opacity-90">
                        Your security is our top priority. We use industry-standard email encryption to keep your password reset process secure.
                    </p>
                    <ul class="mt-4 space-y-2 text-xs opacity-80">
                        <li class="flex items-center space-x-2">
                            <ion-icon name="shield-checkmark" class="text-bright-green text-lg"></ion-icon>
                            <span>Secure email delivery</span>
                        </li>
                        <li class="flex items-center space-x-2">
                            <ion-icon name="time" class="text-bright-green text-lg"></ion-icon>
                            <span>Links expire after 1 hour</span>
                        </li>
                        <li class="flex items-center space-x-2">
                            <ion-icon name="lock-closed" class="text-bright-green text-lg"></ion-icon>
                            <span>One-time use only</span>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
