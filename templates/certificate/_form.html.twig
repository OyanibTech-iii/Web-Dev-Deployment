{{ form_start(form, {'attr': {'class': 'w-full space-y-6'}}) }}
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div class="space-y-2 md:col-span-2" style="display: none;">
            {{ form_label(form.id, 'Id', {'label_attr': {'class': 'block text-base font-semibold text-dark-forest-green'}}) }}
            {{ form_widget(form.id, {'attr': {'class': 'w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-bright-green focus:border-transparent transition-colors duration-200 text-dark-forest-green'}}) }}
            {{ form_errors(form.id) }}
        </div>

        <div class="space-y-2 md:col-span-2">
            {{ form_label(form.certificateCode, 'Certificate Code', {'label_attr': {'class': 'block text-base font-semibold text-dark-forest-green'}}) }}
            {{ form_widget(form.certificateCode, {'attr': {'class': 'w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-bright-green focus:border-transparent transition-colors duration-200 text-dark-forest-green'}}) }}
            {{ form_errors(form.certificateCode) }}
        </div>

        {% if form.issuedAt is defined %}
        <div class="space-y-2 md:col-span-2">
            {{ form_label(form.issuedAt, 'Issued At', {'label_attr': {'class': 'block text-base font-semibold text-dark-forest-green'}}) }}
            {{ form_widget(form.issuedAt, {'attr': {'class': 'w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-bright-green focus:border-transparent transition-colors duration-200 text-dark-forest-green'}}) }}
            {{ form_errors(form.issuedAt) }}
        </div>
        {% endif %}
    </div>

    <div class="flex flex-col sm:flex-row gap-4 justify-end mt-4">
        <a href="{{ path('app_certificate_index') }}"
           class="inline-flex items-center justify-center px-6 py-3 bg-gray-100 text-dark-forest-green font-semibold rounded-lg hover:bg-gray-200 transition-colors duration-200 dark:bg-gray-700 dark:text-gray-200">
            Cancel
        </a>
        <button type="submit"
                class="inline-flex items-center justify-center px-6 py-3 bg-bright-green text-white font-semibold rounded-lg hover:bg-green-600 transition-colors duration-200 shadow-md hover:shadow-lg">
            <ion-icon name="checkmark-circle-outline" class="w-4 h-4 mr-2"></ion-icon>
            {{ button_label|default('Save Certificate') }}
        </button>
    </div>
{{ form_end(form) }}
