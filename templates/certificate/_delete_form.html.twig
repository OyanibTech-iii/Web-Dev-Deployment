<form method="post" action="{{ path('app_certificate_delete', {'id': certificate.id}) }}" onsubmit="return confirm('Are you sure you want to delete this certificate?');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ certificate.id) }}">
    <button class="inline-flex items-center justify-center px-5 py-2.5 bg-red-600 text-white text-sm font-medium rounded-lg hover:bg-red-700 transition-colors duration-200">
        <ion-icon name="trash-outline" class="w-4 h-4 mr-2"></ion-icon>
        Delete
    </button>
</form>
