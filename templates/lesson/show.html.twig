{% extends 'base.html.twig' %}

{% block title %}Lesson{% endblock %}

{% block body %}
    <h1>Lesson</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ lesson.id }}</td>
            </tr>
            <tr>
                <th>Title</th>
                <td>{{ lesson.title }}</td>
            </tr>
            <tr>
                <th>Content</th>
                <td>
                    {% if lesson.contentFile %}
                        <p><a href="{{ asset('uploads/lessons/' ~ lesson.contentFile) }}" target="_blank" rel="noopener">PDF: {{ lesson.contentFile }}</a></p>
                        <iframe src="{{ asset('uploads/lessons/' ~ lesson.contentFile) }}" title="Lesson PDF" class="w-full min-h-[400px] border border-gray-200 rounded"></iframe>
                    {% endif %}
                    {% if lesson.content %}
                        <pre class="whitespace-pre-wrap text-sm mt-2">{{ lesson.content }}</pre>
                    {% elseif not lesson.contentFile %}
                        <span class="text-gray-500">—</span>
                    {% endif %}
                </td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_lesson_index') }}">back to list</a>

    <a href="{{ path('app_lesson_edit', {'id': lesson.id}) }}">edit</a>

    {{ include('lesson/_delete_form.html.twig') }}
{% endblock %}
