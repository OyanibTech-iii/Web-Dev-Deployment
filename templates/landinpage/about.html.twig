                                    <div
                                        class="w-12 h-12 rounded-full overflow-hidden bg-gray-50 dark:bg-gray-700 mb-3">
                                        <img src="{{ t.image }}" alt="{{ t.name }}" class="w-full h-full object-cover">
                                    </div>
                                    <div
                                        class="font-bold text-dark-forest-green text-sm leading-tight break-words dark:!text-gray-200">
                                        {{ t.name }}
                                    </div>
                                    <div
                                        class="text-[10px] text-light-gray dark:!text-gray-300 uppercase tracking-tight mt-1">
                                        {{ t.role }}
                                    </div>
                                    <div class="text-[10px] text-bright-green font-semibold">
                                        {{ t.company }}
                                    </div>
                                </div>

                                <div class="flex-1 min-w-0 border-l border-gray-100 dark:border-gray-600 pl-6">
                                    <p class="text-sm text-gray-600 dark:text-gray-300 italic leading-relaxed">
                                        "{{ t.content }}"
                                    </p>
                                </div>
                            </div>
                        </div>
                        {% endfor %}
                    </div>

                    <div class="flex gap-6 animate-marquee flex-nowrap" aria-hidden="true"
                        :style="paused ? 'animation-play-state: paused' : ''">
                        {% for t in testimonials %}
                        <div
                            class="bg-white dark:bg-gray-800 border border-gray-100 dark:border-gray-700 shadow-sm rounded-xl p-6 w-[450px] flex-shrink-0">
                            <div class="flex items-start gap-6">
                                <div class="flex-shrink-0 w-32">
                                    <div
                                        class="w-12 h-12 rounded-full overflow-hidden bg-gray-50 dark:bg-gray-700 mb-3">
                                        <img src="{{ t.image }}" alt="{{ t.name }}" class="w-full h-full object-cover">
                                    </div>
                                    <div
                                        class="font-bold text-dark-forest-green dark:!text-gray-200 text-sm leading-tight break-words">
                                        {{ t.name }}
                                    </div>
                                    <div
                                        class="text-[10px] text-light-gray uppercase tracking-tight mt-1 dark:!text-gray-300">
                                        {{ t.role }}
                                    </div>
                                    <div class="text-[10px] text-bright-green font-semibold">
                                        {{ t.company }}
                                    </div>
                                </div>

                                <div class="flex-1 min-w-0 border-l border-gray-100 dark:border-gray-600 pl-6">
                                    <p class="text-sm text-gray-600 dark:text-gray-300 italic leading-relaxed">
                                        "{{ t.content }}"
                                    </p>
                                </div>
                            </div>
                        </div>
                        {% endfor %}
                    </div>

                </div>
            </div>
        </div>
    </section>
</main>

