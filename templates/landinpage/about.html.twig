                <div class="flex gap-6 py-4" @mouseenter="paused = true" @mouseleave="paused = false">

                    <div class="flex gap-6 animate-marquee flex-nowrap"
                        :style="paused ? 'animation-play-state: paused' : ''">
                        {% for t in testimonials %}
                        <div
                            class="bg-white dark:bg-gray-800 border border-gray-100 dark:border-gray-700 shadow-sm rounded-xl p-6 w-[450px] flex-shrink-0">
                            <div class="flex items-start gap-6">
