<section class="py-20  overflow-hidden" x-data="{ shown: false }" x-intersect.once="shown = true">

    <div class="container max-w-6xl mx-auto px-4">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-start">

            <div class="p-8 rounded-2xl bg-white dark:bg-gray-800 shadow-xl border border-gray-50 dark:border-gray-700 transition-all duration-1000 transform"
                :class="shown ? 'opacity-100 translate-x-0' : 'opacity-0 -translate-x-20'">

                <h2 class="text-2xl text-dark-forest-green mb-6 flex items-center gap-2 dark:!text-gray-200">
                    Send us a Message
                </h2>

                <form id="contact-form" data-public-key="{{ emailjs_public_key }}"
                    data-service-id="{{ emailjs_service_id }}" data-template-id="{{ emailjs_template_id }}"
                    class="space-y-6">

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <div class="space-y-2">
                            <label class="block text-sm font-medium text-dark-forest-green dark:!text-gray-200">First
                                Name</label>
                            <input type="text" name="first_name" required
                                class="w-full px-4 py-3 border border-gray-200 dark:border-gray-600 rounded-xl bg-white dark:bg-gray-900 text-gray-900 dark:!text-gray-200 focus:ring-2 focus:ring-bright-green focus:border-transparent outline-none transition-all">
                        </div>
                        <div class="space-y-2">
                            <label class="block text-sm font-medium text-dark-forest-green dark:!text-gray-200">Last
                                Name</label>
                            <input type="text" name="last_name" required
                                class="w-full px-4 py-3 border border-gray-200 dark:border-gray-600 rounded-xl bg-white dark:bg-gray-900 text-gray-900 dark:!text-gray-200 focus:ring-2 focus:ring-bright-green focus:border-transparent outline-none transition-all">
                        </div>
                    </div>

                    <div class="space-y-2">
                        <label
                            class="block text-sm font-medium text-dark-forest-green dark:!text-gray-200">Email</label>
                        <input type="email" name="user_email" required
                            class="w-full px-4 py-3 border border-gray-200 dark:border-gray-600 rounded-xl bg-white dark:bg-gray-900 text-gray-900 dark:!text-gray-200 focus:ring-2 focus:ring-bright-green focus:border-transparent outline-none transition-all">
                    </div>

                    <div class="space-y-2">
                        <label
                            class="block text-sm font-medium text-dark-forest-green dark:!text-gray-200">Message</label>
                        <textarea name="message" rows="4"
                            class="w-full px-4 py-3 border border-gray-200 dark:border-gray-600 rounded-xl bg-white dark:bg-gray-900 text-gray-900 dark:!text-gray-200 focus:ring-2 focus:ring-bright-green focus:border-transparent outline-none transition-all"></textarea>
                    </div>

                    <button type="submit" id="submit-btn"
                        class="w-full bg-bright-green text-white py-4 px-6 rounded-full font-semibold hover:bg-dark-forest-green hover:shadow-lg transform hover:-translate-y-1 transition-all flex items-center justify-center gap-3 group">
                        <span>Send Message</span>
                    </button>
                </form>
            </div>

            <div class="space-y-8 transition-all duration-1000 delay-300 transform"
                :class="shown ? 'opacity-100 translate-x-0' : 'opacity-0 translate-x-20'">

                <div>
                    <h2 class="text-2xl text-dark-forest-green dark:!text-gray-200 mb-6">Visit Our Garden</h2>

                    <div
                        class="map-container relative w-full h-72 rounded-3xl overflow-hidden shadow-lg border border-gray-100 dark:border-gray-700 mb-8 group">
                        <iframe
                            class="absolute inset-0 w-full h-full grayscale hover:grayscale-0 transition-all duration-700"
                            src="https://maps.google.com/maps?width=974&amp;height=419&amp;hl=en&amp;q=dumaguete%20city&amp;t=&amp;z=17&amp;ie=UTF8&amp;iwloc=B&amp;output=embed">

                        </iframe>
                    </div>

                    <div class="grid grid-cols-1 gap-8">
                        <div class="flex items-start gap-5 group">
                            <div
                                class="w-12 h-12 bg-bright-green rounded-full flex items-center justify-center flex-shrink-0 text-bright-green transition-colors duration-300">
                                <ion-icon name="location-outline" class="text-2xl text-white"></ion-icon>
                            </div>
                            <div class="space-y-1">
                                <h4 class="font-semibold text-dark-forest-green dark:!text-gray-200">Location</h4>
                                <p class="text-gray-500 dark:text-gray-400">Kagawasan Ave., Dumaguete City,<br>Negros
                                    Oriental</p>
                            </div>
                        </div>

                        <div class="flex items-start gap-5 group">
                            <div
                                class="w-12 h-12 bg-bright-green rounded-full flex items-center justify-center flex-shrink-0 text-bright-green transition-colors duration-300">
                                <ion-icon name="time-outline" class="text-2xl text-white"></ion-icon>
                            </div>
                            <div class="space-y-1">
                                <h4 class="font-semibold text-dark-forest-green dark:!text-gray-200">Working Hours</h4>
                                <p class="text-sm text-gray-500 dark:text-gray-400">Mon - Fri: 9AM - 6PM</p>
                                <p class="text-sm text-gray-500 dark:text-gray-400">Sat: 10AM - 4PM | Sun: Closed</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</section>
<script type="module" src="https://unpkg.com/ionicons@7.4.0/dist/ionicons/ionicons.esm.js"></script>

<div id="successModal" class="fixed inset-0 z-[100] hidden items-center justify-center p-4 backdrop-blur-sm"
    style="display: none;">
    <div class="absolute inset-0 bg-black/40 dark:bg-black/60"></div>
    <div
        class="relative bg-white dark:bg-gray-800 rounded-2xl shadow-2xl p-8 max-w-sm w-full transform transition-all border border-gray-100 dark:border-gray-700 text-center">
        <div
            class="w-16 h-16 rounded-full bg-green-100 dark:bg-green-900/30 flex items-center justify-center mx-auto mb-4">
            <ion-icon name="checkmark-circle" class="text-4xl text-bright-green"></ion-icon>
        </div>
        <h3 class="text-xl font-bold text-dark-forest-green mb-2 dark:!text-gray-200">Message Sent!</h3>
        <p class="text-sm text-light-gray dark:text-gray-400 mb-6">Your inquiry has reached our garden. We'll get back
            to you shortly.</p>
        <button onclick="closeModal('successModal')"
            class="w-full py-3 px-4 rounded-xl bg-bright-green hover:bg-dark-forest-green text-white font-semibold transition-all duration-200 shadow-lg shadow-bright-green/20">
            Close
        </button>
    </div>
</div>

<div id="errorModal" class="fixed inset-0 z-[100] hidden items-center justify-center p-4 backdrop-blur-sm"
    style="display: none;">
    <div class="absolute inset-0 bg-black/40 dark:bg-black/60"></div>
    <div
        class="relative bg-white dark:bg-gray-800 rounded-2xl shadow-2xl p-8 max-w-sm w-full transform transition-all border border-gray-100 dark:border-gray-700 text-center">
        <div class="w-16 h-16 rounded-full bg-red-100 dark:bg-red-900/30 flex items-center justify-center mx-auto mb-4">
            <ion-icon name="alert-circle" class="text-4xl text-red-600 dark:text-red-400"></ion-icon>
        </div>
        <h3 class="text-xl font-bold text-dark-forest-green dark:text-gray-100 mb-2">Oops!</h3>
        <p class="text-sm text-light-gray dark:text-gray-400 mb-6">Something went wrong. Please check your connection
            and try again.</p>
        <button onclick="closeModal('errorModal')"
            class="w-full py-3 px-4 rounded-xl bg-red-600 hover:bg-red-700 text-white font-semibold transition-all duration-200">
            Try Again
        </button>
    </div>
</div>
<script type="text/javascript" src="https://cdn.jsdelivr.net/npm/@emailjs/browser@4/dist/email.min.js"></script>

<script type="text/javascript">

    function closeModal(modalId = 'successModal') {
        document.getElementById(modalId).style.display = 'none';
    }

    document.addEventListener('DOMContentLoaded', function () {
        const form = document.getElementById('contact-form');
        if (!form) return;

        const publicKey = form.dataset.publicKey;
        emailjs.init(publicKey);

        form.addEventListener('submit', function (event) {
            event.preventDefault();
            const btn = this.querySelector('button[type="submit"]');
            const originalText = btn.innerHTML;

            btn.disabled = true;
            btn.innerHTML = '<span>Sending...</span>';

            emailjs.sendForm(form.dataset.serviceId, form.dataset.templateId, this)
                .then(() => {
                    // Show Success Modal
                    document.getElementById('successModal').style.display = 'flex';
                    // Reset form state
                    btn.disabled = false;
                    btn.innerHTML = originalText;
                    this.reset();
                })
                .catch((error) => {
                    // Show Error Modal instead of alert
                    document.getElementById('errorModal').style.display = 'flex';

                    // Reset button state
                    btn.disabled = false;
                    btn.innerHTML = originalText;
                    console.error('EmailJS Error:', error);
                });
        });
    });
</script>