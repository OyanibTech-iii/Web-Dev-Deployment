<!-- Our Mission -->
<section x-data="{ shown: false }" x-intersect.margin.-10%="shown = true" x-intersect:leave="shown = false"
    class="scroll-section py-20 bg-gradient-to-br from-green-50 to-gray-50 dark:from-gray-900 dark:to-gray-950 mb-24 overflow-hidden">
    <div class="container max-w-6xl mx-auto px-4">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">

            <div class="scroll-content transition-all duration-1000 ease-out-expo"
                :class="shown ? 'opacity-100 translate-y-0' : 'opacity-0 translate-y-12'">
                <h2 class="text-2xl sm:text-3xl md:text-4xl lg:text-4xl font-bold leading-tight">
                    <span class="text-dark-forest-green dark:!text-gray-200 ">Our </span>
                    <span class="text-bright-green">Mission</span>
                </h2>

                <p class="text-lg text-light-gray dark:text-gray-400 leading-relaxed mb-6 mt-4 transition-all duration-700 delay-300"
                    :class="shown ? 'opacity-100 scale-100' : 'opacity-0 scale-50'">
                    We believe that everyone deserves access to fresh, healthy produce. Our mission is to
                    empower individuals and communities to grow their own food sustainably, creating a
                    greener future for generations to come.
                </p>
            </div>

            <div class="scroll-image-container transition-all duration-1000 ease-out-expo delay-300"
                :class="shown ? 'opacity-100 scale-100 rotate-0' : 'opacity-0 scale-90 -rotate-3'">
                <img src="{{ asset('me/myimage.png') }}" alt="Our Mission"
                    class="w-full h-full object-contain rounded-2xl transform transition-transform duration-700 hover:scale-105">
            </div>
        </div>
    </div>
</section>


<section x-data="{ shown: false }" x-intersect.margin.-10%="shown = true" x-intersect:leave="shown = false"
    class="scroll-section py-20 bg-white dark:bg-gray-900 overflow-hidden">
    <div class="container max-w-6xl mx-auto px-4">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">

            <div class="scroll-image-container order-2 lg:order-1 transition-all duration-1000 ease-out-expo"
                :class="shown ? 'opacity-100 translate-x-0' : 'opacity-0 -translate-x-16'">
                <img src="{{ asset('me/mesideview.png') }}" alt="Our Impact"
                    class="w-full h-full object-contain rounded-2xl transition-transform duration-700 hover:scale-105">
            </div>

            <div class="scroll-content order-1 lg:order-2 transition-all duration-1000 ease-out-expo delay-200"
                :class="shown ? 'opacity-100 translate-x-0' : 'opacity-0 translate-x-16'">
                <h2 class="text-2xl sm:text-3xl md:text-4xl lg:text-4xl font-bold leading-tight">
                    <span class="text-dark-forest-green dark:!text-gray-200">Making a </span>
                    <span class="text-bright-green">Difference</span>
                </h2>

                <p class="text-lg text-light-gray dark:text-gray-400 leading-relaxed mb-6 mt-4">
                    Through our innovative growing techniques and community programs, we've helped
                    transform thousands of spaces into productive gardens. See the real impact we're
                    making in communities worldwide.
                </p>

                <div class="grid grid-cols-2 gap-6">
                    <div class="text-center transition-all duration-700 delay-300"
                        :class="shown ? 'opacity-100 scale-100' : 'opacity-0 scale-50'">
                        <div class="text-3xl font-bold text-bright-green mb-2">2,500+</div>
                        <div class="text-sm text-light-gray dark:text-gray-400">Gardens Created</div>
                    </div>

                    <div class="text-center transition-all duration-700 delay-500"
                        :class="shown ? 'opacity-100 scale-100' : 'opacity-0 scale-50'">
                        <div class="text-3xl font-bold text-bright-green mb-2">15,000+</div>
                        <div class="text-sm text-light-gray dark:text-gray-400">Lives Impacted</div>
                    </div>

                    <div class="text-center transition-all duration-700 delay-700"
                        :class="shown ? 'opacity-100 scale-100' : 'opacity-0 scale-50'">
                        <div class="text-3xl font-bold text-bright-green mb-2">50+</div>
                        <div class="text-sm text-light-gray dark:text-gray-400">Communities</div>
                    </div>

                    <div class="text-center transition-all duration-700 delay-[900ms]"
                        :class="shown ? 'opacity-100 scale-100' : 'opacity-0 scale-50'">
                        <div class="text-3xl font-bold text-bright-green mb-2">95%</div>
                        <div class="text-sm text-light-gray dark:text-gray-400">Success Rate</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
<script>
    const observerOptions = {
        threshold: 0.2
    };

    const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
            if (entry.isIntersecting) {
                // When scrolling down into view
                entry.target.style.opacity = "1";
                entry.target.style.transform = "translateY(0)";
            } else {
                entry.target.style.opacity = "0";
                entry.target.style.transform = "translateY(30px)";
            }
        });
    }, observerOptions);

    observer.observe(document.querySelector('#nature-quote'));
</script>
<script src="{{ asset('js/home-endpoint.js') }}"></script>
