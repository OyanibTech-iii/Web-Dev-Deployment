{% block stylesheets %}
<link rel="stylesheet" href="{{ asset('styles/products.css') }}">
{% endblock %}
<main class="main">
	<section x-data="{ shown: false }" x-intersect.margin.-10%="shown = true" x-intersect:leave="shown = false"
		class="hero relative py-20 min-h-screen flex items-center overflow-hidden bg-cover bg-center bg-no-repeat font-sans"
		style="--bg-url: url('{{ asset('leaf/bgimage.png') }}'); background-image: var(--bg-url);">
		<div class="absolute inset-0 bg-black/20"></div>

		<div class="container max-w-6xl mx-auto px-4 relative z-10">
			<div class="flex flex-col md:flex-row items-center justify-center gap-8 md:gap-12">

				<div class="order-1 flex justify-center md:w-1/2" :class="{ 
          'opacity-0 -translate-x-8': !shown, 
          'transition duration-1000 ease-out opacity-100 translate-x-0': shown 
        }">
					<img src="{{ asset('site/prod.png') }}" alt="Shopping Product"
						class="w-full h-auto max-w-md md:max-w-xl object-contain drop-shadow-2xl">
				</div>

				<div class="text-center md:text-left order-2 max-w-md" :class="{ 
          'opacity-0': !shown, 
          'transition duration-700 delay-300 ease-in opacity-100': shown 
        }">
					<h1 class="text-3xl md:text-4xl lg:text-5xl font-bold leading-tight">
						<span class="text-white">Our </span>
						<span class="text-bright-green">Products</span>
					</h1>
					<p class="text-lg text-light-gray dark:text-gray-300 leading-relaxed mt-4">
						Discover our premium selection of seedlings, growing supplies, and educational resources
						designed to help you cultivate thriving gardens.
					</p>
				</div>

			</div>
		</div>
	</section>

	<div id="nature-quote" class="reveal-on-scroll"
		style="display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; min-height: 200px; opacity: 100; transform: translateY(30px); transition: all 1s ease-out;">

		<p
			style="font-family: 'Noto Sans Tagalog', Arial !important; font-size: 28px !important; color: #16a34a !important; margin: 0 !important; width: 100%;">
			ᜆᜅ᜔ᜃᜒᜎᜒᜃᜒᜈ᜔ ᜀᜅ᜔ ᜐᜇᜒᜎᜒᜅ᜔ ᜀᜆᜒᜈ᜔
		</p>

		<p class="text-sm text-light-gray" style="margin: 5px 0 0 0; width: 100%; letter-spacing: 6px;">
			Tangkilikin Ang Sariling Atin </p>
	</div>
	<section x-data="{ shown: false }" x-intersect.margin.-10%="shown = true" x-intersect:leave="shown = false"
		class="py-20 bg-white dark:bg-gray-900 object-contain ">
		<div class="container max-w-7xl mx-auto px-4">
			<div class="text-center mb-24 reveal-item transition-all duration-700 ease-out"
				:class="shown ? 'opacity-100 translate-y-0 scale-100' : 'opacity-0 -translate-y-10 scale-95'">
				<h1 class="text-2xl sm:text-3xl md:text-4xl lg:text-4xl font-bold leading-tight">
					<span class="text-dark-forest-green dark:!text-gray-200">What We</span>
					<span class="text-bright-green">Offer</span>
				</h1>
				<p class="text-lg text-gray-500 dark:text-gray-400 italic">Everything you need to grow with confidence
				</p>
			</div>

			<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-y-24 gap-x-8">
				<div class="relative bg-orange-50/50 dark:bg-gray-800/80 rounded-[3rem] p-8 pt-20 shadow-sm transition-all duration-700 ease-out hover:-translate-y-2"
					:class="shown ? 'opacity-100 translate-y-0 scale-100' : 'opacity-0 translate-y-20 scale-95'">
					<div
						class="absolute -top-16 left-1/2 -translate-x-1/2 w-48 h-48 rounded-full overflow-hidden border-8 border-white dark:border-gray-700 shadow-xl">
						<img src="{{ asset('seedlings/jackfruit.png') }}" alt="Premium Seedlings"
							class="h-full w-full object-cover">
					</div>
					<div class="text-center mt-16">
						<h3 class="text-xl font-bold text-gray-800 dark:!text-gray-200 mb-2">Premium Seedlings</h3>
						<p class="text-gray-500 dark:text-gray-400 text-sm mb-6 leading-relaxed">
							High-quality fruit tree seedlings including avocado, mango, and citrus varieties.
						</p>
					</div>
				</div>

				<div class="relative bg-orange-50/50 dark:bg-gray-800/80 rounded-[3rem] p-8 pt-20 shadow-sm transition-all duration-700 ease-out delay-200 hover:-translate-y-2"
					:class="shown ? 'opacity-100 translate-y-0 scale-100' : 'opacity-0 translate-y-20 scale-95'">
					<div
						class="absolute -top-16 left-1/2 -translate-x-1/2 w-48 h-48 rounded-full overflow-hidden border-8 border-white dark:border-gray-700 shadow-xl">
						<img src="{{ asset('site/garden2.png') }}" alt="Growing Supplies"
							class="h-full w-full object-cover">
					</div>
					<div class="text-center mt-16">
						<h3 class="text-xl font-bold text-gray-800 dark:!text-gray-200 mb-2">Growing Supplies</h3>
						<p class="text-gray-500 dark:text-gray-400 text-sm mb-6 leading-relaxed">
							Essential tools and supplies for successful gardening and plant care.
						</p>
					</div>
				</div>

				<div class="relative bg-orange-50/50 dark:bg-gray-800/80 rounded-[3rem] p-8 pt-20 shadow-sm transition-all duration-700 ease-out delay-400 hover:-translate-y-2"
					:class="shown ? 'opacity-100 translate-y-0 scale-100' : 'opacity-0 translate-y-20 scale-95'">
					<div
						class="absolute -top-16 left-1/2 -translate-x-1/2 w-48 h-48 rounded-full overflow-hidden border-8 border-white dark:border-gray-700 shadow-xl">
						<img src="{{ asset('learning/learning.png') }}" alt="Educational Resources"
							class="h-full w-full object-cover">
					</div>
					<div class="text-center mt-16">
						<h3 class="text-xl font-bold text-gray-800 dark:!text-gray-200 mb-2">Educational Resources</h3>
						<p class="text-gray-500 dark:text-gray-400 text-sm mb-6 leading-relaxed">
							Comprehensive guides and courses on growing techniques and plant care.
						</p>
					</div>
				</div>
			</div>
		</div>

		<div class="mt-16 md:mt-24 lg:mt-32 relative overflow-hidden rounded-3xl mx-auto max-w-7xl w-full h-[400px] md:h-[500px] lg:h-[600px] flex items-center justify-center group"
			:class="shown ? 'opacity-100' : 'opacity-0'">

			<img src="{{ asset('me/banner 00.png') }}" alt="Our Mart" class="w-full h-full object-cover shadow-2xl" :class="{ 
            'opacity-0 -translate-x-8': !shown, 
            'transition duration-1000 ease-out opacity-100 translate-x-0': shown 
        }">
		</div>
	</section>

	<section x-data="{ shown: false }" x-intersect.margin.-10%.once="shown = true"
		class="py-24 bg-white dark:bg-gray-900 overflow-hidden">
		<div class="container max-w-7xl mx-auto px-4">
			<div class="flex flex-col lg:flex-row items-center gap-12">

				<div class="lg:w-1/2 relative w-full" :class="{
						'opacity-0 -translate-x-10 scale-[0.98]': !shown,
						'opacity-100 translate-x-0 scale-100 transition-all duration-1000 ease-out': shown
					}">
					<div class="relative z-10 rounded-[3rem] overflow-hidden">
						<img src="{{ asset('site/harvest.png') }}" alt="Sustainable Farming"
							class="w-full h-auto transition-transform duration-1000 ease-out"
							:class="shown ? 'scale-100' : 'scale-105'">
					</div>
				</div>

				<div class="lg:w-1/2 w-full" :class="{
						'opacity-0 translate-y-10': !shown,
						'opacity-100 translate-y-0 transition-all duration-1000 ease-out delay-200': shown
					}">
					<h2 class="text-3xl md:text-4xl font-bold mb-6 leading-tight transition-all duration-700"
						:class="shown ? 'opacity-100 translate-y-0 delay-300' : 'opacity-0 translate-y-6'">
						<span class="text-dark-forest-green dark:!text-gray-200">Good for You,</span><br>
						<span class="text-bright-green">Kind to the Earth</span>
					</h2>

					<p class="text-lg text-light-gray dark:text-gray-400 mb-8 leading-relaxed transition-all duration-700"
						:class="shown ? 'opacity-100 translate-y-0 delay-[420ms]' : 'opacity-0 translate-y-6'">
						Choosing fresh, organic produce isn't just a dietary choice it's a commitment to a better
						future. By growing and consuming locally, we reduce our footprint and nourish our bodies as
						nature intended.
					</p>

					<div class="grid grid-cols-1 sm:grid-cols-2 gap-8">
						<div class="space-y-3 transition-all duration-700 ease-out"
							:class="shown ? 'opacity-100 translate-y-0 delay-500' : 'opacity-0 translate-y-8'">
							<h4 class="text-xl font-bold text-dark-forest-green dark:!text-gray-200">Pure Nutrition</h4>
							<p class="text-sm text-gray-500 dark:text-gray-400">Organic farming keeps harmful pesticides
								off your plate,
								ensuring every bite is packed with maximum vitamins and natural flavor.</p>
						</div>

						<div class="space-y-3 transition-all duration-700 ease-out"
							:class="shown ? 'opacity-100 translate-y-0 delay-[580ms]' : 'opacity-0 translate-y-8'">
							<h4 class="text-xl font-bold text-dark-forest-green dark:!text-gray-200">Earth Stewardship
							</h4>
							<p class="text-sm text-gray-500 dark:text-gray-400">Sustainable gardening restores soil
								health, promotes
								biodiversity, and reduces the carbon emissions of long-distance transport.</p>
						</div>
					</div>
				</div>

			</div>
		</div>
	</section>

	<section class="py-20 bg-gradient-to-br from-green-50 to-gray-50 dark:from-gray-900 dark:to-gray-950 antialiased"
		x-data="{ 
            activeFilter: 'all',
            filterProducts(type) {
                this.activeFilter = type;
            }
         }">
		<div class="container max-w-7xl mx-auto px-4">

			<div class="text-center mb-12">
				<h2 class="text-3xl md:text-4xl font-bold mb-4">
					<span class="text-dark-forest-green dark:!text-gray-200">Our </span>
					<span class="text-bright-green">Live Inventory</span>
				</h2>
				<p class="text-light-gray">Discover our premium range of seedlings available now.</p>
			</div>

			<div class="flex flex-wrap justify-center gap-3 mb-12">
				<button @click="filterProducts('all')"
					:class="activeFilter === 'all' ? 'bg-dark-forest-green text-white shadow-lg' : 'bg-white dark:bg-gray-800 text-dark-forest-green dark:!text-gray-200 border-gray-200 dark:border-gray-600'"
					class="px-6 py-2 rounded-full text-sm font-semibold border transition-all duration-300 hover:shadow-md active:scale-95">
					All Products
				</button>

				{% for type in stock_types %}
				<button @click="filterProducts('{{ type }}')"
					:class="activeFilter === '{{ type }}' ? 'bg-bright-green text-white shadow-lg' : 'bg-white dark:bg-gray-800 text-dark-forest-green dark:!text-gray-200 border-gray-200 dark:border-gray-600'"
					class="px-6 py-2 rounded-full text-sm font-semibold border transition-all duration-300 hover:shadow-md active:scale-95">
					{{ type }}
				</button>
				{% endfor %}
			</div>
			<div
				class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-5 gap-6 min-h-[400px] w-full items-stretch">

				{% for product in products %}
				{# Pre-calculate types for Alpine filtering #}
				{% set productTypes = [] %}
				{% for stock in product.stocks %}
				{% set productTypes = productTypes|merge([stock.stockType]) %}
				{% endfor %}
				{% set typesString = productTypes|join("','") %}

				<div x-show="activeFilter === 'all' || ['{{ typesString }}'].includes(activeFilter)"
					x-transition:enter="transition ease-out duration-400"
					x-transition:enter-start="opacity-0 translate-y-8 scale-95"
					x-transition:enter-end="opacity-100 translate-y-0 scale-100"
					x-transition:leave="transition ease-in duration-300"
					x-transition:leave-start="opacity-100 scale-100" x-transition:leave-end="opacity-0 scale-90"
					class="flex flex-col bg-[#faf1de] dark:bg-gray-800 rounded-2xl shadow-sm hover:shadow-2xl transition-all duration-500 overflow-hidden border border-gray-100 dark:border-gray-700 group h-full">
					<div class="relative h-48 w-full overflow-hidden bg-gray-100">
						<img src="{{ asset(product.getImagePath() ?: 'images/placeholder.png') }}"
							alt="{{ product.name }}"
							class="h-full w-full object-cover group-hover:scale-110 transition-transform duration-700 ease-in-out">

						<div class="absolute top-3 right-3">
							<span
								class="px-2 py-0.5 rounded-full text-[9px] font-bold uppercase tracking-wider shadow-sm 
                        {{ product.getStockStatus() == 'In stock' ? 'bg-green-100 text-green-700' : 
                           product.getStockStatus() == 'Low stock' ? 'bg-orange-100 text-orange-700' : 'bg-red-100 text-red-700' }}">
								{{ product.getStockStatus() }}
							</span>
						</div>
					</div>

					<div class="p-5 flex flex-col flex-grow">
						<div class="mb-2">
							<h3 class="text-base font-bold text-dark-forest-green truncate dark:!text-gray-200 group-hover:text-bright-green transition-colors duration-300"
								title="{{ product.name }}">
								{{ product.name }}
							</h3>

							<div class="flex items-center justify-between mt-1">
								<span class="text-bright-green font-bold text-sm">₱{{ product.price }}</span>
								<div class="flex items-center gap-1">
									{% set avgRating = product.getAverageRating() %}

									<div class="flex text-orange-400 items-center">
										{% for i in 1..5 %}
										{% if i <= avgRating|round(0, 'floor' ) %} <ion-icon name="star"
											class="text-sm"></ion-icon>
											{% else %}
											<ion-icon name="star-outline"
												class="text-sm text-gray-700 dark:text-gray-400 "></ion-icon>
											{% endif %}
											{% endfor %}
									</div>

									<span class="text-[10px] font-medium text-gray-500 dark:text-gray-400">
										({{ avgRating > 0 ? avgRating|number_format(1) : '0.0' }})
									</span>
								</div>
							</div>
						</div>

						<p class="text-light-gray text-xs line-clamp-2 mb-4 h-8 dark:!text-gray-300">
							{{ product.description }}
						</p>

						<div
							class="flex items-center justify-between pt-3 border-t border-gray-50 dark:border-gray-700 mt-auto">
							<div
								class="inline-flex items-center gap-1.5 px-3 py-2 bg-light-green/20 dark:bg-gray-8
								00 transition-colors duration-300 group-hover:bg-light-green/30">
								<span class="text-xs font-semibold text-dark-forest-green dark:!text-gray-200">
									Stock: {{ product.getCurrentStockQuantity() }}
								</span>
							</div>

							{% if product.getCurrentStockQuantity() > 0 %}
							<a href="{{ path('app_login') }}"
								class="w-10 h-10 rounded-full flex items-center justify-center bg-[#4a3728] text-white dark:bg-gray-900 dark:!text-gray-200 hover:bg-bright-green hover:text-white transition-all duration-300 transform group-hover:scale-110 shadow-md">
								<ion-icon name="arrow-forward-outline" class="text-lg font-bold"></ion-icon>

							</a>
							{% endif %}
						</div>
					</div>
				</div>
				{% endfor %}
			</div>
	</section>

</main>
<script>
	function initScrollAnimations() {
		const observerOptions = {
			threshold: 0.1,
			rootMargin: '0px 0px -50px 0px'
		};

		const observer = new IntersectionObserver((entries) => {
			entries.forEach(entry => {
				if (entry.isIntersecting) {
					entry.target.classList.add('animate-fade-in');
				}
			});
		}, observerOptions);

		document.querySelectorAll('section, .hero-content').forEach(el => {
			observer.observe(el);
		});
	}
	document.addEventListener('DOMContentLoaded', initScrollAnimations);
</script>
{% include 'footer/index.html.twig' %}