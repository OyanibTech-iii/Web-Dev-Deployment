<div id="ficobot-clear-modal" class="fixed inset-0 z-[10050] hidden" style="display: none;" aria-hidden="true">
	<div id="ficobot-clear-backdrop" class="absolute inset-0 bg-black/40 backdrop-blur-md"></div>
	<div class="absolute inset-0 flex items-center justify-center p-4 sm:p-6 pointer-events-none">
		<div
			class="bg-white dark:bg-gray-800 rounded-2xl shadow-2xl p-6 sm:p-8 max-w-md w-full mx-auto transform transition-all relative z-10 border border-gray-100 dark:border-gray-700 pointer-events-auto"
			role="dialog"
			aria-modal="true"
			aria-labelledby="ficobot-clear-modal-title">
			<div class="flex items-center gap-4 mb-4">
				<div class="w-12 h-12 rounded-full bg-red-100 dark:bg-red-950/50 flex items-center justify-center shrink-0">
					<ion-icon name="alert-circle-outline" class="text-2xl text-red-600 dark:text-red-400"></ion-icon>
				</div>
				<div class="min-w-0">
					<h3 id="ficobot-clear-modal-title" class="text-lg font-semibold text-dark-forest-green dark:!text-gray-100">Clear conversation?</h3>
					<p class="text-xs text-light-gray dark:!text-gray-400">Remove all messages with ficoBot</p>
				</div>
			</div>
			<p class="text-sm text-light-gray dark:!text-gray-400 mb-6">
				This clears the chat in this browser session. You can start a new conversation anytime.
			</p>
			<div class="flex flex-col-reverse sm:flex-row gap-3">
				<button id="ficobot-clear-cancel-btn" type="button"
					class="flex-1 px-4 py-2.5 rounded-lg bg-gray-100 dark:bg-gray-700 hover:bg-gray-200 dark:hover:bg-gray-600 text-dark-forest-green dark:!text-gray-100 font-medium transition-colors duration-200">
					Cancel
				</button>
				<button id="ficobot-clear-confirm-btn" type="button"
					class="flex-1 px-4 py-2.5 rounded-lg bg-red-600 hover:bg-red-700 text-white font-medium transition-colors duration-200">
					Clear chat
				</button>
			</div>
		</div>
	</div>
</div>
