{% extends 'base.html.twig' %}

{% block title %}Growfico | Cultivates Green Future{% endblock %}
{% block stylesheets %}
<link rel="stylesheet" href="{{ asset('styles/indexfile.css') }}">
{% endblock %}
{% block body %}
{{ encore_entry_link_tags('app') }}

<nav x-data="{ mobileMenuOpen: false, isDark: document.documentElement.classList.contains('dark') }"
	@dark-mode-changed.window="isDark = $event.detail.dark"
	class="sticky top-0 z-50 w-full px-4 py-2 bg-white/95 dark:bg-gray-900/95 backdrop-blur-sm">
	<div
		class="flex items-center justify-between lg:justify-center gap-4 lg:gap-16 bg-white dark:bg-gray-800 p-4 shadow-[0_4px_16px_rgba(3,166,74,0.07),0_2px_8px_rgba(0,0,0,0.03)] dark:shadow-[0_4px_20px_rgba(0,0,0,0.35)] w-full border border-transparent dark:border-gray-700/80 rounded-2xl lg:rounded-none lg:border-0">

		<div class="flex-row">
			<a href="#" class="nav-link" data-section="home">
				<img :src="isDark ? '{{ asset('logos/light.png') }}' : '{{ asset('logos/transparent.png') }}'"
					alt="Growfico" class="h-6 w-auto lg:mr-12" />
			</a>
		</div>

		<div class="flex items-center gap-1 lg:hidden">
			<button type="button"
				class="js-theme-toggle w-10 h-10 flex items-center justify-center rounded-full text-gray-500 dark:text-gray-400 hover:text-gray-900 dark:hover:text-gray-100 hover:bg-gray-100 dark:hover:bg-gray-700 transition-colors duration-200"
				title="Toggle theme" aria-label="Toggle theme">
				{% include 'landinpage/_theme_toggle_icon.html.twig' with {id: 'mobile'} %}
			</button>
			<button type="button" @click="mobileMenuOpen = !mobileMenuOpen"
				class="text-3xl text-dark-forest-green dark:!text-gray-200 flex items-center justify-center w-10 h-10 rounded-full hover:bg-gray-100 dark:hover:bg-gray-700 transition-colors">
				<ion-icon :name="mobileMenuOpen ? 'close-outline' : 'menu-outline'"></ion-icon>
			</button>
		</div>

		<ul :class="mobileMenuOpen ? 'flex' : 'hidden'"
			class="lg:flex flex-col lg:flex-row absolute lg:relative top-full left-0 w-full lg:w-auto bg-white dark:bg-gray-800 lg:dark:bg-transparent items-center gap-4 lg:gap-8 list-none p-6 lg:p-0 shadow-xl lg:shadow-none border-t border-gray-100 dark:border-gray-700 lg:border-0 transition-all duration-300 z-50 rounded-b-2xl lg:rounded-none">

			<li class="nav-link group relative py-2 px-4" data-section="home">
				<a href="#"
					class="flex items-center gap-2 no-underline text-dark-forest-green dark:!text-gray-200 font-medium text-sm">
					<ion-icon name="home-outline" class="lg:hidden"></ion-icon> Home
					<span
						class="absolute bottom-0 left-1/2 -translate-x-1/2 w-0 group-hover:w-full h-[2px] bg-bright-green transition-all duration-300"></span>
				</a>
			</li>

			<li class="nav-link group relative py-2 px-4" data-section="about">
				<a href="#"
					class="flex items-center gap-2 no-underline text-dark-forest-green dark:!text-gray-200 font-medium text-sm">
					<ion-icon name="people-outline" class="lg:hidden"></ion-icon> About Us
					<span
						class="absolute bottom-0 left-1/2 -translate-x-1/2 w-0 group-hover:w-full h-[2px] bg-bright-green transition-all duration-300"></span>
				</a>
			</li>

			<li class="nav-link group relative py-2 px-4" data-section="contacts">
				<a href="#"
					class="flex items-center gap-2 no-underline text-dark-forest-green dark:!text-gray-200 font-medium text-sm">
					<ion-icon name="call-outline" class="lg:hidden"></ion-icon> Contacts
					<span
						class="absolute bottom-0 left-1/2 -translate-x-1/2 w-0 group-hover:w-full h-[2px] bg-bright-green transition-all duration-300"></span>
				</a>
			</li>

			<li class="nav-link group relative py-2 px-4" data-section="products">
				<a href="#"
					class="flex items-center gap-2 no-underline text-dark-forest-green dark:!text-gray-200 font-medium text-sm">
					<ion-icon name="leaf-outline" class="lg:hidden"></ion-icon> Products
					<span
						class="absolute bottom-0 left-1/2 -translate-x-1/2 w-0 group-hover:w-full h-[2px] bg-bright-green transition-all duration-300"></span>
				</a>
			</li>

			<li class="nav-link group relative py-2 px-4" data-section="services">
				<a href="#"
					class="flex items-center gap-2 no-underline text-dark-forest-green dark:!text-gray-200 font-medium text-sm">
					<ion-icon name="construct-outline" class="lg:hidden"></ion-icon> Services
					<span
						class="absolute bottom-0 left-1/2 -translate-x-1/2 w-0 group-hover:w-full h-[2px] bg-bright-green transition-all duration-300"></span>
				</a>
			</li>

			<li class="hidden lg:flex items-center justify-center py-2">
				<button type="button"
					class="js-theme-toggle w-10 h-10 flex items-center justify-center rounded-full text-gray-500 dark:text-gray-400 hover:text-gray-900 dark:hover:text-gray-100 hover:bg-gray-100 dark:hover:bg-gray-700 transition-colors duration-200"
					title="Toggle theme" aria-label="Toggle theme">
					{% include 'landinpage/_theme_toggle_icon.html.twig' with {id: 'desktop'} %}
				</button>
			</li>

			<li
				class="flex flex-col lg:flex-row gap-3 mt-4 lg:mt-0 lg:ml-2 w-full lg:w-auto items-stretch lg:items-center">
				<a href="{{ path('app_login') }}"
					class="w-full lg:w-auto rounded-2xl text-sm text-center text-dark-forest-green dark:!text-gray-200 border-2 border-light-green dark:border-gray-600 py-2 px-6 font-medium transition-all duration-300 hover:bg-dark-forest-green hover:!text-white dark:hover:bg-bright-green dark:hover:border-bright-green">
					LOGIN
				</a>
				<a href="{{ path('app_register') }}"
					class="w-full lg:w-auto bg-[#7A5335] text-gray-200 dark:!text-gray-200 text-sm text-center rounded-2xl py-2 px-6 font-medium transition-all duration-300 hover:!bg-[#faf1de] hover:text-dark-forest-green dark:hover:!bg-[#faf1de] dark:hover:!text-dark-forest-green">
					REGISTER
				</a>
			</li> 
		</ul>
	</div>
</nav>

<!-- Main Content Container -->
<main id="main-content"
	class="min-h-screen bg-gray-50 dark:bg-gray-900 text-gray-900 dark:text-gray-100 transition-colors duration-200">
	<div id="home-content" class="content-section active">
		{% include 'landinpage/home.html.twig' %}
	</div>
	<div id="about-content" class="content-section">
		{% include 'landinpage/about.html.twig' %}
	</div>
	<div id="contacts-content" class="content-section">
		{% include 'landinpage/contacts.html.twig' %}
	</div>
	<div id="products-content" class="content-section">
		{% include 'landinpage/products.html.twig' %}
	</div>
	<div id="services-content" class="content-section">
		{% include 'landinpage/services.html.twig' %}
		{% include 'footer/index.html.twig' %}
	</div>
	<div id="ficobot-launcher"
		class="fixed bottom-3 right-3 sm:bottom-4 sm:right-4 md:bottom-6 md:right-6 z-[60] w-14 min-w-[3.5rem] sm:w-20 md:w-28 lg:w-36 xl:w-40 max-w-[min(40vw,10rem)] drop-shadow-lg transition-transform duration-300 hover:scale-110">
		<img src="{{ asset('logos/ficoBot.png') }}" alt="FicoBot" class="w-full h-auto object-contain cursor-pointer"
			onclick="toggleChat()">
	</div>

</main>

<div id="chat-modal"
	class="hidden fixed bg-white dark:bg-gray-800 rounded-2xl shadow-2xl flex-col z-[10000] overflow-hidden border border-gray-100 dark:border-gray-700 animate-in fade-in slide-in-from-bottom-5 duration-300"
	style="isolation: isolate; box-sizing: border-box;">

	<div id="chat-header"
		class="shrink-0 p-2 border-b border-gray-100 dark:border-gray-700 flex justify-between items-center bg-white dark:bg-gray-800 cursor-grab active:cursor-grabbing select-none shadow-sm z-[10001]">

		<div class="flex items-center gap-3 overflow-hidden">
			<div class="relative shrink-0">
				<img src="{{ asset('logos/fico.png') }}" alt="Logo" class="w-8 h-8 rounded-full object-cover border-4 border-gray-100 dark:border-gray-700">
				<div
					class="absolute bottom-0 right-0 w-3 h-3 bg-bright-green border-2 border-white dark:border-gray-800 rounded-full">
				</div>
			</div>
			<div class="min-w-0">
				<h3 class="font-semibold text-dark-forest-green text-sm leading-tight truncate dark:!text-gray-200">
					FicoBot</h3>
				<p class="text-xs text-bright-green">Active Now</p>
			</div>
		</div>

		<div class="relative shrink-0" x-data="{ menuOpen: false }">
			<button @click="menuOpen = !menuOpen" @click.outside="menuOpen = false"
				class="w-8 h-8 flex items-center justify-center rounded-full border border-gray-200 dark:border-gray-700 text-gray-500 hover:text-gray-900 hover:bg-gray-100 dark:text-gray-400 dark:hover:text-white dark:hover:bg-gray-700 transition-colors duration-200">
				<ion-icon name="ellipsis-vertical" class="text-sm"></ion-icon>
			</button>

			<div x-show="menuOpen" x-transition:enter="transition ease-out duration-100"
				x-transition:enter-start="opacity-0 scale-95" 
				x-transition:enter-end="opacity-100 scale-100"
				x-transition:leave="transition ease-in duration-75"
				x-transition:leave-start="opacity-100 scale-100" 
				x-transition:leave-end="opacity-0 scale-95"
				class="absolute right-0 mt-2 w-48 bg-white dark:bg-gray-800 border border-gray-100 dark:border-gray-700 rounded-xl shadow-xl z-[10002] py-2"
				style="display: none;">

				<button type="button" data-ficobot-clear-open @click="menuOpen = false"
					class="flex items-center w-full px-4 py-2 text-xs text-gray-600 dark:text-gray-400 hover:bg-gray-50 dark:hover:bg-gray-700 hover:text-gray-900 dark:hover:text-white transition-colors">
					<ion-icon name="trash-outline" class="mr-3 text-sm"></ion-icon>
					Clear Chat
				</button>

				<hr class="my-1 border-gray-100 dark:border-gray-700">

				<button type="button" onclick="toggleChat()" @click="menuOpen = false"
					class="flex items-center w-full px-4 py-2 text-xs text-gray-600 dark:text-gray-400 hover:bg-gray-50 dark:hover:bg-gray-700 hover:text-gray-900 dark:hover:text-white transition-colors">
					<ion-icon name="log-out-outline" class="mr-3 text-sm"></ion-icon>
					Exit Chat
				</button>
			</div>
		</div>
	</div>

	<div id="chat-box"
		class="flex-1 overflow-y-auto p-4 flex flex-col gap-3 bg-white dark:bg-gray-900 w-full custom-scrollbar"
		style="min-height: 0;">
		<div class="text-center my-4" id="start-label">
			<span class="text-xs text-gray-400 dark:text-gray-500 uppercase tracking-widest">Start Conversation</span>
		</div>
	</div>
	<div id="chat-suggestions" class="flex flex-col gap-2 mb-4 items-center dark:bg-gray-900">
		<button onclick="sendSuggestion('What is Growfico?')"
			class="w-full max-w-xs text-xs bg-gray-100 dark:bg-gray-800 hover:bg-bright-green hover:!text-white text-dark-forest-green dark:!text-gray-200 py-2 px-3 rounded-full border border-gray-200 dark:border-gray-600 transition-all duration-200">
			What is Growfico?
		</button>
		<button onclick="sendSuggestion('What are your services?')"
			class="w-full max-w-xs text-xs bg-gray-100 dark:bg-gray-800 hover:bg-bright-green hover:!text-white text-dark-forest-green dark:!text-gray-200 py-2 px-3 rounded-full border border-gray-200 dark:border-gray-600 transition-all duration-200">
			Our Services
		</button>
		<button onclick="sendSuggestion('How to register?')"
			class="w-full max-w-xs text-xs bg-gray-100 dark:bg-gray-800 hover:bg-bright-green hover:!text-white text-dark-forest-green dark:!text-gray-200 py-2 px-3 rounded-full border border-gray-200 dark:border-gray-600 transition-all duration-200">
			How to register?
		</button>
	</div>

	<div class="p-4 bg-white dark:bg-gray-900 border-t border-gray-100 dark:border-gray-700 shrink-0">
		<div class="flex items-center gap-2 bg-[#F0F2F5] dark:bg-gray-800 rounded-full px-4 py-2 w-full">
			<input type="text" id="chat-input" placeholder="Type a message..."
				class="flex-1 text-xs min-w-0 bg-transparent border-0 outline-none focus:ring-0 focus:outline-none focus:border-0 py-1 text-gray-900 dark:!text-gray-200 placeholder:text-gray-500 dark:placeholder:text-gray-400"
				autocomplete="off">

			<button onclick="sendMessage()"
				class="text-bright-green flex items-center hover:scale-110 transition-transform shrink-0">
				<ion-icon name="send" class="text-xl"></ion-icon>
			</button>
		</div>
	</div>
</div>

{% include 'landinpage/clear_modal.html.twig' %}

<script>
    window.initialPage = "{{ page|default('home')|e('js') }}";
</script>
<script src="{{ asset('js/entrypoint-index.js') }}"></script>
<script defer src="https://cdn.jsdelivr.net/npm/@alpinejs/intersect@3.x.x/dist/cdn.min.js"></script>
<script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>
<script src="{{ asset('js/indexfile.js') }}"></script>
<script src="{{ asset('js/ficobot-clear-modal.js') }}"></script>

{% endblock %}