{% extends 'admin/base_admin.html.twig' %}

{% block title %}Edit Lesson | Growfico{% endblock %}

{% block header_title %}
<h2 class="text-lg font-semibold text-dark-forest-green">Edit Lesson</h2>
<p class="text-xs text-light-gray">{{ lesson.title }}</p>
{% endblock %}

{% block admin_content %}
<div class="max-w-7xl mx-auto">
    <div class="bg-white rounded-2xl border border-gray-200 shadow-sm">
        <div class="p-6">
            {{ include('admin/lesson_form.html.twig', { form: form, button_label: 'Update Lesson', lesson: lesson }) }}
        </div>
    </div>
</div>
{% endblock %}
