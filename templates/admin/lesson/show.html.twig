{% extends 'admin/base_admin.html.twig' %}

{% block title %}Lesson | Growfico{% endblock %}

{% block header_title %}
<h2 class="text-xl font-semibold text-dark-forest-green">Lesson</h2>
<p class="text-xs text-light-gray">View lesson details</p>
{% endblock %}

{% block admin_content %}
<div class="max-w-7xl mx-auto">
    <div class="bg-white rounded-2xl border border-gray-200 shadow-sm p-6 space-y-6">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div>
                <p class="text-xs text-light-gray">Title</p>
                <p class="text-sm font-medium text-dark-forest-green">{{ lesson.title }}</p>
            </div>
            <div>
                <p class="text-xs text-light-gray">Course</p>
                <p class="text-sm font-medium text-dark-forest-green">
                    {{ lesson.course ? lesson.course.courseName : 'N/A' }}
                </p>
            </div>
        </div>

        <div class="space-y-4">
            <p class="text-xs text-light-gray mb-2">Content</p>
            {% if lesson.contentFile %}
                <div class="rounded-xl border border-gray-200 overflow-hidden bg-gray-50 dark:bg-gray-900/40 dark:border-gray-700">
                    <p class="text-xs px-3 py-2 border-b border-gray-100 bg-white/80 dark:border-gray-700 dark:bg-gray-900">
                        PDF: <a href="{{ asset('uploads/lessons/' ~ lesson.contentFile) }}" target="_blank" rel="noopener"
                            class="text-bright-green font-medium hover:underline">{{ lesson.contentFile }}</a>
                    </p>
                    <iframe title="Lesson PDF"
                        src="{{ asset('uploads/lessons/' ~ lesson.contentFile) }}"
                        class="w-full min-h-[520px] border border-gray-200 bg-white dark:border-gray-700 dark:bg-gray-700"></iframe>
                </div>
            {% endif %}
            {% if lesson.content %}
                <div class="text-sm text-dark-forest-green whitespace-pre-wrap rounded-xl border border-gray-100 bg-gray-50/80 dark:bg-gray-800/40 p-4 max-h-[480px] overflow-y-auto">
                    {{ lesson.content }}
                </div>
            {% elseif not lesson.contentFile %}
                <p class="text-xs text-light-gray">No content yet.</p>
            {% endif %}
        </div>

        <div class="flex flex-col sm:flex-row gap-3 justify-end pt-4 border-t border-gray-100">
            <a href="{{ path('app_admin_courses') }}#lessons-overview"
               class="inline-flex items-center justify-center px-5 py-2.5 bg-gray-100 text-dark-forest-green text-xs font-medium rounded-lg hover:bg-gray-200 transition-colors duration-200 dark:bg-gray-700 dark:!text-gray-200 dark:hover:bg-gray-400">
                Back to overview
            </a>
            <a href="{{ path('app_admin_lesson_edit', {'id': lesson.id}) }}"
               class="inline-flex items-center justify-center px-5 py-2.5 bg-bright-green text-white text-xs font-medium rounded-lg hover:bg-green-600 transition-colors duration-200">
                Edit
            </a>
            <form method="post" action="{{ path('app_admin_lesson_delete', {'id': lesson.id}) }}"
                  onsubmit="return confirm('Are you sure you want to delete this lesson?');"
                  class="inline">
                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ lesson.id) }}">
                <button type="submit"
                        class="inline-flex items-center justify-center px-5 py-2.5 bg-red-600 text-white text-xs font-medium rounded-lg hover:bg-red-700 transition-colors duration-200 w-full sm:w-auto">
                    Delete
                </button>
            </form>
        </div>
    </div>
</div>
{% endblock %}
