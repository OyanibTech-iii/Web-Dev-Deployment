{% extends 'admin/base_admin.html.twig' %}

{% block title %}Course | Growfico{% endblock %}

{% block header_title %}
<h2 class="text-xl font-semibold text-dark-forest-green">Course Details</h2>
<p class="text-xs text-light-gray">View course information</p>
{% endblock %}

{% block admin_content %}
<div class="max-w-7xl mx-auto space-y-4">
    <div class="h-full object-contain bg-gray-50 flex items-center justify-center overflow-hidden roundsed-2xl">
        {% if course.thumbnail %}
        <img src="{{ asset(course.getThumbnailPath()) }}" alt="{{ course.courseName }}"
            class="w-full h-full object-cover border border-gray-200 rounded-2xl">
        {% else %}
        <div class="text-gray-500 justify-center items-center flex flex-col gap-2">
            <ion-icon name="image-outline"></ion-icon><br>
            <p>No Thumbnail Uploaded yet.</p>
        </div>

        {% endif %}
    </div>

    <div class="bg-white rounded-2xl border border-gray-200 shadow-sm overflow-hidden">
        <div class="px-6 py-5 border-b border-gray-200">
            <div class="flex flex-wrap items-center justify-between gap-3">
                <div class="min-w-0">
                    <h3 class="text-sm font-semibold text-dark-forest-green truncate">{{ course.courseName }}</h3>
                    <p class="text-xs text-light-gray">Tier: {{ course.tier }} <br>Price: {{ course.price }}</p>
                </div>
            </div>
        </div>

        <div class="p-6">
            <h4 class="text-sm font-semibold text-dark-forest-green mb-2">Description</h4>
            <p class="text-xs text-light-gray whitespace-pre-line">{{ course.description }}</p>
        </div>
    </div>
</div>

<script src="{{ asset('js/courses-admin.js') }}"></script>
{% endblock %}