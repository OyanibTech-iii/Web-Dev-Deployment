<div id="user-modal" class="fixed inset-0 z-50 hidden backdrop-blur-md ">
    <div class="flex items-center justify-center min-h-screen p-4">
        <div id="user-modal-content" class="bg-white rounded-2xl shadow-xl max-w-3xl w-full overflow-hidden">
            <div class="px-6 py-4 bg-bright-green text-white">
                <div class="flex items-center justify-between">
                    <h3 id="modal-title" class="text-sm font-semibold">Add User</h3>
                    <button type="button" id="close-modal"
                        class="text-white/80 hover:text-white transition-colors duration-200" aria-label="Close">
                        <ion-icon name="close-outline" class="w-6 h-6"></ion-icon>
                    </button>
                </div>
            </div>

            <form id="user-form" class="p-6">
                <input type="hidden" id="user-id" name="id">
                <input type="hidden" id="csrf-token" name="_token" value="{{ csrf_token('admin_users') }}">

                <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                    <div>
                        <label for="first-name" class="block text-xs font-medium text-gray-700 mb-2">First Name</label>
                        <input type="text" id="first-name" name="firstName" required
                            class="w-full px-3 text-xs py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-bright-green focus:border-transparent">
                    </div>
                    <div>
                        <label for="last-name" class="block text-xs font-medium text-gray-700 mb-2">Last Name</label>
                        <input type="text" id="last-name" name="lastName" required
                            class="w-full text-xs px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-bright-green focus:border-transparent">
                    </div>
                    <div>
                        <label for="email" class="block text-xs font-medium text-gray-700 mb-2">Email</label>
                        <input type="email" id="email" name="email" required
                            class="w-full text-xs px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-bright-green focus:border-transparent">
                    </div>
                    <div>
                        <label for="phone" class="block text-xs font-medium text-gray-700 mb-2">Phone</label>
                        <input type="tel" id="phone" name="phone"
                            class="w-full text-xs px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-bright-green focus:border-transparent">
                    </div>
                    <div id="password-field">
                        <label for="password" class="block text-xs font-medium text-gray-700 mb-2">Password</label>
                        <input type="password" id="password" name="password"
                            class="w-full text-xs px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-bright-green focus:border-transparent">
                    </div>
                    <div>
                        <label for="role" class="block text-xs font-medium text-gray-700 mb-2">Role</label>
                        <select id="role" name="role" required
                            class="w-full text-xs px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-bright-green focus:border-transparent dark:bg-gray-700 ">
                            <option value="ROLE_USER">User</option>
                            <option value="ROLE_STAFF">Staff</option>
                            <option value="ROLE_ADMIN">Admin</option>
                        </select>
                    </div>
                    <div class="md:col-span-3">
                        <label class="flex items-center">
                            <input type="checkbox" id="is-active" name="isActive" checked
                                class="rounded border-gray-300 text-bright-green focus:ring-bright-green">
                            <span class="ml-2 text-xs text-gray-700">Active User</span>
                        </label>
                    </div>
                </div>

                <div class="flex items-center justify-end gap-3 mt-6 pt-4 border-t border-gray-200">
                    <button type="button" id="cancel-btn"
                        class="px-4 py-2 text-xs font-medium text-gray-700 bg-gray-100 rounded-lg hover:bg-gray-200 transition-colors duration-200 dark:!text-gray-800">
                        Cancel
                    </button>
                    <button type="submit" id="save-btn"
                        class="px-4 py-2 text-xs font-medium text-white bg-bright-green rounded-lg hover:bg-green-600 transition-colors duration-200">
                        Save User
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>