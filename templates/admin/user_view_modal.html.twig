<div id="user-view-modal" class="fixed inset-0 z-50 hidden">
    <div class="absolute inset-0 bg-black/60 backdrop-blur-sm"></div>
    <div class="relative z-10 flex items-center justify-center min-h-screen p-4">
        <div class="bg-white rounded-3xl shadow-2xl max-w-2xl w-full overflow-hidden transform transition-all">

            <div class="relative h-32 bg-bright-green">
                <button type="button" id="user-view-close"
                    class="absolute top-4 right-4 text-white/80 hover:text-white transition-colors" aria-label="Close">
                    <ion-icon name="close-outline" class="w-6 h-6"></ion-icon>
                </button>
            </div>

            <div class="px-8 pb-6">
                <!-- Header Section -->
                <div class="relative flex justify-between items-end -mt-12 mb-6">
                    <div class="p-1 bg-white rounded-full">
                        <div
                            class="uv-avatar-container w-24 h-24 rounded-full border-4 border-white shadow-md overflow-hidden bg-gray-100 flex items-center justify-center">
                            <img class="uv-image w-full h-full object-cover hidden" src="" alt="Profile">
                            <span class="uv-initials text-3xl font-bold text-bright-green"></span>
                        </div>
                    </div>
                    <div class="pb-2">
                        <span
                            class="uv-status-badge px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider"></span>
                    </div>
                </div>

                <!-- Title Section -->
                <div class="mb-6">
                    <h3 class="uv-name text-2xl font-bold text-dark-forest-green" data-field="name"></h3>
                    <p class="uv-role-title text-sm font-medium text-bright-green flex items-center gap-1">
                        <ion-icon name="shield-outline"></ion-icon>
                        <span class="uv-role" data-field="role"></span>
                    </p>
                </div>

                <div id="uv-info-sections" class="grid grid-cols-1 md:grid-cols-2 gap-6"></div>
            </div>
        </div>
    </div>
</div>