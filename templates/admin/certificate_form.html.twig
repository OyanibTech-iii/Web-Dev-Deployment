{{ form_start(form, {'attr': {'class': 'w-full space-y-6'}}) }}
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div class="space-y-2 md:col-span-2">
            {{ form_label(form.certificateCode, 'Certificate Code', {'label_attr': {'class': 'block text-xs font-semibold text-dark-forest-green'}}) }}
            {{ form_widget(form.certificateCode, {'attr': {'class': 'w-full px-4 py-3 border border-gray-300 rounded-lg text-xs focus:ring-2 focus:ring-bright-green focus:border-transparent transition-colors duration-200 text-dark-forest-green'}}) }}
            {{ form_errors(form.certificateCode) }}
        </div>

        <div class="space-y-2">
            {{ form_label(form.issuedAt, 'Issued At', {'label_attr': {'class': 'block text-xs font-semibold text-dark-forest-green'}}) }}
            {{ form_widget(form.issuedAt, {'attr': {'class': 'w-full px-4 py-3 border border-gray-300 rounded-lg text-xs focus:ring-2 focus:ring-bright-green focus:border-transparent transition-colors duration-200 text-dark-forest-green [color-scheme:dark]'}}) }}
            {{ form_errors(form.issuedAt) }}
        </div>

        <div class="space-y-2">
            {{ form_label(form.user, 'Assign to User', {'label_attr': {'class': 'block text-xs font-semibold text-dark-forest-green'}}) }}
            {{ form_widget(form.user, {'attr': {'class': 'w-full px-4 py-3 border border-gray-300 rounded-lg text-xs focus:ring-2 focus:ring-bright-green focus:border-transparent transition-colors duration-200 text-dark-forest-green bg-white'}}) }}
            {{ form_errors(form.user) }}
        </div>

        <div class="space-y-2">
            {{ form_label(form.course, 'Course', {'label_attr': {'class': 'block text-xs font-semibold text-dark-forest-green'}}) }}
            {{ form_widget(form.course, {'attr': {'class': 'w-full px-4 py-3 border border-gray-300 text-xs rounded-lg focus:ring-2 focus:ring-bright-green focus:border-transparent transition-colors duration-200 text-dark-forest-green bg-white'}}) }}
            {{ form_errors(form.course) }}
        </div>

        <div class="space-y-2">
            {{ form_label(form.quizAttempt, 'Quiz Attempt Reference', {'label_attr': {'class': 'block text-xs font-semibold text-dark-forest-green'}}) }}
            {{ form_widget(form.quizAttempt, {'attr': {'class': 'w-full px-4 py-3 border text-xs border-gray-300 rounded-lg focus:ring-2 focus:ring-bright-green focus:border-transparent transition-colors duration-200 text-dark-forest-green bg-white'}}) }}
            {{ form_errors(form.quizAttempt) }}
        </div>
    </div>

    <div class="flex flex-col sm:flex-row gap-4 justify-end mt-8">
        <a href="{{ path('app_admin_certificate') }}"
        class="inline-flex items-center justify-center px-6 py-3 bg-gray-100 text-xs text-dark-forest-green font-semibold rounded-lg hover:bg-gray-200 transition-colors duration-200 dark:bg-gray-700 dark:!text-gray-200 dark:hover:!text-dark-forest-green">
            Cancel
        </a>
        <button type="submit"
        class="inline-flex items-center justify-center px-6 py-3 bg-bright-green text-xs text-white font-semibold rounded-lg hover:bg-green-600 transition-colors duration-200 shadow-md hover:shadow-lg">
            {{ button_label|default('Save Certificate') }}
        </button>
    </div>
{{ form_end(form) }}