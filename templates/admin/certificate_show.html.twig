{% extends 'admin/base_admin.html.twig' %}

{% block title %}Certificate Details | Growfico{% endblock %}

{% block header_title %}
<h2 class="text-xl font-semibold text-dark-forest-green">Certificate Details</h2>
<p class="text-xs text-light-gray">View certificate information</p>
{% endblock %}

{% block admin_content %}
<div class="rounded-2xl border border-gray-200 shadow-sm p-6 overflow-hidden mb-2">
    <div class="flex justify-center rounded-xl p-8 overflow-auto">
        <div class="preview-scale-wrapper" style="width: 1056px; height: 816px; flex-shrink: 0;">
            <div class="origin-top-left">
                {{ include('admin/certificate_template.html.twig') }}
            </div>
        </div>
    </div>
</div>
<div class="max-w-7xl mx-auto">
    <div class="bg-white rounded-2xl border border-gray-200 shadow-sm p-6 space-y-6">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div>
                <p class="text-xs text-light-gray">Certificate Code</p>
                <p class="text-sm font-medium text-dark-forest-green">
                    {{ certificate.certificateCode }}
                </p>
            </div>
            <div>
                <p class="text-xs text-light-gray">Issued At</p>
                <p class="text-sm font-medium text-dark-forest-green">
                    {{ certificate.issuedAt ? certificate.issuedAt|date('M d, Y H:i') : 'N/A' }}
                </p>
            </div>
        </div>

        <div class="flex flex-col sm:flex-row gap-3 justify-end pt-4 border-t border-gray-100">
            <a href="{{ path('app_admin_certificate') }}"
                class="inline-flex items-center justify-center px-5 py-2.5 bg-gray-100 text-dark-forest-green text-xs font-medium rounded-lg hover:bg-gray-200 transition-colors duration-200 dark:bg-gray-700 dark:!text-gray-200 dark:hover:bg-gray-400">
                Back to list
            </a>
            <a href="{{ path('app_admin_certificate_edit', {'id': certificate.id}) }}"
                class="inline-flex items-center justify-center px-5 py-2.5 bg-bright-green text-white text-xs font-medium rounded-lg hover:bg-green-600 transition-colors duration-200">
                Edit
            </a>
            <form method="post" action="{{ path('app_admin_certificate_delete', {'id': certificate.id}) }}"
                onsubmit="return confirm('Are you sure you want to delete this certificate?');">
                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ certificate.id) }}">
                <button
                    class="inline-flex items-center justify-center px-5 py-2.5 bg-red-600 text-white text-xs font-medium rounded-lg hover:bg-red-700 transition-colors duration-200">
                    Delete
                </button>
            </form>
        </div>
    </div>
</div>
{% endblock %}