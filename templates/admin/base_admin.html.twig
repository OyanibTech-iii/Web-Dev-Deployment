{% extends 'base.html.twig' %}

{% block body %}
<div class="flex min-h-screen bg-background admin-app">
    <aside id="sidebar"
        class="fixed lg:fixed inset-y-0 left-0 z-40 w-72 bg-white border-r border-gray-200 dark:border-gray-700 flex flex-col shadow-sm transform -translate-x-full lg:translate-x-0 transition-transform duration-300 ease-in-out">
        <div class="shrink-0 flex items-center gap-3 px-6 py-3 border-b border-gray-200 dark:border-gray-700 shadow-sm mt-1">
            <div class="w-10 h-10 rounded-xl overflow-hidden ">
                <img src="{{ asset('logos/Icon- Brand.png') }}" alt="Growfico"
                    class="w-full h-full object-cover object-center" />
            </div>
            <div>
                <h1 class="text-lg font-semibold text-dark-forest-green">Growfico</h1>
                <p class="text-xs text-light-gray">Admin Dashboard</p>
            </div>
        </div>

        <!-- Navigation -->
        {% set links = [
        {'label': 'Dashboard', 'route': path('app_admin_dashboard'), 'icon': 'stats-chart-outline', 'route_name':
        'app_admin_dashboard'},
        {'label': 'User Management', 'route': path('app_admin_users'), 'icon': 'people-outline', 'route_name':
        'app_admin_users'},
        {'label': 'Product Management', 'route': path('app_admin_products'), 'icon': 'bag-handle-outline', 'route_name':
        'app_admin_products'},
        {'label': 'Stock Management', 'route': path('app_admin_stocks'), 'icon': 'analytics-outline', 'route_name':
        'app_admin_stocks'},
        {'label': 'Storage Locations', 'route': path('app_admin_locations'), 'icon': 'location-outline', 'route_name':
        'app_admin_locations'},
        {
        'label': 'Courses',
        'route': path('app_admin_courses'),
        'icon': 'school-outline',
        'route_name': 'app_admin_courses',
        'route_prefix': 'app_admin_course',
        'sublinks': [
        {'label': 'Enrollments', 'route': path('app_admin_enrollment'), 'route_name': 'app_admin_enrollment'},
        {'label': 'Quizzes', 'route': path('app_admin_quiz'), 'route_name': 'app_admin_quiz'},
        {'label': 'Questions', 'route': path('app_admin_question'), 'route_name': 'app_admin_question'},
        {'label': 'Answer Choices', 'route': path('app_admin_answer_choice'), 'route_name': 'app_admin_answer_choice'},
        {'label': 'Certificates', 'route': path('app_admin_certificate'), 'route_name': 'app_admin_certificate'},
        ]
        },
        {'label': 'Orders', 'route': path('app_admin_order'), 'icon': 'cart-outline', 'route_name':
        'app_admin_order'},
        {'label': 'Activity Logs', 'route': path('app_admin_logs'), 'icon': 'time-outline', 'route_name':
        'app_admin_logs'},
        ] %}
        <nav class="flex-1 overflow-y-auto min-h-0 px-6 py-5 space-y-2" aria-label="Admin navigation">
            {% for item in links %}
            {% set has_sublinks = item.sublinks is defined %}

            {% set is_active = app.request.get('_route') == item.route_name
                or (item.route_prefix is defined and app.request.get('_route') starts with item.route_prefix)
                or (item.route_name == 'app_admin_courses' and app.request.get('_route') starts with 'app_admin_lesson') %}
            {% set child_active = false %}
            {% if has_sublinks %}
            {% for sub in item.sublinks %}
            {% if app.request.get('_route') == sub.route_name %}{% set child_active = true %}{% endif %}
            {% endfor %}
            {% endif %}

            <div x-data="{ open: {{ (is_active or child_active) ? 'true' : 'false' }} }" class="w-full">
                {# Parent Link #}
                <a {% if not has_sublinks %}href="{{ item.route }}" {% else %}@click="open = !open"
                    style="cursor: pointer;" {% endif %} class="group flex items-center gap-3 px-3 py-2.5 rounded-xl text-xs font-medium transition-all duration-200 
            {{ (is_active or child_active) 
                ? 'bg-primary-50 dark:bg-primary-900/35 text-bright-green shadow-sm ring-1 ring-primary-200 dark:ring-primary-700' 
                : 'text-light-gray hover:bg-gray-50 dark:hover:bg-gray-700/80 hover:text-dark-forest-green dark:hover:text-gray-100' 
            }}">

                    <ion-icon name="{{ (is_active or child_active) ? item.icon|replace({'-outline': ''}) : item.icon }}"
                        class="text-lg transition-colors duration-200
                {{ (is_active or child_active) ? 'text-bright-green' : 'text-gray-400 dark:text-gray-500 group-hover:text-light-gray dark:group-hover:text-gray-300' }}"></ion-icon>

                    <span class="flex-1">{{ item.label }}</span>

                    {% if has_sublinks %}
                    <ion-icon name="chevron-down-outline" class="text-xs transition-transform duration-300"
                        :class="open ? 'rotate-180' : ''"></ion-icon>
                    {% elseif is_active %}
                    <div class="w-1.5 h-1.5 rounded-full bg-bright-green"></div>
                    {% endif %}
                </a>

                {# Accordion Sub-menu #}
                {% if has_sublinks %}
                <div x-show="open" x-transition:enter="transition ease-out duration-200"
                    x-transition:enter-start="opacity-0 -translate-y-2"
                    x-transition:enter-end="opacity-100 translate-y-0"
                    class="mt-1 ml-4 pl-4 border-l border-gray-100 dark:border-gray-700 space-y-1">

                    {# Link to the main Courses page #}
                    <a href="{{ item.route }}"
                        class="block py-2 text-xs font-medium {{ is_active ? 'text-bright-green' : 'text-light-gray hover:text-dark-forest-green' }}">
                        Overview
                    </a>

                    {% for sub in item.sublinks %}
                    <a href="{{ sub.route }}"
                        class="block py-2 text-xs font-medium {{ app.request.get('_route') == sub.route_name ? 'text-bright-green' : 'text-light-gray hover:text-dark-forest-green' }}">
                        {{ sub.label }}
                    </a>
                    {% endfor %}
                </div>
                {% endif %}
            </div>
            {% endfor %}
        </nav>

        <!-- Sidebar Footer -->
        <div class="mt-auto mx-auto flex justify-center shrink-0 px-6 py-5 border-t border-gray-100 dark:border-gray-700 text-[10px] text-light-gray">
            <p>&copy; {{ "now"|date("Y") }} Growfico. All rights reserved.</p>
        </div>
    </aside>

    <!-- Mobile Overlay -->
    <div id="mobile-overlay" class="fixed rounded-full inset-0 bg-opacity-50 z-30 lg:hidden hidden"></div>

    <!-- Main Content Area -->
    <div class="flex flex-col flex-1 min-w-0 lg:ml-72">
        <!-- Header -->
        <header id="main-header"
            class="sticky top-0 z-30 bg-white dark:bg-gray-800 border-b border-gray-200 dark:border-gray-700 px-4 py-4 shadow-sm">
            <div class="flex items-center justify-between w-full max-w-full">

                <div class="flex lg:hidden items-center gap-3">
                    <button type="button"
                        class="js-admin-mobile-menu js-admin-mobile-menu-header lg:hidden w-10 h-10 flex items-center justify-center rounded-full border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800 text-light-gray hover:text-dark-forest-green dark:hover:text-white transition-all duration-200 shadow-sm">
                        <ion-icon name="menu-outline" class="text-xl"></ion-icon>
                    </button>

                    <div class="hidden sm:block">
                        {% block header_title %}
                        <h2 class="text-lg font-semibold text-dark-forest-green dark:text-white leading-tight">Admin
                            Page</h2>
                        <p class="text-xs text-light-gray dark:text-gray-400">Manage your application</p>
                        {% endblock %}
                    </div>
                </div>

                <div class="flex items-center gap-1 sm:gap-2 ml-auto">
                    <div class="relative" x-data="{ open: false }">
                        <button @click="open = !open" @click.outside="open = false" type="button"
                            class="relative w-10 h-10 flex items-center justify-center rounded-full border border-gray-200 dark:border-gray-700 text-gray-500 hover:text-gray-900 hover:bg-gray-100 dark:text-gray-400 dark:hover:text-white dark:hover:bg-gray-700 transition-colors duration-200"
                            title="Notifications">
                            <ion-icon name="notifications-outline" class="text-sm"></ion-icon>
                            <span id="notification-badge"
                                class="absolute top-2 right-2 min-w-[18px] h-[18px] px-1 bg-bright-green border-2 border-white dark:border-gray-800 rounded-full text-[10px] font-bold text-white flex items-center justify-center {{ (notifications is defined and notifications|length > 0) ? '' : 'hidden' }}">
                                {{ notifications is defined ? notifications|length : 0 }}
                            </span>
                        </button>

                        <script>
                            (function() {
                                const badge = document.getElementById('notification-badge');
                                if (!badge) return;

                                function connect() {
                                    const socket = new WebSocket('ws://' + window.location.hostname + ':8080/notifications-ws');

                                    socket.onmessage = function(event) {
                                        try {
                                            const data = JSON.parse(event.data);
                                            if (data.type === 'badge_update') {
                                                const count = data.count;
                                                badge.textContent = count;
                                                if (count > 0) {
                                                    badge.classList.remove('hidden');
                                                } else {
                                                    badge.classList.add('hidden');
                                                }
                                            }
                                        } catch (e) {
                                            console.error('Error parsing notification message', e);
                                        }
                                    };

                                    socket.onclose = function(e) {
                                        console.log('Notification socket closed. Reconnecting in 5s...', e.reason);
                                        setTimeout(connect, 5000);
                                    };

                                    socket.onerror = function(err) {
                                        console.error('Notification socket error: ', err.message, 'Closing socket');
                                        socket.close();
                                    };
                                }

                                connect();
                            })();
                        </script>

                        <div x-show="open" x-transition:enter="transition ease-out duration-200"
                            x-transition:enter-start="opacity-0 scale-95 translate-y-[-10px]"
                            x-transition:enter-end="opacity-100 scale-100 translate-y-0"
                            x-transition:leave="transition ease-in duration-150"
                            x-transition:leave-start="opacity-100 scale-100" x-transition:leave-end="opacity-0 scale-95"
                            class="absolute right-0 mt-2 w-80 sm:w-96 bg-white dark:bg-gray-800 border border-gray-100 dark:border-gray-700 rounded-2xl shadow-2xl z-50 overflow-hidden"
                            style="display: none;">

                            <div
                                class="px-4 py-3 border-b border-gray-100 dark:border-gray-700 flex justify-between items-center">
                                <form method="post" action="{{ path('app_admin_notification_read_all') }}"
                                    class="confirm-delete-form" data-message="Mark all notifications as read?">
                                    <input type="hidden" name="_token" value="{{ csrf_token('read_all_notifications') }}">
                                    <button type="submit" class="text-xs text-dark-forest-green hover:underline dark:!text-gray-200 font-semibold">
                                        Mark all as read
                                    </button>
                                </form>
                            </div>

                            <div class="max-h-[400px] overflow-y-auto">
                                {% if notifications is defined and notifications|length > 0 %}
                                    {% for notification in notifications %}
                                    <a href="#"
                                        class="flex items-start gap-3 px-4 py-3 hover:bg-gray-50 dark:hover:bg-gray-700/50 transition-colors {{ not loop.last ? 'border-b border-gray-50 dark:border-gray-700/50' : '' }}">
                                        <div
                                            class="shrink-0 w-10 h-10 rounded-full bg-gray-500 dark:bg-gray-700 flex items-center justify-center text-gray-200 ">
                                            <ion-icon name="{% if 'order' in notification.type|lower %}cart-outline{% elseif 'user' in notification.type|lower %}person-outline{% else %}notifications-outline{% endif %}" class="text-sm"></ion-icon>
                                        </div>
                                        <div class="flex-1">
                                            <p class="text-xs text-gray-800 dark:text-gray-200">
                                                {{ notification.title }}<br><span class="font-semibold">{{ notification.message }}</span>
                                            </p>
                                            <p class="text-xs text-light-gray mt-1">{{ notification.createAt ? notification.createAt|date('M d, Y H:i') : 'just now' }}</p>
                                        </div>
                                        {% if not notification.isRead %}
                                        <div class="w-2 h-2 mt-2 rounded-full bg-bright-green"></div>
                                        {% endif %}
                                    </a>
                                    {% endfor %}
                                {% else %}
                                    <div class="px-4 py-6 text-center">
                                        <p class="text-xs text-light-gray">No notifications</p>
                                    </div>
                                {% endif %}
                            </div>
                            <a href="{{ path('app_admin_notification') }}"
                                class="block py-3 text-center text-sm text-dark-forest-green hover:bg-gray-50 dark:hover:bg-gray-700 border-t border-gray-100 dark:border-gray-700 dark:!text-gray-200 transition-colors">
                                See all notifications
                            </a>
                        </div>
                    </div>
                    <button id="theme-toggle" type="button"
                        class="w-10 h-10 flex items-center justify-center rounded-full border border-gray-200 dark:border-gray-700 text-gray-500 hover:text-gray-900 hover:bg-gray-100 dark:text-gray-400 dark:hover:text-white dark:hover:bg-gray-700 transition-colors duration-200"
                        title="Toggle Theme">
                        <ion-icon id="theme-icon" name="moon-outline" class="text-sm"></ion-icon>
                    </button>

                    <a href="{{ path('app_admin_chatroom') }}"
                        class="w-10 h-10 flex items-center justify-center rounded-full border border-gray-200 dark:border-gray-700 text-gray-500 hover:text-gray-900 hover:bg-gray-100 dark:text-gray-400 dark:hover:text-white dark:hover:bg-gray-700 transition-colors duration-200"
                        title="Chatroom">
                        <ion-icon name="chatbubble-ellipses-outline" class="text-sm"></ion-icon>
                    </a>

                    <div class="relative ml-1" x-data="{ open: false }">
                        <button type="button" @click="open = !open" @click.outside="open = false"
                            class="group flex items-center rounded-full bg-gray-50 dark:bg-gray-700 hover:bg-gray-100 dark:hover:bg-gray-600 transition-colors duration-200 p-1">

                            <div
                                class="w-6 h-6 bg-gradient-to-br from-bright-green to-primary-600 text-white flex items-center justify-center rounded-full font-semibold text-sm overflow-hidden shadow-sm">
                                {% if is_granted('IS_AUTHENTICATED_FULLY') %}
                                {% if app.user.profileImage %}
                                {% set appProfileSrc = app.user.profileImage %}
                                {% if appProfileSrc starts with '/' %}{% set appProfileSrc = appProfileSrc[1:] %}{% endif %}
                                <img src="{{ asset(appProfileSrc) }}" alt="Profile"
                                    class="w-full h-full object-cover">
                                {% else %}
                                {{ app.user.firstName ? app.user.firstName|first|upper : app.user.email|first|upper }}
                                {% endif %}
                                {% else %}
                                A
                                {% endif %}
                            </div>

                            <ion-icon name="chevron-down-outline"
                                class="ml-1 text-xs text-gray-500 dark:text-gray-400 group-hover:text-gray-900 dark:group-hover:text-white transition-transform duration-200"
                                :class="open ? 'rotate-180' : ''"></ion-icon>
                        </button>

                        <div x-show="open" x-transition:enter="transition ease-out duration-100"
                            x-transition:enter-start="opacity-0 scale-95" x-transition:enter-end="opacity-100 scale-100"
                            x-transition:leave="transition ease-in duration-75"
                            x-transition:leave-start="opacity-100 scale-100" x-transition:leave-end="opacity-0 scale-95"
                            class="absolute right-0 mt-2 w-48 bg-white dark:bg-gray-800 border border-gray-100 dark:border-gray-700 rounded-xl shadow-xl z-50 py-2"
                            style="display: none;">

                            <a href="{{ path('app_admin_profile') }}"
                                class="flex items-center gap-3 px-4 py-2 text-xs text-gray-600 dark:text-gray-400 hover:bg-gray-50 dark:hover:bg-gray-700 hover:text-gray-900 dark:hover:text-white transition-colors">
                                <ion-icon name="person-outline" class="text-sm"></ion-icon>
                                Profile
                            </a>

                            <a href="{{ path('app_admin_profile') }}?edit=personal"
                                class="flex items-center gap-3 px-4 py-2 text-xs text-gray-600 dark:text-gray-400 hover:bg-gray-50 dark:hover:bg-gray-700 hover:text-gray-900 dark:hover:text-white transition-colors">
                                <ion-icon name="create-outline" class="text-sm"></ion-icon>
                                Edit Personal Info
                            </a>

                            <hr class="my-1 border-gray-100 dark:border-gray-700">

                            <button id="logout-btn" type="button" @click="open = false"
                                class="w-full flex items-center gap-3 px-4 py-2 text-xs text-red-600 dark:text-red-400 hover:bg-red-50 dark:hover:bg-red-950/40 hover:text-red-700 dark:hover:text-red-300 transition-colors text-left">
                                <ion-icon name="log-out-outline" class="text-sm"></ion-icon>
                                Logout
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </header>

        <!-- Main Content -->
        <main class="flex-1 p-6 overflow-y-auto text-gray-900 dark:text-gray-100">
            {% block admin_content %}
            {% endblock %}
        </main>
    </div>
</div>

<div id="logout-modal" class="fixed inset-0 z-50 hidden backdrop-blur-md" style="display: none;">
    <div class="absolute inset-0 bg-black/40 backdrop-blur-md"></div>
    <div class="absolute inset-0 flex items-center justify-center">
        <div
            class="bg-white dark:bg-gray-800 rounded-2xl shadow-2xl p-8 max-w-md w-full mx-4 transform transition-all relative z-10 border border-gray-100 dark:border-gray-700">
            <!-- Modal Header -->
            <div class="flex items-center gap-4 mb-4">
                <div class="w-12 h-12 rounded-full bg-red-100 dark:bg-red-950/50 flex items-center justify-center">
                    <ion-icon name="alert-circle-outline" class="text-2xl text-red-600 dark:text-red-400"></ion-icon>
                </div>
                <div>
                    <h3 class="text-lg font-semibold text-dark-forest-green">Confirm Logout</h3>
                    <p class="text-xs text-light-gray">Are you sure you want to logout?</p>
                </div>
            </div>

            <!-- Modal Content -->
            <p class="text-sm text-light-gray mb-6">
                You will be logged out of your admin account. You can log back in anytime with your credentials.
            </p>

            <!-- Modal Actions -->
            <div class="flex gap-3">
                <button id="logout-cancel-btn"
                    class="flex-1 px-4 py-2.5 rounded-lg bg-gray-100 dark:bg-gray-700 hover:bg-gray-200 dark:hover:bg-gray-600 text-dark-forest-green dark:text-gray-100 font-medium transition-colors duration-200">
                    Cancel
                </button>
                <a id="logout-confirm-btn" href="{{ path('app_logout') }}"
                    class="flex-1 px-4 py-2.5 rounded-lg bg-red-600 hover:bg-red-700 text-white font-medium transition-colors duration-200 text-center no-underline flex items-center justify-center">
                    Logout
                </a>
            </div>
        </div>
    </div>
</div>

<script src="{{ asset('js/admin-sidebar.js') }}"></script>
<script src="{{ asset('js/logoutmodal-admin.js') }}"></script>

{% endblock %}