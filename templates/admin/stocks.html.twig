{% extends 'admin/base_admin.html.twig' %}

{% block title %}Admin Stocks | Growfico{% endblock %}

{% block stylesheets %}
{{ parent() }}
<link rel="stylesheet" href="https://cdn.datatables.net/1.13.7/css/jquery.dataTables.min.css">
<link rel="stylesheet" href="{{ asset('styles/datatable.css') }}">
{% endblock %}

{% block header_title %}
<h2 class="text-lg font-semibold text-dark-forest-green">Stock Management</h2>
<p class="text-xs text-light-gray">Monitor and manage your inventory levels</p>
{% endblock %}

{% block admin_content %}
<div class="max-w-7xl mx-auto">
    <!-- Stock Management Section -->
    <div class="bg-white rounded-2xl border border-gray-200 shadow-sm p-6">
        <div class="flex flex-col sm:flex-row sm:justify-between sm:items-center gap-4 mb-6">
            <h2 class="text-xl font-semibold text-dark-forest-green">Manage Stocks</h2>
            <div class="flex flex-col sm:flex-row gap-4 sm:items-center">
                <div class="relative">
                    <span class="absolute inset-y-0 left-0 pl-3 flex items-center text-gray-400 pointer-events-none">
                        <ion-icon name="search-outline"></ion-icon>
                    </span>
                    <input type="text" id="stocks-search-input"
                        class="block w-full sm:w-64 pl-10 pr-3 py-2 border border-gray-300 rounded-lg leading-5 bg-white placeholder-gray-500 focus:outline-none focus:ring-1 focus:ring-bright-green sm:text-sm"
                        placeholder="Search stocks..." autocomplete="off" aria-label="Search stocks">
                </div>
                <a href="{{ path('app_admin_stock_new') }}"
                    class="inline-flex items-center justify-center px-4 py-2 bg-bright-green text-white text-xs font-medium rounded-lg hover:bg-green-600 transition-colors duration-200">
                    <ion-icon name="add-outline" class="w-4 h-4 mr-2"></ion-icon>
                    Add Stock
                </a>
            </div>
        </div>

        <div class="overflow-x-auto">
            <table id="stocksTable" class="w-full">
                <thead class="bg-gray-50">
                    <tr>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                            Product</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Type
                        </th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                            Quantity</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                            Location</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                            Status</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Last
                            Updated</th>
                        <th class="px-6 py-3 text-center text-xs font-medium text-gray-500 uppercase tracking-wider no-sort"
                            style="text-align: center !important;">
                            Actions
                        </th>
                    </tr>
                </thead>
                <tbody class="bg-white divide-y divide-gray-200 dark:divide-gray-500">
                    {% for stock in stocks %}
                    {% set productsData = [] %}
                    {% for p in stock.products %}
                    {% set productsData = productsData|merge([{
                    'name': p.name,
                    'description': p.description,
                    'image': p.getImagePath() ? asset(p.getImagePath()) : ''
                    }]) %}
                    {% endfor %}
                    <tr class="hover:bg-gray-50 transition-colors duration-200 stock-row" data-stock-id="{{ stock.id }}"
                        {% set fp=stock.products|first %}
                        data-stock-product-name="{{ fp ? fp.name : (stock.stockType ? stock.stockType|title : 'Stock Item') }}"
                        data-stock-product-description="{{ fp ? fp.description : (stock.locationRel ? stock.locationRel : 'No product linked') }}"
                        data-stock-image="{{ fp and fp.getImagePath() ? asset(fp.getImagePath()) : '' }}"
                        data-stock-type="{{ stock.stockType ? stock.stockType|title : 'General' }}"
                        data-stock-quantity="{{ stock.Quantity }}"
                        data-stock-minimum="{{ stock.minimumQuantity ?? '' }}"
                        data-stock-locationRel="{{ stock.locationRel ? stock.locationRel.name : 'N/A' }}"
                        data-stock-status="{{ stock.Quantity == 0 ? 'Out of Stock' : (stock.Quantity < 10 ? 'Low Stock' : 'In Stock') }}"
                        data-stock-updated="{{ stock.updatedAt ? stock.updatedAt|date('M d, Y H:i') : 'N/A' }}"
                        data-stock-products="{{ productsData|json_encode|e('html_attr') }}">
                        <td class="px-6 py-4 whitespace-nowrap">
                            <div class="flex items-center">
                                <div
                                    class="w-10 h-10 bg-gradient-to-br from-bright-green/10 to-dark-forest-green/10 rounded-lg flex items-center justify-center flex-shrink-0 mr-3 ">
                                    {% set firstProduct = stock.products|first %}
                                    {% if firstProduct and firstProduct.getImagePath() %}
                                    <img src="{{ asset(firstProduct.getImagePath()) }}" alt="{{ firstProduct.name }}"
                                        class="w-full h-full object-cover rounded-lg">
                                    {% else %}
                                    <ion-icon name="cube-outline" class="w-5 h-5 text-bright-green"></ion-icon>
                                    {% endif %}
                                </div>
                                <div>
                                    <div class="text-xs font-medium text-dark-forest-green">
                                        {% if stock.products|length > 0 %}
                                        {% set firstProduct = stock.products|first %}
                                        {{ firstProduct.name }}
                                        {% if stock.products|length > 1 %}
                                        <span class="text-xs text-light-gray">(+{{ stock.products|length - 1 }}
                                            more)</span>
                                        {% endif %}
                                        {% else %}
                                        {{ stock.stockType ? stock.stockType|title : 'Stock Item' }}
                                        {% endif %}
                                    </div>
                                    <div class="text-xs text-light-gray">
                                        {% if stock.products|length > 0 %}
                                        {% set firstProduct = stock.products|first %}
                                        {# {{ firstProduct.description|slice(0, 50) ~ '...' }} #}
                                        {% else %}
                                        {{ stock.locationRel ? stock.locationRel : 'No product linked' }}
                                        {% endif %}
                                    </div>
                                </div>
                            </div>
                        </td>
                        <td class="px-6 py-4 whitespace-nowrap">
                            <span
                                class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-transparent text-primary-600 dark:bg-gray-800 dark:!text-gray-300">
                                {{ stock.stockType ? stock.stockType|title : 'General' }}
                            </span>
                        </td>
                        <td class="px-6 py-4 whitespace-nowrap">
                            <div class="text-xs font-semibold text-dark-forest-green">{{ stock.Quantity }}</div>
                            {# {% if stock.minimumQuantity %}
                            <div class="text-xs text-light-gray">Min: {{ stock.minimumQuantity }}</div>
                            {% endif %} #}
                        </td>
                        <td class="px-6 py-4 whitespace-nowrap">
                            <div class="text-xs text-light-gray">
                                {{ stock.locationRel ? stock.locationRel.name : 'N/A' }}
                            </div>
                        </td>
                        <td class="px-6 py-4 whitespace-nowrap">
                            {% if stock.Quantity == 0 %}
                            <span
                                class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-transparent text-red-800 dark:bg-gray-800 dark:!text-red-400">
                                Out of Stock
                            </span>
                            {% elseif stock.Quantity < 10 %} <span
                                class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-transparent text-orange-800 dark:bg-gray-800 dark:!text-yellow-200">
                                Low Stock
                                </span>
                                {% else %}
                                <span
                                    class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-transparent text-green-800 dark:bg-gray-800 dark:!text-bright-green">
                                    In Stock
                                </span>
                                {% endif %}
                        </td>
                        <td class="px-6 py-4 whitespace-nowrap text-xs text-light-gray">
                            {{ stock.updatedAt ? stock.updatedAt|date('M d, Y H:i') : 'N/A' }}
                        </td>
                        <td class="px-6 py-4 whitespace-nowrap text-xs font-medium text-right">
                            <div class="flex items-center justify-center gap-2">
                                <button type="button"
                                    class="text-bright-green hover:text-green-600 transition-colors duration-200 open-stock-modal"
                                    title="View Stock">
                                    <ion-icon name="eye-outline" class="w-4 h-4"></ion-icon>
                                </button>
                                <a href="{{ path('app_admin_stock_edit', {'id': stock.id}) }}"
                                    class="text-blue-600 hover:text-blue-800 transition-colors duration-200">
                                    <ion-icon name="create-outline" class="w-4 h-4"></ion-icon>
                                </a>
                                <button type="button"
                                    class="text-red-600 hover:text-red-800 transition-colors duration-200 delete-stock-btn"
                                    data-stock-id="{{ stock.id }}"
                                    data-csrf-token="{{ csrf_token('delete' ~ stock.id) }}">
                                    <ion-icon name="trash-outline" class="w-4 h-4"></ion-icon>
                                </button>
                            </div>
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>

        {% if stocks is empty %}
        <div class="text-center py-8 border-t border-gray-100 mt-4">
            <div class="w-12 h-12 bg-gray-100 rounded-full flex items-center justify-center mb-4 mx-auto dark:bg-gray-700">
                <ion-icon name="cube-outline" class="text-xl text-light-gray"></ion-icon>
            </div>
            <h4 class="text-sm font-semibold text-dark-forest-green mb-2">No stock items found</h4>
            <p class="text-xs text-light-gray mb-4 max-w-sm mx-auto">Start managing your inventory by adding your first
                stock item.</p>
            <a href="{{ path('app_admin_stock_new') }}"
                class="inline-flex items-center px-4 py-2 bg-bright-green text-white text-xs font-medium rounded-lg hover:bg-green-600 transition-colors duration-200">
                <ion-icon name="add-outline" class="w-4 h-4 mr-2"></ion-icon>
                Add Your First Stock Item
            </a>
        </div>
        {% endif %}
    </div>
</div>

<!-- Stock View Modal -->
<div id="stock-view-modal" class="fixed inset-0 z-50 hidden">
    <div class="absolute inset-0 bg-black/40 backdrop-blur-md"></div>
    <div class="relative z-10 flex items-center justify-center min-h-screen p-4">
        <div class="bg-white rounded-2xl shadow-xl max-w-lg w-full overflow-hidden">
            <div class="px-6 py-4 bg-bright-green text-white flex items-center justify-between">
                <h3 class="text-lg font-semibold">Stock Details</h3>
                <button type="button" id="stock-modal-close" class="text-white/90 hover:text-white" aria-label="Close">
                    <ion-icon name="close-outline" class="w-6 h-6"></ion-icon>
                </button>
            </div>
            <div class="p-6 space-y-4">
                <div class="flex items-start gap-4">
                    <div
                        class="w-48 h-48 bg-gray-100 rounded-lg flex items-center justify-center overflow-hidden relative">
                        <img id="sv-image" src="" alt="Stock product image" class="w-full h-full object-cover hidden">
                        <ion-icon id="sv-fallback" name="cube-outline" class="w-12 h-12 text-bright-green"></ion-icon>
                        <button id="sv-prev"
                            class="absolute left-2 top-1/2 -translate-y-1/2 bg-white/80 hover:bg-white text-dark-forest-green rounded-full w-8 h-8 flex items-center justify-center shadow">
                            <ion-icon name="chevron-back-outline"></ion-icon>
                        </button>
                        <button id="sv-next"
                            class="absolute right-2 top-1/2 -translate-y-1/2 bg-white/80 hover:bg-white text-dark-forest-green rounded-full w-8 h-8 flex items-center justify-center shadow">
                            <ion-icon name="chevron-forward-outline"></ion-icon>
                        </button>
                        <div id="sv-indicator"
                            class="absolute bottom-2 left-1/2 -translate-x-1/2 bg-black/40 text-white text-[10px] px-2 py-0.5 rounded-full hidden">
                        </div>
                    </div>
                    <div class="flex-1 min-w-0">
                        <h4 id="sv-name" class="text-base font-semibold text-dark-forest-green"></h4>
                        <p id="sv-description" class="text-sm text-light-gray mt-1"></p>
                    </div>
                </div>
                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <p class="text-xs text-light-gray">Type</p>
                        <p id="sv-type" class="text-sm font-medium text-dark-forest-green"></p>
                    </div>
                    <div>
                        <p class="text-xs text-light-gray">locationRel</p>
                        <p id="sv-locationRel" class="text-sm font-medium text-dark-forest-green"></p>
                    </div>
                    <div>
                        <p class="text-xs text-light-gray">Quantity</p>
                        <p id="sv-quantity" class="text-sm font-medium text-dark-forest-green"></p>
                    </div>
                    <div>
                        <p class="text-xs text-light-gray">Minimum</p>
                        <p id="sv-minimum" class="text-sm font-medium text-dark-forest-green"></p>
                    </div>
                </div>
                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <p class="text-xs text-light-gray">Status</p>
                        <p id="sv-status" class="text-sm font-medium"></p>
                    </div>
                    <div>
                        <p class="text-xs text-light-gray">Last Updated</p>
                        <p id="sv-updated" class="text-sm font-medium text-dark-forest-green"></p>
                    </div>
                </div>
                {# <div class="flex justify-end pt-4 border-t border-gray-100">
                    <button id="stock-modal-close-2"
                        class="px-4 py-2 text-sm font-medium text-gray-700 bg-gray-100 rounded-lg hover:bg-gray-200 transition-colors duration-200">Close</button>
                </div> #}
            </div>
        </div>
    </div>
</div>

<!-- Stock Delete Confirmation Modal -->
<div id="delete-stock-modal" class="fixed inset-0 z-50 hidden backdrop-blur-md" style="display: none;"
    data-base-delete-url="{{ path('app_admin_stock_delete', {'id': 0}) }}">
    <div class="absolute inset-0 bg-black/40 backdrop-blur-md"></div>
    <div class="absolute inset-0 flex items-center justify-center">
        <div class="bg-white rounded-2xl shadow-2xl p-8 max-w-md w-full mx-4 transform transition-all relative z-10">
            <!-- Modal Header -->
            <div class="flex items-center gap-4 mb-4">
                <div class="w-12 h-12 rounded-full bg-red-100 flex items-center justify-center">
                    <ion-icon name="alert-circle-outline" class="text-2xl text-red-600"></ion-icon>
                </div>
                <div>
                    <h3 class="text-lg font-semibold text-dark-forest-green">Delete Stock</h3>
                    <p class="text-xs text-light-gray">Are you sure?</p>
                </div>
            </div>

            <!-- Modal Content -->
            <p class="text-sm text-light-gray mb-6">
                This action cannot be undone. The stock item will be permanently deleted from your inventory.
            </p>

            <!-- Modal Actions -->
            <div class="flex gap-3">
                <button id="delete-stock-cancel-btn"
                    class="flex-1 px-4 py-2.5 rounded-lg bg-gray-100 hover:bg-gray-200 text-dark-forest-green font-medium transition-colors duration-200">
                    Cancel
                </button>
                <button id="delete-stock-confirm-btn"
                    class="flex-1 px-4 py-2.5 rounded-lg bg-red-600 hover:bg-red-700 text-white font-medium transition-colors duration-200 text-center no-underline flex items-center justify-center">
                    Delete
                </button>
            </div>
        </div>
    </div>
</div>

{# Load after modals so getElementById in stocks-admin.js sees the DOM #}
<script src="{{ asset('js/stocks-admin.js') }}"></script>

{% block javascripts %}
{{ parent() }}
<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script src="https://cdn.datatables.net/1.13.7/js/jquery.dataTables.min.js"></script>
<script src="{{ asset('js/admin-search.js') }}"></script>
<script>
    (function () {
        'use strict';
        const TABLE_SELECTOR = '#stocksTable';
        const SEARCH_INPUT_ID = 'stocks-search-input';

        function initStocksDataTable() {
            if (typeof jQuery === 'undefined' || !jQuery.fn.DataTable) {
                return;
            }
            const $table = jQuery(TABLE_SELECTOR);
            if (!$table.length || jQuery.fn.DataTable.isDataTable(TABLE_SELECTOR)) {
                return;
            }
            const table = $table.DataTable({
                dom: 'lrtip',
                pageLength: 10,
                order: [[0, 'asc']],
                columnDefs: [
                    { orderable: false, targets: 6 },
                    { className: 'align-middle', targets: '_all' }
                ],
                autoWidth: false,
                language: {
                    emptyTable: 'No stock items found.',
                    zeroRecords: 'No matching stock items found.',
                    paginate: {
                        previous: '<ion-icon name="chevron-back-outline" class="align-middle"></ion-icon>',
                        next: '<ion-icon name="chevron-forward-outline" class="align-middle"></ion-icon>'
                    }
                }
            });

            const searchInput = document.getElementById(SEARCH_INPUT_ID);
            if (searchInput) {
                searchInput.addEventListener('keyup', function () {
                    table.search(this.value).draw();
                });
            }

            if (typeof AdminSearch !== 'undefined') {
                new AdminSearch({
                    searchInputId: SEARCH_INPUT_ID,
                    tableSelector: TABLE_SELECTOR
                });
            }
        }

        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', initStocksDataTable);
        } else {
            initStocksDataTable();
        }
    })();
</script>
{% endblock %}
{% endblock %}