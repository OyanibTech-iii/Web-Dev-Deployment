{% extends 'admin/base_admin.html.twig' %}

{% block title %}Orders | Growfico{% endblock %}

{% block header_title %}
<h2 class="text-lg font-semibold text-dark-forest-green">Orders</h2>
<p class="text-xs text-light-gray">Manage customer orders</p>
{% endblock %}

{% block stylesheets %}
{{ parent() }}
<link rel="stylesheet" href="https://cdn.datatables.net/1.13.7/css/jquery.dataTables.min.css">
<link rel="stylesheet" href="{{ asset('styles/datatable.css') }}">
{% endblock %}

{% block admin_content %}
<div class="max-w-7xl mx-auto">
    <div class="bg-white rounded-2xl border border-gray-200 shadow-sm p-6">
        <div class="flex flex-col sm:flex-row sm:justify-between sm:items-center gap-4 mb-6">
            <h2 class="text-lg font-semibold text-dark-forest-green">Manage Orders</h2>
            <div class="flex flex-col sm:flex-row gap-4 sm:items-center">
                <div class="relative">
                    <span class="absolute inset-y-0 left-0 pl-3 flex items-center text-gray-400 pointer-events-none">
                        <ion-icon name="search-outline"></ion-icon>
                    </span>
                    <input type="text"
                           id="orders-search-input"
                           class="block w-full sm:w-64 pl-10 pr-3 py-2 border border-gray-300 rounded-lg leading-5 bg-white placeholder-gray-500 focus:outline-none focus:ring-1 focus:ring-bright-green sm:text-sm"
                           placeholder="Search orders..."
                           autocomplete="off"
                           aria-label="Search orders">
                </div>
                <a href="{{ path('app_admin_order_new') }}"
                   class="inline-flex items-center justify-center px-4 py-2 bg-bright-green text-white text-xs font-medium rounded-lg hover:bg-green-600 transition-colors duration-200">
                    <ion-icon name="add-outline" class="w-4 h-4 mr-2"></ion-icon>
                    Add Order
                </a>
            </div>
        </div>

        <div id="orders-table-container">
            {{ include('admin/_order_table.html.twig') }}
        </div>
    </div>
</div>

{% block javascripts %}
{{ parent() }}
<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script src="https://cdn.datatables.net/1.13.7/js/jquery.dataTables.min.js"></script>
<script src="{{ asset('js/admin-search.js') }}"></script>
<script>
    (function () {
        const TABLE_SELECTOR = '#ordersTable';
        const SEARCH_INPUT_ID = 'orders-search-input';
        let dataTable = null;

        function initOrdersDataTable() {
            if (typeof jQuery === 'undefined' || !jQuery.fn.DataTable) {
                return;
            }

            const $table = jQuery(TABLE_SELECTOR);
            if (!$table.length) {
                return;
            }

            // Destroy existing if any
            if (jQuery.fn.DataTable.isDataTable(TABLE_SELECTOR)) {
                jQuery(TABLE_SELECTOR).DataTable().destroy();
            }

            dataTable = $table.DataTable({
                dom: 'lrtip',
                pageLength: 10,
                order: [[0, 'desc']], 
                columnDefs: [
                    { orderable: false, targets: 6 },
                    { className: 'align-middle', targets: '_all' }
                ],
                autoWidth: false,
                language: {
                    emptyTable: 'No orders found.',
                    zeroRecords: 'No matching orders found.',
                    paginate: {
                        previous: '<ion-icon name="chevron-back-outline" class="align-middle"></ion-icon>',
                        next: '<ion-icon name="chevron-forward-outline" class="align-middle"></ion-icon>'
                    }
                }
            });

            const searchInput = document.getElementById(SEARCH_INPUT_ID);
            if (searchInput) {
                if (searchInput.value) {
                    dataTable.search(searchInput.value).draw();
                }
                
                searchInput.addEventListener('keyup', function () {
                    dataTable.search(this.value).draw();
                });
            }
        }

        function setupRealtimeOrders() {
            const socket = new WebSocket('wss://stunning-compassion-production-f5b5.up.railway.app/notifications-ws');
            
            socket.onmessage = function(event) {
                try {
                    const data = JSON.parse(event.data);
                    if (data.type === 'order') {
                        console.log('Real-time order update received, refreshing table...');
                        refreshOrdersTable();
                    }
                } catch (e) {
                    console.error('Error parsing notification:', e);
                }
            };

            socket.onclose = function() {
                console.log('Order notification socket closed. Reconnecting in 5s...');
                setTimeout(setupRealtimeOrders, 5000);
            };
        }

        function refreshOrdersTable() {
            const container = document.getElementById('orders-table-container');
            if (!container) return;

            fetch('{{ path("app_admin_order_table") }}')
                .then(response => response.text())
                .then(html => {
                    const parser = new DOMParser();
                    const doc = parser.parseFromString(html, 'text/html');
                    const newContainer = doc.getElementById('orders-table-container');
                    
                    if (newContainer) {
                        container.innerHTML = newContainer.innerHTML;
                        initOrdersDataTable(); 
                    }
                })
                .catch(err => console.error('Error refreshing orders table:', err));
        }

        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', () => {
                initOrdersDataTable();
                setupRealtimeOrders();
            });
        } else {
            initOrdersDataTable();
            setupRealtimeOrders();
        }
    })();
</script>
{% endblock %}
{% endblock %}
