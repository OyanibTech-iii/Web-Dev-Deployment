{{ form_start(form, {'attr': {'class': 'w-full space-y-6'}}) }}
<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    <div class="space-y-2 md:col-span-2">
        {{ form_label(form.title, 'Title', {'label_attr': {'class': 'block text-xs font-semibold
        text-dark-forest-green'}}) }}
        {{ form_widget(form.title, {'attr': {'class': 'w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2
        focus:ring-bright-green focus:border-transparent transition-colors duration-200 text-dark-forest-green text-xs'}}) }}
        {{ form_errors(form.title) }}
    </div>

    <div class="space-y-2">
        {{ form_label(form.course, 'Course', {'label_attr': {'class': 'block text-xs font-semibold
        text-dark-forest-green'}}) }}
        {{ form_widget(form.course, {'attr': {'class': 'w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2
        focus:ring-bright-green focus:border-transparent transition-colors duration-200 text-dark-forest-green
        dark:bg-gray-800 text-xs'}}) }} {{ form_errors(form.course) }}
    </div>

    <div class="space-y-2">
        {{ form_label(form.passingScore, 'Passing Score (%)', {'label_attr': {'class': 'block text-xs font-semibold
        text-dark-forest-green'}}) }}
        {{ form_widget(form.passingScore, {'attr': {'class': 'w-full px-4 py-3 border border-gray-300 rounded-lg
        focus:ring-2 focus:ring-bright-green focus:border-transparent transition-colors duration-200
        text-dark-forest-green text-xs', 'min': 0, 'max': 100}}) }}
        {{ form_errors(form.passingScore) }}
    </div>
</div>

<div class="flex flex-col sm:flex-row gap-4 justify-end mt-4">
    <a href="{{ path('app_admin_quiz') }}"
               class="inline-flex items-center justify-center px-5 py-2.5 bg-gray-100 text-dark-forest-green text-xs font-medium rounded-lg hover:bg-gray-200 transition-colors duration-200 dark:bg-gray-700 dark:!text-gray-200 dark:hover:bg-gray-400">
        Cancel
    </a>
    <button type="submit"
        class="inline-flex text-xs items-center justify-center px-6 py-3 bg-bright-green text-white font-semibold rounded-lg hover:bg-green-600 transition-colors duration-200 shadow-md hover:shadow-lg">
        {{ button_label|default('Save Quiz') }}
    </button>
</div>
{{ form_end(form) }}