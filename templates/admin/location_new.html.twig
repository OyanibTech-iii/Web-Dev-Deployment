{% extends 'admin/base_admin.html.twig' %}

{% block title %}Add Location | Growfico{% endblock %}

{% block stylesheets %}
{{ parent() }}
{# Leaflet CSS for the map #}
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
{% endblock %}

{% block header_title %}
<h2 class="text-xl font-semibold text-dark-forest-green">Add Location</h2>
<p class="text-xs text-light-gray">Create a new storage location</p>
{% endblock %}

{% block admin_content %}
<div class="max-w-7xl mx-auto">
    <div class="bg-white rounded-2xl border border-gray-200 shadow-sm">
        <div class="p-6">
            {{ form_start(form) }}

            {# Interactive Map Container #}
            <div class="mb-6">
                <label class="block text-base font-semibold text-dark-forest-green mb-2">Pin Location on Map</label>
                <div id="map-picker" class="rounded-lg border border-gray-300" style="height: 350px; width: 100%;">
                </div>
                <p class="text-xs text-light-gray mt-2">Click anywhere on the map to set the coordinates automatically.
                </p>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div class="space-y-2 md:col-span-2">
                    {{ form_label(form.name, 'Branch Name', {'label_attr': {'class': 'block text-base font-semibold
                    text-dark-forest-green'}}) }}
                    {{ form_widget(form.name, {'attr': {'class': 'w-full px-4 py-3 border border-gray-300 rounded-lg
                    transition-colors duration-200
                    text-dark-forest-green placeholder-light-gray dark:!text-gray-200 ', 'placeholder': 'Enter branch name'}}) }}
                    {{ form_errors(form.name) }}
                </div>

                <div class="space-y-2">
                    {{ form_label(form.latitude, 'Latitude', {'label_attr': {'class': 'block text-base font-semibold
                    text-dark-forest-green'}}) }}
                    {{ form_widget(form.latitude, {'attr': {'type': 'number','class': 'location-lat w-full px-4 py-3 border
                    border-gray-300 rounded-lg 
                    transition-colors duration-200 text-dark-forest-green placeholder-light-gray dark:!text-gray-200 '}}) }}
                    {{ form_errors(form.latitude) }}
                </div>

                <div class="space-y-2">
                    {{ form_label(form.longitude, 'Longitude', {'label_attr': {'class': 'block text-base font-semibold
                    text-dark-forest-green'}}) }}
                    {{ form_widget(form.longitude, {'attr': {'type': 'number','class': 'location-lng w-full px-4 py-3 border
                    border-gray-300 rounded-lg dark:!text-gray-200
                    transition-colors duration-200 text-dark-forest-green placeholder-light-gray'}}) }}
                    {{ form_errors(form.longitude) }}
                </div>
            </div>

            <div class="flex flex-col sm:flex-row gap-4 justify-end mt-6">
                <a href="{{ path('app_admin_locations') }}"
                    class="inline-flex items-center justify-center px-6 py-3 bg-gray-100 text-dark-forest-green font-semibold rounded-lg hover:bg-gray-200 transition-colors duration-200 dark:bg-gray-700 dark:!text-gray-200 dark:hover:!text-dark-forest-green">
                    Cancel
                </a>
                <button type="submit"
                    class="inline-flex items-center justify-center px-6 py-3 bg-bright-green text-white font-semibold rounded-lg hover:bg-green-600 transition-colors duration-200 shadow-md hover:shadow-lg">
                    <ion-icon name="checkmark-circle-outline" class="w-4 h-4 mr-2"></ion-icon>
                    Create Location
                </button>
            </div>
            {{ form_end(form) }}
        </div>
    </div>
</div>

{% block javascripts %}
{{ parent() }}
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script>
    document.addEventListener('turbo:load', function () {
        const mapContainer = document.getElementById('map-picker');
        if (!mapContainer) return;

        // Set view to Negros, Philippines [10.0, 123.0] with zoom level 7
        const map = L.map('map-picker').setView([10.0, 123.0], 7);

        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
            attribution: '© OpenStreetMap'
        }).addTo(map);

        let marker;
        const latInput = document.querySelector('.location-lat');
        const lngInput = document.querySelector('.location-lng');

        map.on('click', function (e) {
            const { lat, lng } = e.latlng;

            if (latInput) latInput.value = lat.toFixed(6);
            if (lngInput) lngInput.value = lng.toFixed(6);

            if (marker) {
                marker.setLatLng(e.latlng);
            } else {
                marker = L.marker(e.latlng).addTo(map);
            }
        });

        setTimeout(() => { map.invalidateSize(); }, 200);
    });
</script>
{% endblock %}
{% endblock %}