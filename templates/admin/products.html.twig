{% extends 'admin/base_admin.html.twig' %}

{% block title %}Admin Products | Growfico{% endblock %}

{% block stylesheets %}
{{ parent() }}
<link rel="stylesheet" href="https://cdn.datatables.net/1.13.7/css/jquery.dataTables.min.css">
<link rel="stylesheet" href="{{ asset('styles/datatable.css') }}">
{% endblock %}

{% block header_title %}
<h2 class="text-lg font-semibold text-dark-forest-green">Product Management</h2>
<p class="text-xs text-light-gray">Manage your product catalog and inventory</p>
{% endblock %}

{% block admin_content %}
<div class="max-w-7xl mx-auto">
    <div class="bg-white rounded-2xl border border-gray-200 shadow-sm p-6">

        <div class="flex flex-col sm:flex-row sm:justify-between sm:items-center gap-4 mb-6">
            <h2 class="text-xl font-semibold text-dark-forest-green">Manage Products</h2>
            <div class="flex flex-col sm:flex-row gap-4 sm:items-center">
                <div class="relative">
                    <span class="absolute inset-y-0 left-0 pl-3 flex items-center text-gray-400 pointer-events-none">
                        <ion-icon name="search-outline"></ion-icon>
                    </span>
                    <input type="text" id="products-search-input"
                        class="block w-full sm:w-64 pl-10 pr-3 py-2 border border-gray-300 rounded-lg leading-5 bg-white placeholder-gray-500 focus:outline-none focus:ring-1 focus:ring-bright-green sm:text-sm"
                        placeholder="Search products..." autocomplete="off" aria-label="Search products">
                </div>
                <a href="{{ path('app_admin_product_new') }}"
                    class="inline-flex items-center justify-center px-4 py-2 bg-bright-green text-white text-xs font-medium rounded-lg hover:bg-green-600 transition-colors duration-200">
                    <ion-icon name="add-outline" class="w-4 h-4 mr-2"></ion-icon>
                    Add Product
                </a>
            </div>
        </div>

        <div class="overflow-x-auto">
            <table id="productsTable" class="w-full">
                <thead class="bg-gray-50">
                    <tr>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                            Product</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Price
                        </th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                            Status</th>
                        <th class="px-6 py-3 text-center text-xs font-medium text-gray-500 uppercase tracking-wider no-sort"
                            style="text-align: center !important;">Actions</th>
                    </tr>
                </thead>
                <tbody class="bg-white divide-y divide-gray-200 dark:divide-gray-500">
                    {% for product in products %}
                    {% set rowImagePath = product.getImagePath() %}
                    <tr class="hover:bg-gray-50 transition-colors duration-200 product-row"
                        data-product-id="{{ product.id }}" data-product-name="{{ product.name|e('html_attr') }}"
                        data-product-description="{{ product.description|e('html_attr') }}"
                        data-product-price="{{ product.price }}"
                        data-product-status="{{ product.isAvailable ? 'Available' : 'Out of Stock' }}"
                        data-product-image="{{ rowImagePath ? asset(rowImagePath) : '' }}">
                        <td class="px-6 py-4 whitespace-nowrap">
                            <div class="flex items-center">
                                <div
                                    class="w-10 h-10 bg-gradient-to-br from-bright-green/10 to-dark-forest-green/10 rounded-lg flex items-center justify-center flex-shrink-0 mr-3">
                                    {% set imagePath = product.getImagePath() %}
                                    {% if imagePath %}
                                    <img src="{{ asset(imagePath) }}" alt="{{ product.name|e('html_attr') }}"
                                        class="w-full h-full object-cover rounded-lg">
                                    {% else %}
                                    <ion-icon name="leaf-outline" class="w-5 h-5 text-bright-green"></ion-icon>
                                    {% endif %}
                                </div>
                                <div>
                                    <div class="text-xs font-medium text-dark-forest-green">{{ product.name }}</div>
                                    {# <div class="text-sm text-light-gray truncate max-w-xs">{{ product.description }} #}
                                    </div>
                                </div>
                            </div>
                        </td>
                        <td class="px-6 py-4 whitespace-nowrap">
                            <div class="text-xs font-semibold text-dark-forest-green">₱{{ product.price }}</div>
                        </td>
                        <td class="px-6 py-4 whitespace-nowrap">
                            {% if product.isAvailable %}
                            <span
                                class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-transparent text-green-800 dark:bg-gray-800 dark:!text-bright-green">
                                Available
                            </span>
                            {% else %}
                            <span
                                class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-transparent text-red-800 dark:bg-gray-800 dark:!text-red-200">
                                Out of Stock
                            </span>
                            {% endif %}
                        </td>
                        <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-right">
                            <div class="flex items-center justify-center gap-2">
                                <button type="button"
                                    class="text-bright-green hover:text-green-600 transition-colors duration-200 open-product-modal"
                                    title="View Product">
                                    <ion-icon name="eye-outline" class="w-4 h-4"></ion-icon>
                                </button>
                                <a href="{{ path('app_admin_product_edit', {'id': product.id}) }}"
                                    class="text-blue-600 hover:text-blue-800 transition-colors duration-200">
                                    <ion-icon name="create-outline" class="w-4 h-4"></ion-icon>
                                </a>
                                <button type="button"
                                    class="text-red-600 hover:text-red-800 transition-colors duration-200 delete-product-btn"
                                    data-product-id="{{ product.id }}"
                                    data-delete-url="{{ path('app_admin_product_delete', {'id': product.id}) }}"
                                    data-csrf-token="{{ csrf_token('delete' ~ product.id) }}" title="Delete Product">
                                    <ion-icon name="trash-outline" class="w-4 h-4"></ion-icon>
                                </button>
                            </div>
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>

        {% if products is empty %}
        <div class="text-center py-8 border-t border-gray-100 mt-4">
            <div class="mx-auto w-16 h-16 bg-gray-100 rounded-full flex items-center justify-center mb-4">
                <ion-icon name="leaf-outline" class="w-8 h-8 text-light-gray"></ion-icon>
            </div>
            <h4 class="text-sm font-semibold text-dark-forest-green mb-2">No products yet</h4>
            <p class="text-xs text-light-gray mb-4 max-w-sm mx-auto">Start building your product catalog by adding your
                first product.</p>
            <a href="{{ path('app_admin_product_new') }}"
                class="inline-flex items-center px-4 py-2 bg-bright-green text-white text-sm font-medium rounded-lg hover:bg-green-600 transition-colors duration-200">
                <ion-icon name="add-outline" class="w-4 h-4 mr-2"></ion-icon>
                Add your first product
            </a>
        </div>
        {% endif %}
    </div>
</div>

<!-- Product View Modal -->
<div id="product-view-modal" class="fixed inset-0 z-50 hidden">
    <div class="absolute inset-0 bg-black/40 backdrop-blur-md"></div>
    <div class="relative z-10 flex items-center justify-center min-h-screen p-4">
        <div class="bg-white rounded-2xl shadow-xl max-w-lg w-full overflow-hidden">
            <div class="px-6 py-4 bg-bright-green text-white flex items-center justify-between">
                <h3 class="text-lg font-semibold">Product Details</h3>
                <button type="button" id="product-modal-close" class="text-white/90 hover:text-white"
                    aria-label="Close">
                    <ion-icon name="close-outline" class="w-6 h-6"></ion-icon>
                </button>
            </div>
            <div class="p-6 space-y-4">
                <div class="flex items-start gap-4">
                    <div class="w-48 h-48 bg-gray-100 rounded-lg flex items-center justify-center overflow-hidden">
                        <img id="pm-image" src="" alt="Product image" class="w-full h-full object-cover hidden">
                        <ion-icon id="pm-fallback" name="leaf-outline" class="w-12 h-12 text-bright-green"></ion-icon>
                    </div>
                    <div class="flex-1 min-w-0">
                        <h4 id="pm-name" class="text-base font-semibold text-dark-forest-green"></h4>
                        <p id="pm-description" class="text-sm text-light-gray mt-1"></p>
                    </div>
                </div>
                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <p class="text-xs text-light-gray">Price</p>
                        <p id="pm-price" class="text-sm font-medium text-dark-forest-green"></p>
                    </div>
                    <div>
                        <p class="text-xs text-light-gray">Status</p>
                        <p id="pm-status" class="text-sm font-medium"></p>
                    </div>
                </div>
                <div class="flex justify-end pt-4 border-t border-gray-100">
                    <button type="button" id="product-modal-close-2"
                        class="px-4 py-2 text-sm font-medium text-gray-700 bg-gray-100 rounded-lg hover:bg-gray-200 transition-colors duration-200">Close</button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Product Delete Confirmation Modal -->
<div id="delete-product-modal" class="fixed inset-0 z-50 hidden backdrop-blur-md" style="display: none;">
    <div class="absolute inset-0 bg-black/40 backdrop-blur-md"></div>
    <div class="absolute inset-0 flex items-center justify-center">
        <div class="bg-white rounded-2xl shadow-2xl p-8 max-w-md w-full mx-4 transform transition-all relative z-10">
            <div class="flex items-center gap-4 mb-4">
                <div class="w-12 h-12 rounded-full bg-red-100 flex items-center justify-center">
                    <ion-icon name="alert-circle-outline" class="text-2xl text-red-600"></ion-icon>
                </div>
                <div>
                    <h3 class="text-lg font-semibold text-dark-forest-green">Delete Product</h3>
                    <p class="text-xs text-light-gray">Are you sure?</p>
                </div>
            </div>
            <p class="text-sm text-light-gray mb-6">
                This action cannot be undone. The product will be permanently deleted from your catalog.
            </p>
            <div class="flex gap-3">
                <button type="button" id="delete-cancel-btn"
                    class="flex-1 px-4 py-2.5 rounded-lg bg-gray-100 hover:bg-gray-200 text-dark-forest-green font-medium transition-colors duration-200">
                    Cancel
                </button>
                <button type="button" id="delete-confirm-btn"
                    class="flex-1 px-4 py-2.5 rounded-lg bg-red-600 hover:bg-red-700 text-white font-medium transition-colors duration-200 text-center no-underline flex items-center justify-center">
                    Delete
                </button>
            </div>
        </div>
    </div>
</div>

{% block javascripts %}
{{ parent() }}
<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script src="https://cdn.datatables.net/1.13.7/js/jquery.dataTables.min.js"></script>
<script src="{{ asset('js/admin-search.js') }}"></script>
<script>
    (function () {
        'use strict';
        const TABLE_SELECTOR = '#productsTable';
        const SEARCH_INPUT_ID = 'products-search-input';

        function initProductsDataTable() {
            if (typeof jQuery === 'undefined' || !jQuery.fn.DataTable) {
                return;
            }
            const $table = jQuery(TABLE_SELECTOR);
            if (!$table.length || jQuery.fn.DataTable.isDataTable(TABLE_SELECTOR)) {
                return;
            }
            const table = $table.DataTable({
                dom: 'lrtip',
                pageLength: 10,
                order: [[0, 'asc']],
                columnDefs: [
                    { orderable: false, targets: 3 },
                    { className: 'align-middle', targets: '_all' }
                ],
                autoWidth: false,
                language: {
                    emptyTable: 'No products found.',
                    zeroRecords: 'No matching products found.',
                    paginate: {
                        previous: '<ion-icon name="chevron-back-outline" class="align-middle"></ion-icon>',
                        next: '<ion-icon name="chevron-forward-outline" class="align-middle"></ion-icon>'
                    }
                }
            });

            const searchInput = document.getElementById(SEARCH_INPUT_ID);
            if (searchInput) {
                searchInput.addEventListener('keyup', function () {
                    table.search(this.value).draw();
                });
            }

            if (typeof AdminSearch !== 'undefined') {
                new AdminSearch({
                    searchInputId: SEARCH_INPUT_ID,
                    tableSelector: TABLE_SELECTOR
                });
            }
        }

        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', initProductsDataTable);
        } else {
            initProductsDataTable();
        }
    })();
</script>
<script src="{{ asset('js/product-component.js') }}"></script>
{% endblock %}
{% endblock %}