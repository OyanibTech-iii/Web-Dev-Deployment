<div x-data="{ open: false }" class="inline-flex">
    <button type="button" 
            @click="open = true"
            class="text-red-600 hover:text-red-800 transition-colors duration-200"
            title="Delete Location">
        <ion-icon name="trash-outline" class="w-4 h-4"></ion-icon>
    </button>

    <template x-teleport="body">
        <div x-show="open" 
             class="fixed inset-0 z-[10050]" 
             x-cloak>
            
            <div x-show="open"
                 x-transition:enter="transition ease-out duration-300"
                 x-transition:enter-start="opacity-0"
                 x-transition:enter-end="opacity-100"
                 x-transition:leave="transition ease-in duration-200"
                 x-transition:leave-start="opacity-100"
                 x-transition:leave-end="opacity-0"
                 @click="open = false"
                 class="absolute inset-0 bg-black/40 backdrop-blur-md"></div>

            <div class="absolute inset-0 flex items-center justify-center p-4 sm:p-6 pointer-events-none">
                <div x-show="open"
                     x-transition:enter="transition ease-out duration-300"
                     x-transition:enter-start="opacity-0 scale-95 translate-y-4"
                     x-transition:enter-end="opacity-100 scale-100 translate-y-0"
                     x-transition:leave="transition ease-in duration-200"
                     x-transition:leave-start="opacity-100 scale-100 translate-y-0"
                     x-transition:leave-end="opacity-0 scale-95 translate-y-4"
                     class="bg-white dark:bg-gray-800 rounded-2xl shadow-2xl p-6 sm:p-8 max-w-md w-full mx-auto relative z-10 border border-gray-100 dark:border-gray-700 pointer-events-auto"
                     role="dialog" 
                     aria-modal="true">
                    
                    <div class="flex items-center gap-4 mb-4 text-left">
                        <div class="w-12 h-12 rounded-full bg-red-100 dark:bg-red-950/50 flex items-center justify-center shrink-0">
                            <ion-icon name="alert-circle-outline" class="text-2xl text-red-600 dark:text-red-400"></ion-icon>
                        </div>
                        <div class="min-w-0">
                            <h3 class="text-lg font-semibold text-gray-900 dark:text-gray-100">Delete Location?</h3>
                            <p class="text-xs text-gray-500 dark:text-gray-400">Permanently remove this entry</p>
                        </div>
                    </div>

                    <p class="text-sm text-gray-600 dark:text-gray-400 mb-6 text-left">
                        Are you sure you want to delete **{{ location.name }}**? This action will remove all associated data and cannot be undone.
                    </p>

                    <div class="flex flex-col-reverse sm:flex-row gap-3">
                        <button @click="open = false" type="button"
                                class="flex-1 px-4 py-2.5 rounded-lg bg-gray-100 dark:bg-gray-700 hover:bg-gray-200 dark:hover:bg-gray-600 text-gray-900 dark:text-gray-100 font-medium transition-colors duration-200">
                            Cancel
                        </button>
                        
                        <form method="post" action="{{ path('app_location_delete', {'id': location.id}) }}" class="flex-1">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ location.id) }}">
                            <button type="submit"
                                    class="w-full px-4 py-2.5 rounded-lg bg-red-600 hover:bg-red-700 text-white font-medium transition-colors duration-200">
                                Delete location
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </template>
</div>