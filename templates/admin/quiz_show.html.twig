{% extends 'admin/base_admin.html.twig' %}

{% block title %}Quiz Details | Growfico{% endblock %}

{% block header_title %}
<h2 class="text-xl font-semibold text-dark-forest-green">Quiz Details</h2>
<p class="text-xs text-light-gray">View quiz configuration</p>
{% endblock %}

{% block admin_content %}
<div class="max-w-7xl mx-auto">
    <div class="bg-white rounded-2xl border border-gray-200 shadow-sm p-6 space-y-6">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div>
                <p class="text-xs text-light-gray">Title</p>
                <p class="text-sm font-medium text-dark-forest-green">
                    {{ quiz.title }}
                </p>
            </div>
            <div>
                <p class="text-xs text-light-gray">Course</p>
                <p class="text-sm font-medium text-dark-forest-green">
                    {{ quiz.course ? quiz.course.courseName : 'N/A' }}
                </p>
            </div>
            <div>
                <p class="text-xs text-light-gray">Passing Score</p>
                <p class="text-sm font-medium text-dark-forest-green">
                    {{ quiz.passingScore }}%
                </p>
            </div>
        </div>

        <div class="flex flex-col sm:flex-row gap-3 justify-end pt-4 border-t border-gray-100">
            <a href="{{ path('app_admin_quiz') }}"
                class="inline-flex items-center justify-center px-5 py-2.5 bg-gray-100 text-dark-forest-green text-xs font-medium rounded-lg hover:bg-gray-200 transition-colors duration-200 dark:bg-gray-700 dark:!text-gray-200 dark:hover:bg-gray-400">
                Back to list
            </a>
            <a href="{{ path('app_admin_quiz_edit', {'id': quiz.id}) }}"
                class="inline-flex items-center justify-center px-5 py-2.5 bg-bright-green text-white text-xs font-medium rounded-lg hover:bg-green-600 transition-colors duration-200">
                Edit
            </a>
            <form method="post" action="{{ path('app_admin_quiz_delete', {'id': quiz.id}) }}"
                onsubmit="return confirm('Are you sure you want to delete this quiz?');">
                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ quiz.id) }}">
                <button
                    class="inline-flex items-center justify-center px-5 py-2.5 bg-red-600 text-white text-xs font-medium rounded-lg hover:bg-red-700 transition-colors duration-200">
                    Delete
                </button>
            </form>
        </div>
    </div>
</div>
{% endblock %}