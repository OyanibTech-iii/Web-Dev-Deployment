{% extends 'admin/base_admin.html.twig' %}

{% block title %}Admin Users | Growfico{% endblock %}

{% block header_title %}
<h2 class="text-lg font-semibold text-dark-forest-green">User Management</h2>
<p class="text-xs text-light-gray">Monitor, manage user accounts and permissions</p>
{% endblock %}

{% block stylesheets %}
{{ parent() }}
<link rel="stylesheet" href="https://cdn.datatables.net/1.13.7/css/jquery.dataTables.min.css">
<link rel="stylesheet" href="{{ asset('styles/datatable.css') }}">

{% endblock %}

{% block admin_content %}
{% include 'admin/user_maincontent.html.twig' %}
<!-- Add/Edit User Modal -->
{% include 'admin/user_addedit_modal.html.twig' %}
<!-- View User Modal -->
{% include 'admin/user_view_modal.html.twig' %}
<!-- Result Modal (for success/error messages) -->
<div id="result-modal" class="hidden fixed inset-0 z-[100] backdrop-blur-md">
    <div class="flex items-center justify-center min-h-screen p-4">
        <div id="result-modal-content"
            class="bg-white rounded-2xl p-8 max-w-sm w-full mx-4 text-center transform transition-all duration-200 opacity-0 scale-95">
            <div id="lottie-container" class="mb-4"></div>
            <h3 id="result-title" class="text-2xl font-bold mb-2"></h3>
            <p id="result-text" class="text-gray-600 mb-6"></p>

            <div id="result-actions" class="flex gap-3">
                <button id="result-confirm-btn"
                    class="hidden flex-1 py-3 rounded-xl font-semibold text-white bg-bright-green hover:bg-green-700 transition-all shadow-md">
                    Confirm
                </button>
                <button id="result-close-btn"
                    class="flex-1 py-3 rounded-xl font-semibold text-white bg-gray-400 hover:bg-gray-500 transition-all shadow-md">
                    Close
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Confirmation Modal for Toggle Status -->
<div id="confirm-modal-status" class="hidden fixed inset-0 z-[100] backdrop-blur-md">
    <div class="flex items-center justify-center min-h-screen p-4">
        <div class="bg-white rounded-2xl shadow-xl max-w-sm w-full mx-4 overflow-hidden">
            <div class="px-6 py-4 bg-bright-green text-white">
                <h3 id="confirm-status-title" class="text-lg font-semibold">Confirm Action</h3>
            </div>
            <div class="p-6">
                <p id="confirm-status-message" class="text-gray-700 mb-6"></p>
                <div class="flex gap-3">
                    <button id="confirm-status-cancel"
                        class="flex-1 py-2 rounded-lg font-medium text-gray-700 bg-gray-100 hover:bg-gray-200 transition-colors dark:!text-gray-800">
                        Cancel
                    </button>
                    <button id="confirm-status-proceed"
                        class="flex-1 py-2 rounded-lg font-medium text-white bg-bright-green hover:bg-green-600 transition-colors">
                        Confirm
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Confirmation Modal for Delete -->
<div id="confirm-modal-delete" class="hidden fixed inset-0 z-[100] backdrop-blur-md">
    <div class="flex items-center justify-center min-h-screen p-4">
        <div class="bg-white rounded-2xl shadow-xl max-w-sm w-full mx-4 overflow-hidden">
            <div class="px-6 py-4 bg-red-800 text-white">
                <h3 class="text-lg font-semibold">Delete User Confirmation</h3>
            </div>
            <div class="p-6">
                <p class="mb-2 font-semibold text-red-600">This action cannot be undone!</p>
                <p id="confirm-delete-message" class="text-gray-600 mb-6"></p>
                <div class="flex gap-3">
                    <button id="confirm-delete-cancel"
                        class="flex-1 py-2 rounded-lg font-medium text-gray-700 bg-gray-100 hover:bg-gray-200 transition-colors dark:!text-gray-800">
                        Cancel
                    </button>
                    <button id="confirm-delete-proceed"
                        class="flex-1 py-2 rounded-lg font-medium text-white bg-red-600 hover:bg-red-700 transition-colors">
                        Yes, Delete
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>
<style>
    @keyframes modalIn {
        from {
            opacity: 0;
            transform: translateY(8px) scale(0.98);
        }

        to {
            opacity: 1;
            transform: translateY(0) scale(1);
        }
    }

    .modal-animate-in {
        animation: modalIn 180ms ease-out;
    }
</style>

{% block javascripts %}
{{ parent() }}
<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script src="https://cdn.datatables.net/1.13.7/js/jquery.dataTables.min.js"></script>
<script src="{{ asset('js/admin-search.js') }}"></script>
<script src="{{ asset('js/admin-user-datatable.js') }}"></script>
<script src="{{ asset('js/user-admin.js') }}"></script>
{% endblock %}
{% endblock %}